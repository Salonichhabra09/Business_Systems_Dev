    <decisions>
        <name>Check_Invoice_Date</name>
        <label>Check Invoice Date</label>
        <locationX>446</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>UpdateInvoiceHeader_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetParentInvoiceHeader.Invoice_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Invoice_Date</targetReference>
            </connector>
            <label>If Blank</label>
        </rules>
    </decisions>
