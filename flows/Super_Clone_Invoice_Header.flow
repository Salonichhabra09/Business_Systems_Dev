        <rules>
            <name>Credit_Notes_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetInvoiceHeader.Credit_Note__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
