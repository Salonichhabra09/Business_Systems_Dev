                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateInvoiceHeader</targetReference>
            </connector>
            <label>Credit Notes - False</label>
        </rules>
    </decisions>
    <description>Added logic to remove not needed Sun Invoice Details
Added Invoice Date Logic Screen
Added GST Active/In Active mapping
Make flow to run in system mode
Updated IM Lookup Logic
Added the Extended comments
Added the logic for Unbilled Escalation - Prachi (SSE-17179)</description>
    <environments>Default</environments>
    <formulas>
        <name>BaseUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_340}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_340}))&amp;{!GetNewInvoiceHeader.Id}</expression>
    </formulas>
    <formulas>
        <name>EscalationStartDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 5</expression>
    </formulas>
    <formulas>
        <name>EscalationStatusProgress</name>
        <dataType>String</dataType>
        <expression>{!Date}&amp; &apos; &apos; &amp; {!$User.FirstName} &amp; &apos; &apos; &amp; {!$User.LastName} &amp; &apos; : &apos;  &amp; &apos; Level 0 - Not Due : &apos; &amp; {!Get_Escalation_Metadata.Action__c}</expression>
    </formulas>
    <formulas>
        <name>FriendlyErrorMessage</name>
        <dataType>String</dataType>
        <expression>MID(
         LEFT({!$Flow.FaultMessage}, 
                   FIND(&quot;You can look up&quot;,{!$Flow.FaultMessage})-1
                   ),
                   FIND(&quot;:&quot;,{!$Flow.FaultMessage},FIND(&quot;:&quot;,{!$Flow.FaultMessage})+1)+1,
                  LEN({!$Flow.FaultMessage})
           )</expression>
    </formulas>
    <formulas>
        <name>GSTActiveOrNot</name>
        <dataType>String</dataType>
        <expression>If({!GetInvoiceHeader.GST_Identification_Number__r.Is_Active__c} = True,{!GetInvoiceHeader.GST_Identification_Number__c}, Null)</expression>
    </formulas>
    <formulas>
        <name>PositiveInvoiceLineTotal</name>
        <dataType>Number</dataType>
        <expression>if({!IterateSelectedInvoiceLines.Invoice_Line_Total__c}&lt;0,-1*{!IterateSelectedInvoiceLines.Invoice_Line_Total__c},{!IterateSelectedInvoiceLines.Invoice_Line_Total__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PositiveOverrideQuantity</name>
        <dataType>Number</dataType>
        <expression>if({!IterateSelectedInvoiceLines.Quantity__c}&lt;0,-1*{!IterateSelectedInvoiceLines.Quantity__c},{!IterateSelectedInvoiceLines.Quantity__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ReissueInvoiceName</name>
        <dataType>String</dataType>
        <expression>&apos;Reissue of &apos; + {!GetInvoiceHeader.Parent_Invoice_header__r.Invoice_Name__c}</expression>
    </formulas>
