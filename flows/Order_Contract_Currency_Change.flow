    <decisions>
        <name>CheckContractYear</name>
        <label>CheckContractYear</label>
        <locationX>331</locationX>
        <locationY>928</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ZeroYear_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IterateOnOpportunityProductList.Contract_Year__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0</stringValue>
                </rightValue>
            </conditions>
            <label>ZeroYear_Products</label>
        </rules>
        <rules>
            <name>FirstYear_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IterateOnOpportunityProductList.Contract_Year__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignFirstYearProductList</targetReference>
            </connector>
            <label>FirstYear_Product</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckOrderYear</name>
        <label>CheckOrderYear</label>
        <locationX>1781</locationX>
        <locationY>133</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ZeroYearOrder</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IterateOrderAgain.Order_Year__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>ZeroYearOrder</label>
        </rules>
        <rules>
            <name>FirstYearOrder</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>IterateOrderAgain.Order_Year__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IterateOrderAgain.Order_Year__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IterateOnFirstYearProducts</targetReference>
            </connector>
            <label>FirstYearOrder</label>
        </rules>
    </decisions>
    <description>Version 2: mapping line description from opportunity products to order products</description>
    <environments>Default</environments>
    <formulas>
        <description>opportunity.Future_Product_Total_Price__c + opportunity.Amount</description>
        <name>TotalContractvalue</name>
        <dataType>Currency</dataType>
        <expression>{!OpportunityID.Amount} + {!OpportunityID.Future_Product_Total_Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Order Contract Currency Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Contract Currency Change</label>
    <loops>
        <name>Iterate_Order</name>
        <label>Iterate Order</label>
        <locationX>610</locationX>
        <locationY>412</locationY>
        <collectionReference>Get_Order</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
