    <assignments>
        <name>EmptyOrderProductList</name>
        <label>EmptyOrderProductList</label>
        <locationX>1251</locationX>
        <locationY>315</locationY>
        <assignmentItems>
            <assignToReference>OrderProductsToCreate</assignToReference>
            <operator>RemoveAll</operator>
