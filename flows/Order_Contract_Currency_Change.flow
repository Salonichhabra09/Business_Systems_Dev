    <recordDeletes>
        <name>Delete_Order_products</name>
        <label>Delete Order products</label>
        <locationX>771</locationX>
        <locationY>257</locationY>
        <connector>
            <targetReference>Delink_Contract_from_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Iterate_Order.Id</elementReference>
            </value>
        </filters>
        <object>OrderItem</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_Opportunity_Products</name>
        <label>Get_Opportunity_Products</label>
        <locationX>348</locationX>
        <locationY>340</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
