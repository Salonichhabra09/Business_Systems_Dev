        <fullName>Timing__c</fullName>
        <description>Dependent field on Escalation Stage</description>
        <externalId>false</externalId>
        <label>Timing</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unconfirmed_Sun_Order_Number__c</fullName>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;NA&apos;) || 
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;N/A&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;na&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;n/a&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;nA&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;Na&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;n/A&apos;) ||
			CONTAINS(Order__r.Unconfirmed_Sun_Order_Number__c, &apos;N/a&apos;) ,
			&apos;&apos;,
			Order__r.Unconfirmed_Sun_Order_Number__c
		)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Unconfirmed Sun Order Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unpaid_Amount__c</fullName>
        <formula>IF(Invoice_Gross_Amount__c = null,0,Invoice_Gross_Amount__c) - IF(Invoice_Transaction_Amount__c = null,0,Invoice_Transaction_Amount__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Unpaid Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>X30_Days_before_SOP_Date_for_PO__c</fullName>
        <formula>IF(Process_Date__c &lt; DATEVALUE(&apos;2023-08-01&apos;) , false, IF(Process_Date__c - TODAY() &lt;= 30, TRUE, FALSE))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>30 Days before SOP Date for PO</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>X7_Day_Check_for_PO_Number_Email__c</fullName>
        <description>This field returns TRUE if TODAY - Awaiting PO Date = 7</description>
        <formula>IF( TODAY() - Awaiting_PO_Notification_Sent_On__c = 7, TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>7 Day Check for PO Number Email</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Invoice Header</label>
    <listViews>
        <fullName>All</fullName>
        <columns>Account_Number_From_Contract__c</columns>
        <columns>Billing_Account_Name__c</columns>
        <columns>BU_From_Contract_Header__c</columns>
        <columns>Contract__c</columns>
        <columns>Contract_Line__c</columns>
        <columns>Invoice_Name__c</columns>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>E047733</label>
    </listViews>
    <listViews>
        <fullName>All_Invoice_Headers</fullName>
        <columns>NAME</columns>
        <columns>Invoice_Status__c</columns>
        <columns>BU_From_Contract_Header__c</columns>
        <columns>Account_Number_From_Contract__c</columns>
        <columns>Billing_Account_Name__c</columns>
        <columns>Sun_Invoice_Number__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Invoice_Status__c</field>
            <operation>notEqual</operation>
            <value>Sun Order Complete</value>
        </filters>
        <filters>
            <field>Invoice_Status__c</field>
            <operation>equals</operation>
            <value>Sun Invoice Complete</value>
        </filters>
        <label>All Invoice Headers</label>
    </listViews>
    <listViews>
        <fullName>RI_Invoice_Header</fullName>
        <columns>NAME</columns>
        <columns>Invoice_Status__c</columns>
        <columns>Billing_Account_Name__c</columns>
        <columns>Sales_Type__c</columns>
        <columns>SunSystems_Order_Reference__c</columns>
        <columns>Sun_Invoice_Number__c</columns>
        <columns>Unconfirmed_Sun_Order_Number__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Contract_Invoice_Header__c.Invoice_Header</value>
        </filters>
        <filters>
            <field>Invoice_Status__c</field>
            <operation>equals</operation>
            <value>Ready for SOE Review</value>
        </filters>
        <filters>
            <field>Order_Method__c</field>
            <operation>equals</operation>
            <value>RI</value>
        </filters>
        <label>RI Invoice Header</label>
    </listViews>
