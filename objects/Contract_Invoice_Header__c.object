    <fields>
        <fullName>Non_Default_Payment_Term_Formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Order__r.RecordTypeId=&apos;0124G000000Bj14&apos;,
IF((Order__r.Opportunity.MS_Opportunity__c = true),&apos;30D&apos;,&apos;&apos;),
IF( ISBLANK(TEXT(Order__r.Contract.Payment_terms__c)) ,
&apos;60D&apos;,
LEFT(TEXT(Order__r.Contract.Payment_terms__c),Find(&quot; &quot;, TEXT(Order__r.Contract.Payment_terms__c))-1)&amp; &apos;D&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Non Default Payment Term</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
