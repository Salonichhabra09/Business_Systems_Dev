    <fields>
        <fullName>GSSC_Email_Combined__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Order__r.BU__c 
,&quot;China - CN1&quot;,&quot;HK.SOE@shl.com&quot;                    
,&quot;EU Region - E50&quot;,&quot;UK1SOE@shl.com&quot;                                                              
,&quot;Italy - IT1&quot;,&quot;ItalySOE@shl.com&quot;                                                                
,&quot;Middle East - ME1&quot;,&quot;UK1SOE@shl.com&quot;                                                            
,&quot;SHL Previsor - P10&quot;,&quot;UK1SOE@shl.com&quot;                                                           
,&quot;UK - UK1&quot;,&quot;UK1SOE@shl.com&quot;      
,&quot;US - US5&quot;,&quot;US5.SOE@shl.com&quot;                                                                   
,MID(Order__r.BU__c, (LEN(Order__r.BU__c)-2), 2)  &amp; &quot;.SOE@shl.com&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>GSSC Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>GSSC_Instructions__c</fullName>
        <inlineHelpText>Enter instructions to the SOP team who will be raising the invoice. These will not print on the Sales Invoice sent to the customer.</inlineHelpText>
        <label>Special Invoicing Instructions</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>GST_Identification_Number__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>GST Identification Number</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND (2 OR 3 OR 4) AND 5 AND 6</booleanFilter>
            <errorMessage>Value does not exist or does not match filter criteria</errorMessage>
            <filterItems>
                <field>$Source.Invoice_Account__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>India_GST__c.Account__c</field>
                <operation>equals</operation>
                <valueField>$Source.Invoice_Account__c</valueField>
            </filterItems>
            <filterItems>
                <field>India_GST__c.Name</field>
                <operation>equals</operation>
                <value>Outside of India</value>
            </filterItems>
            <filterItems>
                <field>India_GST__c.Name</field>
                <operation>equals</operation>
                <value>URP</value>
            </filterItems>
            <filterItems>
                <field>India_GST__c.Is_Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>India_GST__c.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Tax</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>India_GST__c</referenceTo>
        <relationshipLabel>Invoice Headers</relationshipLabel>
        <relationshipName>Invoice_Headers</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>GST_Transfer_Status__c</fullName>
        <externalId>false</externalId>
