    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>BillingContact_as_OrderAccountcontact</fullName>
        <active>true</active>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
Billing_Contact__r.AccountId &lt;&gt;   Order__r.AccountId ,false)</errorConditionFormula>
        <errorDisplayField>Billing_Contact__c</errorDisplayField>
        <errorMessage>Order Contact must belong to the selected Order&apos;s Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Select_Ready_for_SOE</fullName>
        <active>false</active>
        <description>SSE-6455,6456 
if Order Method = RI or Extended comment is not blank invoice status can not 
moved to Ready for SOE Review.</description>
        <errorConditionFormula>AND(ISPICKVAL(Invoice_Status__c ,&quot;Ready for SOE review&quot;),OR( NOT(ISBLANK(Invoice_Header_Comments__c )),ISPICKVAL(Order_Method__c,&apos;RI&apos;)))</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>Invoice status can not be moved to Ready for SOE review,if there is value in extended comments or Order Method is RI</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_CreditNote_On_NegativeInvoiceTotal</fullName>
        <active>true</active>
        <errorConditionFormula>AND( OR(ISPICKVAL( Invoice_Status__c, &apos;Ready to Invoice&apos;),ISPICKVAL( Invoice_Status__c, &apos;Ready for SOE Review&apos;)),Invoice_Total__c &lt; 0,NOT(Credit_Note__c = true), NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)))</errorConditionFormula>
        <errorMessage>On the invoice header, &apos;Credit Note&apos; checkbox must be checked if &apos;Invoice Total&apos; is negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_Invoice_Total</fullName>
        <active>true</active>
        <errorConditionFormula>AND( OR(ISPICKVAL( Invoice_Status__c, &apos;Ready to Invoice&apos;),ISPICKVAL( Invoice_Status__c, &apos;Ready for SOE Review&apos;)), Credit_Note__c = true, NOT(Invoice_Total__c &lt;= 0),NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)))</errorConditionFormula>
        <errorMessage>On the Invoice Header, &apos;Invoice Total&apos; must be negative when &apos;Credit Note&apos; checkbox is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_if_PO_is_Required</fullName>
        <active>true</active>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
OR(AND(NOT(Order__r.Account.PurchaseOrderRequired__c),ISNULL(PO_number__c ),NOT(ISPICKVAL(Invoice_Status__c, &apos;Draft&apos;))) 
,AND(NOT(Order__r.Account.PurchaseOrderRequired__c),ISBLANK(PO_number__c ),NOT(ISPICKVAL(Invoice_Status__c, &apos;Draft&apos;)))),
false)</errorConditionFormula>
        <errorMessage>This Account requires a PO on the invoice header</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CreditReasonCodeRequired</fullName>
        <active>true</active>
        <description>SSE-6173</description>
        <errorConditionFormula>AND( NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),TEXT(Credit_Reason_Code__c)=&quot;&quot;,OR(Credit_Note__c = true, CONTAINS(TEXT(Sales_Type__c ), &quot;CN&quot;) ) ) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorDisplayField>Credit_Reason_Code__c</errorDisplayField>
        <errorMessage>Credit Reason Code is required if Sales Type is Credit Note or Credit Note is checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Currency_Should_Match_Order_Currency</fullName>
        <active>true</active>
        <description>Invoice header currency must be same as related order currency.</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),IF(TEXT(CurrencyIsoCode) = TEXT( Order__r.CurrencyIsoCode   ),false,true),false)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>Invoice header currency must be same as related order currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExtendedCommentsCheckforManualProcess</fullName>
        <active>true</active>
        <description>Recent change done for SSE-13135
SSE-6455,6456:if Extended Comments field is populated and Manual is not ticked the user cannot process through the automatic process- 
the header cannot moved to Ready for SOE Review.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(Invoice_Header_Comments__c)),Manual_Transfer__c =false, ISBLANK(Unconfirmed_Sun_Order_Number__c ))  &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>All orders with Extended Comments must be processed manually.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GST_Identification_Number_is_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(BU__c , &apos;India - IN1&apos;) ,OR(ISPICKVAL(Invoice_Status__c, &apos;Ready to Invoice&apos;),ISPICKVAL(Invoice_Status__c, &apos;Ready for Sun Transfer&apos;),ISPICKVAL(Invoice_Status__c, &apos;Ready for SOE Review&apos;)), ISBLANK( GST_Identification_Number__c ),
Invoice_Account__r.Exempt_GST__c = False
)</errorConditionFormula>
        <errorDisplayField>GST_Identification_Number__c</errorDisplayField>
        <errorMessage>The GST Identification number is mandatory when the BU on Invoice Header equals India - IN1 and  Invoice Status is Ready to Invoice/Ready for SOE Review/Ready for Sun Transfer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceAccountBUShouldBeSameAsInvHeadBU</fullName>
        <active>true</active>
        <description>Validation rule to prevent Invoice Account BU from being different from the Invoice Header BU</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
IF(AND(TEXT(Invoice_Account__r.BU__c ) &lt;&gt; BU_From_Contract_Header__c,NOT(ISBLANK(Invoice_Account__c))),true,false),false)</errorConditionFormula>
        <errorDisplayField>Invoice_Account__c</errorDisplayField>
        <errorMessage>Invoice Account&apos;s  BU Should be same as the Invoice Header&apos;s BU.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceContactShouldBeOfInvoiceAccount</fullName>
        <active>true</active>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),Invoice_Contact__r.AccountId &lt;&gt;  Invoice_Account__r.Id,false)</errorConditionFormula>
        <errorDisplayField>Invoice_Contact__c</errorDisplayField>
        <errorMessage>Invoice Contact must belong to the selected Invoice Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceHeader_Cannot_Move_Out_from_Draft</fullName>
        <active>true</active>
        <description>Invoice Header cannot be moved to any other status value unless it has an invoice line added to the related list.</description>
        <errorConditionFormula>IF(AND(ISPICKVAL(PRIORVALUE(Invoice_Status__c),&apos;Draft&apos;), No_of_Invoice_Line__c = 0,NOT(OR(ISPICKVAL(Invoice_Status__c,&apos;Cancelled&apos;),ISPICKVAL(Invoice_Status__c,&apos;No Usage&apos;))),NOT(ISNEW()),ISCHANGED(Invoice_Status__c)),true,false)</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>Invoice Header cannot be moved to another status unless it has an invoice line added.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatusCheckPriorValue</fullName>
        <active>true</active>
        <description>User cannot change ready for sun transfer if the prior value is not ready for SOE review</description>
        <errorConditionFormula>AND(NOT($Permission.OATs), OR(ISCHANGED(Invoice_Status__c),ISNEW()) , NOT(ISPICKVAL(PRIORVALUE(Invoice_Status__c),&quot;Ready for SOE Review&quot;)),
ISPICKVAL(Invoice_Status__c,&apos;Ready for Sun Transfer&apos;))</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>Please update Invoice status to &apos;Ready for SOE Review&apos; before changing it to &apos;Ready for Sun Transfer&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatusDependsOnOrdersStatus</fullName>
        <active>true</active>
        <description>Invoice Header status cannot be set to &apos;Ready to Invoice&apos; or &apos;Ready for SOE Review&apos; or &apos;Ready for Sun Transfer&apos; unless the related Order Header status is Completed, Approved, Awaiting PO or Awaiting GST/VAT Info</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
AND(
OR(ISCHANGED(Invoice_Status__c), ISNEW()),
OR(ISPICKVAL(Invoice_Status__c,&apos;Ready for SOE Review&apos;),ISPICKVAL(Invoice_Status__c,&apos;Ready to Invoice&apos;),ISPICKVAL(Invoice_Status__c,&apos;Ready for Sun Transfer&apos;)),
NOT(OR(ISPICKVAL(Order__r.Oats_Status__c,&quot;Completed&quot; ),
ISPICKVAL(Order__r.Oats_Status__c,&quot;Approved&quot; ),
ISPICKVAL(Order__r.Oats_Status__c,&quot;Awaiting PO&quot; ), ISPICKVAL(Order__r.Oats_Status__c,&quot;Awaiting GST/VAT Info&quot;)))
),false)</errorConditionFormula>
        <errorMessage>Invoice Header status cannot be set to &apos;Ready to Invoice&apos; or &apos;Ready for SOE Review&apos; or &apos;Ready for Sun Transfer&apos; unless the related Order OAT status is &apos;Awaiting PO&apos; or &apos;Awaiting GST/VAT Info&apos; or &apos;Completed&apos; or &apos;Approved&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatusUpdateValidationGST</fullName>
        <active>true</active>
        <description>SSE-6023: User should ONLY be allowed to mark Invoice Status as &apos;Ready for SOE Review&apos; OR &apos;Ready to Invoice&apos; if associated GST record&apos;s (&apos;Automatic Transfer Status&apos; = Transferred OR &apos;Manual Transfer&apos; = YES).</description>
        <errorConditionFormula>AND(if( TEXT(GST_Identification_Number__r.Manual_Transfer__c) = &apos;Yes&apos;, false ,
TEXT(GST_Identification_Number__r.Transfer_Status__c)!=&quot;Transferred&quot;),NOT(!ISNULL(GST_Identification_Number__c)),
OR(ISPICKVAL( Invoice_Status__c ,&apos;Ready for SOE Review&apos;),ISPICKVAL( Invoice_Status__c ,&apos;Ready to Invoice&apos;),ISPICKVAL(BU__c, &apos;India - IN1&apos;) ))</errorConditionFormula>
        <errorMessage>You cannot proceed further if linked GST record is not transferred to SUN.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invoice_Cannot_Be_Created_VOpp_Is_yes</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT(CONTAINS( $Profile.Name, &quot;System Administrator&quot; )),
IF(ISPICKVAL( Order__r.Opportunity.Variation_Opportunity__c , &apos;Yes&apos;),true,false ))</errorConditionFormula>
        <errorMessage>Invoice Header Cannot Be Created If Variation Opportunity Is &apos;YES&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invoice_Contact_MustBe_TransferToInfor10</fullName>
        <active>false</active>
        <errorConditionFormula>AND 
( 
NOT(ISBLANK(Invoice_Contact__c)), 
NOT(ISPICKVAL(Invoice_Contact__r.SFDC2SUN_TransferStatus__c , &apos;Transferred&apos;)), 
NOT(ISPICKVAL(BU__c, &apos;South Africa - ZA1&apos;)),
OR(ISPICKVAL(Invoice_Status__c, &apos;Ready to Invoice&apos;),ISPICKVAL(Invoice_Status__c, &apos;Ready for SOE Review&apos;))
)</errorConditionFormula>
        <errorMessage>The invoice contact related to this Invoice header record is not yet transferred to Infor10. Please transfer it first before setting Invoice Status is Ready to Invoice or Ready for SOE Review</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invoice_Header_Can_Only_Move_To_Draft</fullName>
        <active>true</active>
        <description>Invoice Header can only be moved to &quot;Draft&quot; from &quot;Cancelled&quot; or &quot;No Usage&quot; Invoice Status.</description>
        <errorConditionFormula>IF(
    AND(
        ISPICKVAL(Invoice_Status__c, &apos;Draft&apos;),
        NOT(
            OR(
                ISPICKVAL(PRIORVALUE(Invoice_Status__c), &apos;Cancelled&apos;),
                ISPICKVAL(PRIORVALUE(Invoice_Status__c), &apos;No Usage&apos;)
            )
        ),
        ISCHANGED(Invoice_Status__c)
    ),
    true,
    false
)</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>Invoice Header can only move to Draft from Cancelled or No Usage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Number_is_Required_for_MS_Invoice</fullName>
        <active>true</active>
        <description>Job Number is Required for MS Invoice</description>
        <errorConditionFormula>IF(AND(NOT(ISNEW()),Order__r.Opportunity.MS_Opportunity__c = true, ISCHANGED(Process_Date__c), ISNULL(PRIORVALUE(Process_Date__c)), NOT(ISNULL(Process_Date__c)), Job_Number__c = NULL),true, IF(AND(NOT(ISNEW()),Order__r.Opportunity.MS_Opportunity__c = true, ISCHANGED(Job_Number__c), NOT(PRIORVALUE(Job_Number__c) = NULL),Job_Number__c = NULL),true, false))</errorConditionFormula>
        <errorMessage>Job Number is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MentionReasonwhenManualTransferChecked</fullName>
        <active>true</active>
        <description>Reason field is mandatory when manual transfer checkbox is checked</description>
        <errorConditionFormula>AND(PRIORVALUE(Manual_Transfer__c)= False, ISCHANGED(Manual_Transfer__c), ISBLANK( Manual_Transfer_Reason__c ))</errorConditionFormula>
        <errorDisplayField>Manual_Transfer_Reason__c</errorDisplayField>
        <errorMessage>Reason is mandatory when manual transfer is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Order_number_added_before_invoice_num</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
				NOT(
								CONTAINS($Profile.Name,&apos;System Admin&apos;)
				) &amp;&amp; 
    NOT($Permission.Invoice_Header_Edit_fields) ,
				AND ( 
								NOT(
												ISBLANK(Sun_Invoice_Number__c )
								),
								ISBLANK(SunSystems_Order_Reference__c )
				),
				false
)</errorConditionFormula>
        <errorDisplayField>Sun_Invoice_Number__c</errorDisplayField>
        <errorMessage>&apos;Sun Invoice Number&apos; field cannot have a value until the &apos;SUN Order Reference&apos; field has a value added to it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PO_Mandatory_on_Credit_Note_True</fullName>
        <active>true</active>
        <description>SSE-6700</description>
        <errorConditionFormula>AND(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),Credit_Note__c = true,PO_number__c = &apos;&apos;)  &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorDisplayField>PO_number__c</errorDisplayField>
        <errorMessage>Original Sales Invoice Number is required if Credit Note is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Invoice_status_from_changing</fullName>
        <active>true</active>
        <description>Prevent Invoice Status on Invoice Header from being changed to Ready for SOE or Ready for SUN Transfer if the related Invoice Account has an Account Approval Status of Unapproved or Submitted for Approval.</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),AND(NOT (ISPICKVAL(Invoice_Account__r.Status__c , &apos;Approved&apos;)),OR(ISPICKVAL(Invoice_Status__c, &apos;Ready for SOE Review&apos;) ,ISPICKVAL(Invoice_Status__c, &apos;Ready for Sun Transfer&apos;))),false)</errorConditionFormula>
        <errorMessage>Invoice header can not be selected as ready for SOE or ready for SUN transfer as Account Approval Status is Unapproved or Submitted for Approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_credit_note_checkbox</fullName>
        <active>true</active>
        <description>SSE-6851:Restrict sales type to be used when credit note box is ticked</description>
        <errorConditionFormula>AND(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)), Credit_Note__c =false, CONTAINS(TEXT( Sales_Type__c), &apos;CN&apos;))</errorConditionFormula>
        <errorDisplayField>Credit_Note__c</errorDisplayField>
        <errorMessage>The credit note checkbox should be checked if a credit sales type is selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_credit_note_sales_type</fullName>
        <active>true</active>
        <description>SSE-13096 : recent change
SSE-6851:Restrict sales type to be used when credit note box is ticked</description>
        <errorConditionFormula>AND(
NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
Credit_Note__c =true,
Manual_Transfer__c =false,
OR(
AND(NOT( CONTAINS(TEXT( Sales_Type__c), &apos;CN&apos;)),
NOT( CONTAINS(TEXT( Sales_Type__c), &apos;CR&apos;)),
NOT(ISPICKVAL(Sales_Type__c,&apos;S1RIC&apos;))),
ISPICKVAL(Sales_Type__c,&apos;&apos;) )
)  &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorDisplayField>Sales_Type__c</errorDisplayField>
        <errorMessage>You cannot choose a non credit sales type if credit note checkbox is true.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_specific_fields_edition</fullName>
        <active>true</active>
        <errorConditionFormula>RecordType.Name = &apos;Read Only&apos; &amp;&amp;  NOT(ISCHANGED(RecordTypeId)) &amp;&amp; 
NOT($Permission.Invoice_Header_Edit_fields) &amp;&amp;
$Profile.Name &lt;&gt; &apos;System Administrator&apos; &amp;&amp;
$User.Id &lt;&gt; &apos;00520000000ihKr&apos; &amp;&amp;
(ISCHANGED(Invoice_Status__c) || ISCHANGED(SunSystems_Order_Reference__c))</errorConditionFormula>
        <errorMessage>Only authorized users can edit the fields &apos;Invoice Status&apos; and &apos;Sun Order Reference&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_value_for_Invoice_Status_Auto</fullName>
        <active>true</active>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),AND(ISPICKVAL(Invoice_Status__c , &quot;Ready to Invoice&quot;),Manual_Transfer__c = false,ISBLANK( Unconfirmed_Sun_Order_Number__c)), false)</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>&apos;Ready to Invoice&apos; can only be selected when &apos;Unconfirmed SUN Order Number&apos; has a value or &apos;Manual Transfer&apos; is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_value_for_Invoice_Status_Manual</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL(Invoice_Status__c , &quot;Ready for Sun Transfer&quot;), 
ISPICKVAL(Invoice_Status__c , &quot;Ready for SOE review&quot;)),OR( Manual_Transfer__c = true,NOT(ISBLANK( Unconfirmed_Sun_Order_Number__c))))</errorConditionFormula>
        <errorDisplayField>Invoice_Status__c</errorDisplayField>
        <errorMessage>&apos;Ready for SOE Review&apos; cannot be selected when &apos;Unconfirmed SUN Order Number&apos; is available or &apos;Manual Transfer&apos; is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SalesTypeNotRequiredManualProcess</fullName>
        <active>true</active>
        <description>SSE-6711-Sales Type value should not be populated for manual orders</description>
        <errorConditionFormula>AND(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)), OR( Manual_Transfer__c =true, not(ISBLANK(Unconfirmed_Sun_Order_Number__c) )),TEXT(Sales_Type__c )!=&apos;&apos;)</errorConditionFormula>
        <errorDisplayField>Sales_Type__c</errorDisplayField>
        <errorMessage>Sales Type value should not be populated when &apos;Unconfirmed SUN Order Number&apos; is available or &apos;Manual Transfer&apos; is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SalesTypeRequired</fullName>
        <active>true</active>
        <description>SSE-6174
The Sales Type field will be mandatory when the Invoice Status moves to Ready for SOE Review and the &apos;Manual Transfer&apos; is set to FALSE</description>
        <errorConditionFormula>AND(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),OR(ISPICKVAL(Invoice_Status__c ,&quot;Ready for SOE review&quot;),ISPICKVAL(Invoice_Status__c ,&quot;Ready for Sun Transfer&quot;)), Manual_Transfer__c =false,TEXT(Sales_Type__c )=&apos;&apos;)</errorConditionFormula>
        <errorDisplayField>Sales_Type__c</errorDisplayField>
        <errorMessage>Sales Type is required when Invoice Status is &apos;Ready for SOE Review&apos; or &apos;Ready for Sun Transfer&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderRefValidationforAutomatic</fullName>
        <active>true</active>
        <description>SSE-6199:An error message will appear if the user tries to modify the &apos;SUN Order Reference Number&apos; when &apos;Manual Transfer&apos; = &apos;False&apos; OR Unconfirmed Sun Order Reference is &apos;Blank&apos;</description>
        <errorConditionFormula>AND(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),NOT(ISNEW()),ISCHANGED(SunSystems_Order_Reference__c ) ,PRIORVALUE(SunSystems_Order_Reference__c) !=&apos;&apos;,NOT(ISBLANK(SunSystems_Order_Reference__c)),OR( Manual_Transfer__c =False,ISNULL(Unconfirmed_Sun_Order_Number__c )))</errorConditionFormula>
        <errorDisplayField>SunSystems_Order_Reference__c</errorDisplayField>
        <errorMessage>Since this record was automatically transferred, you are not allowed to modify the &apos;SUN Order Reference&apos;. You can delete this value to restart the transfer process.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderReference_Check_for_ManualEntry</fullName>
        <active>true</active>
        <description>SSE-5626:User cannot add value in the &apos;Sun Order Reference&apos; field manually until the Manual Transfer is Initiated and Invoice status is (Ready to Invoice,Transferring to SUN or SUN Order Complete)</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
AND(NOT(ISBLANK(SunSystems_Order_Reference__c)),
NOT(OR(ISPICKVAL(Invoice_Status__c,&apos;Ready to Invoice&apos;),ISPICKVAL(Invoice_Status__c,&apos;Sun Invoice Complete&apos;),ISPICKVAL(Invoice_Status__c,&apos;Sun Order Complete&apos;),ISPICKVAL(Invoice_Status__c,&apos;Cross Border&apos;) ,ISPICKVAL(Invoice_Status__c,&apos;No Usage&apos;),ISPICKVAL(Invoice_Status__c,&apos;Cancelled&apos;)))),false)</errorConditionFormula>
        <errorDisplayField>SunSystems_Order_Reference__c</errorDisplayField>
        <errorMessage>You are allowed to supply &apos;SUN Order Reference&apos; only when the Invoice Status is &apos;Cross Border&apos;, &apos;No Usage&apos;, &apos;Cancelled&apos; or &apos;Ready to Invoice&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sun_Invoice_Sun_order_cannot_be_edited</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
				NOT(
								CONTAINS($Profile.Name,&apos;System Admin&apos;)
				) &amp;&amp;
        NOT($Permission.Invoice_Header_Edit_fields) ,
				AND(
								NOT(ISBLANK(PRIORVALUE(Sun_Invoice_Number__c ))) ,
								OR( ISCHANGED(Sun_Invoice_Number__c ),
											ISCHANGED(SunSystems_Order_Reference__c ) 
										)
				),
				false
)</errorConditionFormula>
        <errorMessage>SUN Invoice Number cannot be updated if Invoice Status is &apos;SUN Invoice Complete&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cannot_edit_BU</fullName>
        <active>true</active>
        <errorConditionFormula>OR( ISCHANGED(BU__c ) ,IF(AND(ISNEW(),(TEXT(BU__c) &lt;&gt; (  TEXT(Order__r.Account.BU__c)  )  )), true, false))</errorConditionFormula>
        <errorMessage>BU cannot be edited</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Invoice_Header</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New Invoice Header</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>//First construct the new URL 
{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)} 
var result = sforce.connection.query(&quot;Select Id,CurrencyIsoCode,BU__c from Account where id =&apos;{!Contract.AccountId}&apos;&quot;); 
records = result.getArray(&quot;records&quot;); 
var newUrl = &quot;/a0c/e?RecordType=012D0000000Nei7&amp;CF00ND0000002gkft_lkid={!Contract.Id}&amp;CF00ND0000002gkft={!Contract.ContractNumber}&amp;CF00ND0000003n4sV_lkid={!Contract.AccountId}&amp;CF00ND0000003n4sV={!Contract.Account}&amp;CurrencyIsoCode={!Contract.CurrencyIsoCode}&amp;CF00ND0000002gkgD={!Contract.Billing_Contact__c}&amp;CF00ND0000002gkgD_lkid={!Contract.Billing_ContactId__c}&amp;00ND0000006F7XZ={!Contract.BU_From_Account__c}&amp;cancelURL=%2F{!Contract.Id}&amp;retURL=%2F{!Contract.Id}&amp;nooverride=1&quot;; 


//Then redirect the user to it 
window.parent.location.replace(newUrl);</url>
    </webLinks>
    <webLinks>
        <fullName>Super_Clone</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Super Clone</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)} 
var result = sforce.apex.execute(&quot;ContractInvoiceHeader_Manager&quot;, &quot;superClone&quot;, {invoiceHeaderId:&apos;{!Contract_Invoice_Header__c.Id}&apos;});
if(result==null || result.length==0)
  alert(&quot;Failed to Super Clone this invoice header. Error: UNKNOWN&quot;);
else
{
	if(result[0] == &quot;SUCCESS&quot;)
	{
		if(result.length&lt;3)
			alert(&apos;Invoice header has been cloned successfully however the new Invoice Header Id is UNKNOWN&apos;);
		else
		{
			alert(&quot;Invoice header has been cloned successfully and the new Invoice Header Id is &quot; + result[2]);
			window.parent.location.href = &quot;{!$Site.CurrentSiteUrl}/&quot; + result[1]; 
		}
	}
	else if(result[0] == &quot;UNAUTHORISED&quot;)
		alert(&quot;You are not authorized to Super Clone this invoice. Please contact your SFDC Administrator if you believe this to be incorrect.&quot;);
	else
		alert(&quot;Failed to Super Clone this invoice header. Error: &quot; + result[0]);
}</url>
    </webLinks>
</CustomObject>
