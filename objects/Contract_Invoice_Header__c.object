    <fields>
        <fullName>Invoice_Date__c</fullName>
        <inlineHelpText>refers to the date invoice is raised to the client in SUN Systems</inlineHelpText>
        <label>Sun Invoice Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Invoice_Due_Date__c</fullName>
        <description>This field tells the due date of invoice, based on the invoice date &amp; payement terms.</description>
        <formula>IF(
    ISBLANK(Invoice_Date__c),
    IF(
        ISBLANK(Parent_Invoice_header__r.Invoice_Date__c),
        NULL,
        IF(
            ISBLANK(Non_Default_Payment_Term_Formula__c),
            NULL,
            Parent_Invoice_header__r.Invoice_Date__c + 
            VALUE(
                LEFT(
                    Non_Default_Payment_Term_Formula__c,
                    FIND(&quot;D&quot;, Non_Default_Payment_Term_Formula__c) - 1
                )
            )
        )
    ),
    IF(
        ISBLANK(Non_Default_Payment_Term_Formula__c),
        NULL,
        Invoice_Date__c + 
        VALUE(
            LEFT(
                Non_Default_Payment_Term_Formula__c,
                FIND(&quot;D&quot;, Non_Default_Payment_Term_Formula__c) - 1
            )
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sun Invoice Due Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
