    <fields>
        <fullName>Debt_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Unpaid_Amount__c &lt;= 0 || ISNULL(Payment_Due_Date__c) ,IMAGE(&quot;/resource/1753334831000/Green_Status_Icon?&quot; , &quot;Green&quot; , 18, 19), IF(TODAY() -  Payment_Due_Date__c &lt; 45,IMAGE(&quot;/resource/1753334831000/Green_Status_Icon?&quot; , &quot;Green&quot; , 18, 19),IF(TODAY() - Payment_Due_Date__c &gt; 60,IMAGE(&quot;/resource/1753334831000/Red_Status_Icon?&quot; , &quot;Red&quot; , 18, 19),IMAGE(&quot;/resource/1753334831000/Amber_Status_Icon?&quot; , &quot;Amber&quot; , 18, 19))))</formula>
        <label>Debt Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
