    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Cant_choose_slot_date_within_four_weeks</fullName>
        <active>false</active>
        <description>User cannot book this slot as the Transition Slot Date is within four weeks of the current date</description>
        <errorConditionFormula>AND(NOT(OR( $Permission.Access_to_urgent_TC_slots ,$Profile.Name = &apos;CT&apos;,$Profile.Name = &apos;NEW Training User&apos;,$Profile.Name = &apos;System Administrator UK Client Helpdesk&apos;,$Profile.Name = &apos;System Administrator&apos;)),OR(Text(TC_Transition_Slot__r.Transition_Slot_Type__c)=&apos;Complex&apos;,Text(TC_Transition_Slot__r.Transition_Slot_Type__c) =&apos;Integrated&apos;),TC_Transition_Slot__r.Date__c - TODAY() &lt;= 28,OR(ISNEW(),ISCHANGED(TC_Transition_Slot__c)))</errorConditionFormula>
        <errorMessage>User cannot book this slot as the Transition Slot Date is within four weeks of the current date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cant_choose_slot_date_within_two_weeks</fullName>
        <active>false</active>
        <description>User cannot book this slot as the Transition Slot Date is within two weeks of the current date</description>
        <errorConditionFormula>AND(NOT(OR( $Permission.Access_to_urgent_TC_slots ,$Profile.Name = &apos;CT&apos;,$Profile.Name = &apos;NEW Training User&apos;,$Profile.Name = &apos;System Administrator UK Client Helpdesk&apos;,$Profile.Name = &apos;System Administrator&apos;)),
OR(Text(TC_Transition_Slot__r.Transition_Slot_Type__c) =&apos;Low Touch&apos;,Text(TC_Transition_Slot__r.Transition_Slot_Type__c) =&apos;Standalone&apos;),TC_Transition_Slot__r.Date__c - TODAY()  &lt;=  14,OR(ISNEW(),ISCHANGED(TC_Transition_Slot__c)))</errorConditionFormula>
        <errorMessage>User cannot book this slot as the Transition Slot Date is within two weeks of the current date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Defferal_Reason_Mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Current_Transition_Activity__c , &apos;Do Not Transition - Deferred&apos;), ISPICKVAL( Deferral_reason__c,&apos;&apos;))</errorConditionFormula>
        <errorDisplayField>Deferral_reason__c</errorDisplayField>
        <errorMessage>Please provide a deferral reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>On_Hold_Reason_Mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Current_Transition_Activity__c , &apos;Selected for Transition – On Hold&apos;), ISPICKVAL( On_Hold_Reason__c,&apos;&apos;))</errorConditionFormula>
        <errorDisplayField>On_Hold_Reason__c</errorDisplayField>
        <errorMessage>Please provide on hold reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrictions_on_TC_booking_status</fullName>
        <active>false</active>
        <description>Only the CT, New Training User and System Administrator UK Client Helpdesk profile have permissions to choose a booking status value as Confirmed, On Hold and Cancelled</description>
        <errorConditionFormula>AND(NOT(OR($Profile.Name = &apos;GCSC General&apos;,$Profile.Name = &apos;Commercial&apos;,$Profile.Name = &apos;NEW Training User&apos;,
$Profile.Name = &apos;System Administrator UK Client Helpdesk&apos;,$Profile.Name = &apos;System Administrator&apos;)),
OR(ISPICKVAL( Transition_Booking_Status__c,&quot;Confirmed&quot;), ISPICKVAL( Transition_Booking_Status__c,&quot;Cancelled&quot;),
ISPICKVAL( Transition_Booking_Status__c,&quot;On Hold&quot;),ISPICKVAL( Transition_Booking_Status__c,&quot;Suggested&quot;)),OR(ISNEW(),ISCHANGED(Transition_Booking_Status__c)))</errorConditionFormula>
        <errorDisplayField>Transition_Booking_Status__c</errorDisplayField>
        <errorMessage>Only the TalentCentral teams are able to confirm, cancel, suggested or move a booking to on hold</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrictions_on_TC_slot</fullName>
        <active>false</active>
        <description>Only the TalentCentral teams are able to choose slot in confirm, cancel or on hold booking status.</description>
        <errorConditionFormula>AND(NOT(OR($Profile.Name = &apos;CT&apos;,$Profile.Name = &apos;NEW Training User&apos;,$Profile.Name = &apos;System Administrator UK Client Helpdesk&apos;,$Profile.Name = &apos;System Administrator&apos;)), 
OR(ISPICKVAL( Transition_Booking_Status__c,&quot;Confirmed&quot;), ISPICKVAL( Transition_Booking_Status__c,&quot;Cancelled&quot;),ISPICKVAL( Transition_Booking_Status__c,&quot;On Hold&quot;),ISPICKVAL( Transition_Booking_Status__c,&quot;Suggested&quot;)),
OR(ISNEW(),ISCHANGED(TC_Transition_Slot__c)))</errorConditionFormula>
        <errorDisplayField>TC_Transition_Slot__c</errorDisplayField>
        <errorMessage>Please select booking status to Provisional.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Select_Customer_Success_Owner_Value</fullName>
        <active>false</active>
        <description>When the Current Transition Owner is set to GCSC the user must fill in the Customer Success Owner field</description>
        <errorConditionFormula>AND(ISPICKVAL(Current_Transition_Owner__c ,&apos;GCSC&apos;), Customer_Success_Owner__c=null )</errorConditionFormula>
        <errorDisplayField>Customer_Success_Owner__c</errorDisplayField>
        <errorMessage>Please Select the COO Owner.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Create_Case</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Create Case</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>/500/e?cas4={!Talent_Central__c.Account__c}&amp;cas4_lkid={! Talent_Central__c.AccountId__c}&amp;cas3={! Talent_Central__c.Transition_Contact__c}&amp;cas3_lkid={!Talent_Central__c.Transition_ContactId__c}&amp;CF00ND00000068vsc={!Talent_Central__c.Name}&amp;CF00ND00000068vsc_lkid={!Talent_Central__c.Id}</url>
    </webLinks>
</CustomObject>
