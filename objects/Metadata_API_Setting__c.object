<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>This setting will be used to store Client Id and Secret for Metadata API and bulk Export feature</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Consumer_Key__c</fullName>
        <externalId>false</externalId>
        <label>Consumer Key</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Consumer_Secret__c</fullName>
        <externalId>false</externalId>
        <label>Consumer Secret</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Metadata API Setting</label>
    <visibility>Public</visibility>
</CustomObject>
