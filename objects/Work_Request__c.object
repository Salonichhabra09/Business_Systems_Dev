    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Restrict_Product_Assessment_For_MFS</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL(Work_Request_Type__c , &apos;Client Submitted&apos;),
							ISPICKVAL(Work_Request_Type__c , &apos;Internal Submission&apos;)
							),
				NOT(ISNEW()),
				$Profile.Name != &apos;System Administrator&apos;, 
				CONTAINS(TEXT(System_Used__c) , &apos;360&apos;),
				ISCHANGED(Product_Assessment__c), 
				NOT(OR(CONTAINS(UPPER(Product_Assessment__c), &apos;SHL 360&apos;),
										CONTAINS(UPPER(Product_Assessment__c), &apos;NOMINATION&apos;),
										CONTAINS(UPPER(Product_Assessment__c), &apos;ENGAGEMENT&apos;)
										)
							)  
				)</errorConditionFormula>
        <errorDisplayField>Product_Assessment__c</errorDisplayField>
        <errorMessage>For 360 System, Product/Assessment should have one of the following: SHL 360, Nomination, or Engagement.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
