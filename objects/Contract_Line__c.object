        <columns>Project__c</columns>
        <columns>Contract__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Contract__c</field>
            <operation>equals</operation>
            <value>00154766</value>
        </filters>
        <label>All Orders</label>
    </listViews>
    <nameField>
        <displayFormat>CLN{0000000}</displayFormat>
        <label>Order Line</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Order Line</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Contract__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>End_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Start_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Price__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Project__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Contract__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Start_Date__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>End_Date__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Project__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Price__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Line_Description__c</lookupDialogsAdditionalFields>
        <searchFilterFields>NAME</searchFilterFields>
        <searchResultsAdditionalFields>Contract__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Start_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>End_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Price__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Currency_Should_Match_Order_Currency</fullName>
        <active>true</active>
        <description>Order Line currency must be same as related order currency.</description>
        <errorConditionFormula>IF(
NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
NOT(TEXT(CurrencyIsoCode) = TEXT( Contract__r.CurrencyIsoCode )),
false)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>Order Line currency must be same as related order currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>EndDatePastStartDate</fullName>
        <active>true</active>
        <description>End Date should not be on or before Start Date.</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),IF( End_Date__c - Start_Date__c &lt;=0 , TRUE, FALSE),false)</errorConditionFormula>
        <errorMessage>End Date should not be on or before Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>EndDateStartDateMandatoryonSubscription</fullName>
        <active>true</active>
        <description>Start Date and End Date are mandatory if the Order Line Item is Product Subscription, 360 Subscription, Advisory Services Subscription, Managed Services for Subscription, Sunstone Analytics Subscription or Candidate Support for Subscription.</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
IF( AND(OR(CONTAINS(Text(IM_Lookup_Code__c),&apos;Subscription&apos;),ISPICKVAL( IM_Lookup_Code__c , &quot;ODUNITSUBSCRIPT&quot;),ISPICKVAL( IM_Lookup_Code__c , &quot;Legacy Product - Licence&quot;),ISPICKVAL( IM_Lookup_Code__c , &quot;Leader Edge License&quot;),ISPICKVAL( IM_Lookup_Code__c , &quot;Precise Fit License&quot;)) , OR( ISBLANK(Start_Date__c),ISBLANK(End_Date__c))), True, False),
false)</errorConditionFormula>
        <errorMessage>Start Date and End Date are mandatory if the Order Line Item is a Subscription value or &apos;Legacy Product – Licence&apos; or &apos;Leader Edge License&apos; or &apos;Precise Fit License&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Leader_Edge_License_and_Precise_Fit_Lice</fullName>
        <active>true</active>
        <description>Leader Edge License &amp; Precise Fit License will act as subscription line items and Basis of Fees, Usage Cap or Estimation will become mandatory.</description>
        <errorConditionFormula>(
	ISBLANK(Usage_Estimate_Type__c) 
	|| ISBLANK(Usage_Cap__c)
) 
&amp;&amp; 
(
	Text(IM_Lookup_Code__c) == &apos;Leader Edge License&apos; 
	|| Text(IM_Lookup_Code__c) == &apos;Precise Fit License&apos; 
	
)</errorConditionFormula>
        <errorMessage>Basis of fees &amp; Usage Cap or Estimation are mandatory if Order Line item is Leader Edge License OR Precise Fit License.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MandatoryInvoiceschedulewithOrderMethod</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Text( Invoicing_Schedule__c )) &amp;&amp; Text( Order_Method__c ) == &apos;T&amp;E&apos;</errorConditionFormula>
        <errorDisplayField>Invoicing_Schedule__c</errorDisplayField>
        <errorMessage>&apos;Invoicing schedule’ must be selected when Order method equals &quot;T&amp;E&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Mandatory_5_Fields_on_OrdrLineItem_value</fullName>
        <active>true</active>
        <errorConditionFormula>(ISBLANK(Text(Usage_Allowance__c)) || ISBLANK( Text(Platform__c)) || ISBLANK(Usage_Estimate_Type__c) || ISBLANK(Usage_Cap__c) || ISBLANK(Equivalent_Units__c)) &amp;&amp; (Text(IM_Lookup_Code__c) == &apos;Product Subscription&apos; || Text(IM_Lookup_Code__c) == &apos;AM Product Subscription&apos; || Text(IM_Lookup_Code__c) == &apos;Units in advance&apos; || Text(IM_Lookup_Code__c) == &apos;Units in arrears&apos; || Text(IM_Lookup_Code__c) == &apos;Wardhead: Block (In Advance)&apos; || Text(IM_Lookup_Code__c) == &apos;Wardhead: Embed (In Arrears)&apos; || Text(IM_Lookup_Code__c) == &apos;Wardhead: Capped Subscription&apos; || Text(IM_Lookup_Code__c) == &apos;Wardhead: Uncapped Subscription&apos;||
Text(IM_Lookup_Code__c) == &apos;RemoteWorkQ - In Advance&apos; || Text(IM_Lookup_Code__c) == &apos;RemoteWorkQ - Limited Subscription&apos; || Text(IM_Lookup_Code__c) == &apos;RemoteWorkQ - Unlimited Subscription&apos; || Text(IM_Lookup_Code__c) == &apos;RemoteWorkQ - In Arrears&apos; || Text(IM_Lookup_Code__c) == &apos;Virtual AC/DC - Limited Subscription&apos;||
Text(IM_Lookup_Code__c) == &apos;SHL Experiences Subscription&apos;)</errorConditionFormula>
        <errorMessage>Basis of fees, Usage Allowance, Usage Cap or Estimation, Platform and Equivalent Units is mandatory if Order Line item is Product Subscription OR Units In Advance OR Units In Arrears.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OrginalOrderDoNotMatch</fullName>
        <active>true</active>
        <description>Selected original order do not match with order\&apos;s original order.</description>
        <errorConditionFormula>AND( Original_Order__c !=&apos;&apos;,
 Contract__r.Original_Order__c != Original_Order__c )</errorConditionFormula>
        <errorDisplayField>Original_Order__c</errorDisplayField>
        <errorMessage>Selected original order do not match with order\&apos;s original order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Platform_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND( ISPICKVAL(IM_Lookup_Code__c,&apos;Site set up&apos;),(ISPICKVAL(Platform__c,&apos;&apos;))),
AND( ISPICKVAL(IM_Lookup_Code__c,&apos;Sunstone Analytics Subscription&apos;),(ISPICKVAL(Platform__c,&apos;&apos;)))
)</errorConditionFormula>
        <errorDisplayField>Platform__c</errorDisplayField>
        <errorMessage>Platform is Mandatory for the value that you have selected in Order Line Item.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SourcePSScopingfieldMandatorywithIMcode</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Text(Source_of_PS_Scoping__c)) &amp;&amp; (Text(IM_Lookup_Code__c) == &apos;Consulting&apos; || Text(IM_Lookup_Code__c) == &apos;Training - In company&apos;)</errorConditionFormula>
        <errorDisplayField>Source_of_PS_Scoping__c</errorDisplayField>
        <errorMessage>&apos;Source of Scoping’ must be selected when Order Line Item equals “Consulting” or “Training - In company”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Usage_Cap_or_Estimation_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>IF((ISPICKVAL(Usage_Allowance__c,&apos;Capped&apos;) &amp;&amp; (TEXT(IM_Lookup_Code__c ) &lt;&gt; &apos;Product Subscription&apos; &amp;&amp; TEXT(IM_Lookup_Code__c ) &lt;&gt; &apos;Units in advance&apos; &amp;&amp; TEXT(IM_Lookup_Code__c ) &lt;&gt; &apos;Units in arrears&apos;) &amp;&amp; ISNULL(Usage_Cap__c)), true, false)</errorConditionFormula>
        <errorDisplayField>Usage_Cap__c</errorDisplayField>
        <errorMessage>Please provide the usage cap or estimation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Variationorderlinecheck</fullName>
        <active>true</active>
        <description>Variation order line can not be saved without linking to original order line.</description>
        <errorConditionFormula>AND( Contract__c !=&apos;&apos;,  Contract__r.Variation_Order__c ==&apos;Yes&apos;, Original_Order_Line__c ==&apos;&apos;)</errorConditionFormula>
        <errorDisplayField>Original_Order_Line__c</errorDisplayField>
        <errorMessage>Variation order line can not be saved without linking to original order line.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Contract_Line</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New Order Line</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>//First construct the new URL
{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)} 
var result = sforce.connection.query(&quot;Select Id,DefaultCurrencyIsoCode from User where id =&apos;{!$User.Id}&apos;&quot;); 
records = result.getArray(&quot;records&quot;);
var newUrl = &quot;{!URLFOR($Action.Contract_Line__c.New, null, [CF00ND0000002gkfv_lkid= Contract.Id , CF00ND0000002gkfv=   Contract.ContractNumber,CF00ND0000005FVJE_lkid= Contract.Original_OrderId__c   ,CF00ND0000005FVJE= Contract.Original_Order__c,retURL=$Request.retURL] ,true)}&quot;;
newUrl = newUrl+&quot;&amp;CurrencyIsoCode=&quot;+&apos;{!Contract.CurrencyIsoCode}&apos;+&quot;&quot;;

var conRel=&apos;{!Contract.Related_System_type__c}&apos;; 
conRel=escape(conRel); 

var ordersystemId=&apos;{!Contract.System_Client_ID__c}&apos;; 
ordersystemId=escape(ordersystemId); 


newUrl = newUrl+&quot;&amp;CurrencyIsoCode=&quot;+&apos;{!Contract.CurrencyIsoCode}&apos;+&quot;&amp;00ND0000005Fo0T=&quot;+conRel+&quot;&amp;00ND0000005Fo0U=&quot;+ordersystemId+&quot;&quot;; 


//Then redirect the user to it
window.parent.location.replace(newUrl);</url>
    </webLinks>
