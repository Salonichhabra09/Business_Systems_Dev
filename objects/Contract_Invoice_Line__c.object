    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One or more lines that make up the Invoice Request</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Billing_Frequency__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( Contract_Line_ID__r.Billing_Frequency__c )</formula>
        <label>Billing Frequency</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Client_Friendly_Name__c</fullName>
        <description>Formula Modified as per part of Story SSE-17005 : DEB (expenses) DO NOT show as a separate line</description>
        <externalId>false</externalId>
        <formula>if(UPPER(SUN_IM_lookup_code__c) = &apos;X10ADMIN&apos;, &apos;ADMINFEE&apos;,
					if(UPPER(SUN_IM_lookup_code__c) = &apos;DEB&apos;, &apos;Expenses&apos;,
							if(UPPER(SUN_IM_lookup_code__c) = &apos;FREIGHT&apos;, &apos;Freight&apos;	,Order_Product_Id__r.Client_Friendly_Name__c)))</formula>
        <label>Client Friendly Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contract_Line_ID__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Order Line ID (Legacy)</label>
        <referenceTo>Contract_Line__c</referenceTo>
        <relationshipLabel>Invoice Lines</relationshipLabel>
        <relationshipName>Invoice_Lines</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Contract_Line_Price__c</fullName>
        <description>Price from Contract Line</description>
        <formula>Order_Product_Id__r.Quantity * Order_Product_Id__r.UnitPrice</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Order Product Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Contract_Number_From_Invoice_Header__c</fullName>
        <description>Contract Number from the Contract that is on the Invoice Header</description>
        <externalId>false</externalId>
        <formula>Invoice_Header_ID__r.Order__r.OrderNumber</formula>
        <label>Order</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Discount_Amount__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Discount Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Discounted_Invoice_Line_Total__c</fullName>
        <formula>Invoice_Line_Total__c - Discount_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Invoice line total minus new discount number value</inlineHelpText>
        <label>Discounted Invoice Line Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Discounted__c</fullName>
        <formula>Discount_Amount__c / Invoice_Line_Total__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>% Discounted</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>IM_Lookup_Code_For_Filter__c</fullName>
        <description>this field is used to filter the rollup field</description>
        <externalId>false</externalId>
        <label>IM Lookup Code For Filter</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IM_Lookup_Code__c</fullName>
        <description>IM Lookup Code from Contract Line</description>
        <externalId>false</externalId>
        <formula>Order_Product_Id__r.Product2.StockKeepingUnit</formula>
        <label>IM Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Invoice_Header_ID__c</fullName>
        <label>Invoice Header ID</label>
        <referenceTo>Contract_Invoice_Header__c</referenceTo>
        <relationshipLabel>Invoice Lines</relationshipLabel>
        <relationshipName>Invoice_Lines</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Invoice_Line_Total__c</fullName>
        <label>Invoice Line Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>IsAutoCreated__c</fullName>
        <defaultValue>false</defaultValue>
        <label>IsAutoCreated</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Line_Amount__c</fullName>
        <description>Holds the Invoice Line price (i.e. if override price is non-zero it will hold that price else it will hold the Contract Line price)</description>
        <formula>IF((Price__c &lt;&gt; 0), Price__c, Contract_Line_Price__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Line Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Line_Description_From_Contract_Line__c</fullName>
        <description>Line Description from Contract Line</description>
        <externalId>false</externalId>
        <formula>Contract_Line_ID__r.Line_Description__c</formula>
        <label>Line Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Line_Total__c</fullName>
        <inlineHelpText>Total of Quantity * Price</inlineHelpText>
        <label>Line_Total</label>
        <precision>11</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Month__c</fullName>
        <externalId>false</externalId>
        <label>Month</label>
        <length>6</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Order_Line_Item__c</fullName>
        <externalId>false</externalId>
        <label>Order Product &amp; Service</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
