        <searchResultsAdditionalFields>Contract_Line_ID__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Invoice_Line_Total__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Currency_Should_Match_Invoice_H_Currency</fullName>
        <active>true</active>
        <description>Invoice Line currency must be same as related Invoice header currency.</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
NOT(TEXT(CurrencyIsoCode) = TEXT(  Invoice_Header_ID__r.CurrencyIsoCode )),
false)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>Invoice Line currency must be same as related Invoice header currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Discount_cannot_be_more_than_100</fullName>
        <active>true</active>
        <description>The % Discounted cannot hold the value more than 100%
Throw error if it is more than 100%</description>
        <errorConditionFormula>AND
( OR
(
(
Invoice_Line_Total__c &lt;&gt; 0
),
(
Invoice_Line_Total__c != NULL
)

)
, ((IF(ISNULL(Quantity__c ), Order_Product_Id__r.Quantity ,Quantity__c )*IF(OR((Price__c =0 ),ISNULL(Price__c)),Contract_Line_Price__c / Order_Product_Id__r.Quantity ,Price__c ))- Discount_Amount__c ) &lt;0,
IF(ISNULL(Quantity__c ), Order_Product_Id__r.Quantity ,Quantity__c )*IF(OR((Price__c =0 ),ISNULL(Price__c)),Contract_Line_Price__c / Order_Product_Id__r.Quantity ,Price__c )&gt;0)</errorConditionFormula>
        <errorMessage>Discount percentage offered cannot be more than 100%, please check the Discount Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Month_Format_Check</fullName>
        <active>false</active>
        <description>This rule ensures that Month is entered in the format &quot;yyyymm&quot;. This is made inactive on 24 Oct 2017 for SSE-5399</description>
        <errorConditionFormula>IF(NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
!REGEX( Month__c, &quot;((19|20)\\d\\d)(0?[1-9]|1[012])&quot;),
false)</errorConditionFormula>
        <errorDisplayField>Month__c</errorDisplayField>
        <errorMessage>Format of the month should be &quot;yyyymm&quot;</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Invoice_Line</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New Invoice Line</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>//First construct the new URL
{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}
var result = sforce.connection.query(&quot;Select Id,Account.CurrencyIsoCode from Order where id =&apos;{! Contract_Invoice_Header__c.OrderId__c}&apos;&quot;);
records = result.getArray(&quot;records&quot;);
var newUrl = &quot;{!urlFOR($Action.Contract_Invoice_Line__c.New,null,[CF00ND0000002gkfu_lkid= Contract_Invoice_Header__c.Id ,CF00ND0000002gkfu= Contract_Invoice_Header__c.Name ,cancelURL=urlFor($Action.Contract_Invoice_Header__c.View,Contract_Invoice_Header__c.Id,NULL,true)],true)}&quot;;
newUrl = newUrl+&quot;&amp;CurrencyIsoCode=&quot;+&apos;{!Order.CurrencyIsoCode}&apos;+&quot;&quot;;


//Then redirect the user to it
window.parent.location.replace(newUrl);</url>
    </webLinks>
</CustomObject>
