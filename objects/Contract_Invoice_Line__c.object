    </fields>
    <fields>
        <fullName>PO_Reference__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Purchase Order Reference (max 18 characters)</inlineHelpText>
        <label>PO Reference</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Per_Unit_Price_Calculated__c</fullName>
        <inlineHelpText>If Product is &apos;In Advance&apos;/&apos;In arrears&apos; then it will represent price per units, otherwise its a price per product billing frequency.</inlineHelpText>
        <label>Price Per (Billing Frequency OR Unit)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Per_Unit_Price__c</fullName>
        <formula>IF(  ISBLANK( Total_Equivalent_Units__c )  ,0,  Order_Product_Id__r.Total_Price__c  /  Total_Equivalent_Units__c )</formula>
        <label>Per-Unit Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
