        <fullName>ServicesTotal__c</fullName>
        <formula>if(ISPICKVAL(IM1_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),0,TotalAmount_IM1__c)+
if(ISPICKVAL(IM2_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),0,TotalAmount_IM2__c)+
if(ISPICKVAL(IM3_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),0,TotalAmount_IM3__c)+
if(ISPICKVAL(IM4_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),0,TotalAmount_IM4__c)+
if(ISPICKVAL(IM5_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),0,TotalAmount_IM5__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Services Total</label>
