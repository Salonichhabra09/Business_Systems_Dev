        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ReportSumExpenseRecharge__c</fullName>
        <formula>IF( ISPICKVAL( IM1_LookupCode__c  ,&quot;EXPENSE RECHARGE&quot;) , TotalAmount_IM1__c,0)+IF( ISPICKVAL( IM2_LookupCode__c  ,&quot;EXPENSE RECHARGE&quot;) ,TotalAmount_IM2__c,0)+
IF(  ISPICKVAL(IM3_LookupCode__c   , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM3__c,0)+IF(  ISPICKVAL(IM4_LookupCode__c   , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM4__c,0)+IF(  ISPICKVAL(IM5_LookupCode__c   , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM5__c,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ReportSumExpenseRecharge</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
