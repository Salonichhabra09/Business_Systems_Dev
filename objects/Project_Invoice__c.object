    <fields>
        <fullName>Contact_Name__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Specify the Contact to which this invoice belongs. By default, it is same as the Project.</inlineHelpText>
        <label>Contact</label>
        <lookupFilter>
            <active>false</active>
            <errorMessage>Contact with this name either does not exist or does not belong to the selected Account.</errorMessage>
            <filterItems>
                <field>Contact.AccountId</field>
                <operation>equals</operation>
                <valueField>$Source.Account__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Invoice Requests</relationshipLabel>
        <relationshipName>R00N20000001RCX0EAO</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
