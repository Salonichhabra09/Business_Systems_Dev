        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Discount__c</fullName>
        <inlineHelpText>Please enter the dscount percent.</inlineHelpText>
        <label>Discount %</label>
        <precision>8</precision>
        <required>false</required>
        <scale>6</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <defaultValue>TODAY()</defaultValue>
        <inlineHelpText>Select the End Date upto which the amount to be billed is calculated</inlineHelpText>
        <label>Invoice End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Expenses_Total__c</fullName>
        <description>Expenses total would be calculated on basis of as IM lookup code is selected as Expense recharge.</description>
        <formula>if(ISPICKVAL(IM1_LookupCode__c ,&quot;EXPENSE RECHARGE&quot;),TotalAmount_IM1__c,0)+
if(ISPICKVAL(IM2_LookupCode__c , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM2__c,0)+
if(ISPICKVAL(IM3_LookupCode__c , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM3__c,0)+
if(ISPICKVAL(IM4_LookupCode__c , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM4__c,0)+
if(ISPICKVAL(IM5_LookupCode__c , &quot;EXPENSE RECHARGE&quot;),TotalAmount_IM5__c,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Expenses Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Fixed_Amount__c</fullName>
        <label>Agreed Project Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
