    <webLinks>
        <fullName>Submit_for_Processing</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Submit for Processing</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/apex.js&quot;)}
var selectedInvoice =&quot;{!Project_Invoice__c.Id}&quot;;
var gmemberids = new Set();
var member;
var userId = &apos;{!$User.Id}&apos;;
var projectManagerSubstr;
var projectCoordinatorSubstr;
	if(&quot;{!Project_Invoice__c.Status__c}&quot;==&quot;In Progress&quot; )
	{
		var muGroup = sforce.connection.query(&quot;Select Id,(Select UserOrGroupId from GroupMembers) FROM Group WHERE Name in(&apos;Invoice Request Submitters&apos;)&quot; );
		var groups=muGroup.getArray(&quot;records&quot;);
		var members= groups[0].GroupMembers;
		var users=members.getArray(&quot;records&quot;);
		var usersid;
		for(var i=0;i&lt;users.length;i++){
		usersid=users[i].UserOrGroupId.substring(0,15);
		gmemberids.add(usersid);
		}
		var rslt = sforce.connection.query(&quot;Select id,CurrencyIsoCode,Project__c,Project__r.Order_Products_Count__c,Project__r.CurrencyIsoCode,Project__r.Order__c,Project__r.Order__r.CurrencyIsoCode, Project__r.Project_Manager__c, Project__r.Project_Co_ordinator__c, InvoicingTotal__c from Project_Invoice__c where id = &apos;{!Project_Invoice__c.Id}&apos; LIMIT 1&quot;);
		if(rslt.size&gt;0)
		{
		var records= rslt.getArray(&quot;records&quot;);
		var projectManager = records[0].Project__r.Project_Manager__c;
		var ProjectCurrency= records[0].Project__r.CurrencyIsoCode;
		var invoiceRequestCurrency = records[0].CurrencyIsoCode;
		var OrderCurrency;
		if(records[0].Project__r.Order_Header_Number__c!=null)
			OrderCurrency = records[0].Project__r.Order__r.CurrencyIsoCode;
		else
			OrderCurrency = null;
		if(projectManager != null)
			projectManagerSubstr = projectManager.substring(0,15);
		else
		projectManagerSubstr = null;
			var projectCoordinator = records[0].Project__r.Project_Co_ordinator__c;
		if(projectCoordinator != null)
			projectCoordinatorSubstr = projectCoordinator.substring(0,15);
		else
			projectCoordinatorSubstr = null;

		if(records[0].Project__r.Order_Products_Count__c==null)
		{
			alert(&apos;You are not allowed to submit this invoice for processing because its related project does not have order line number linked to.&apos;);
		}
		else if(records[0].InvoicingTotal__c==0)
		{
			alert(&apos;Invoice with 0.00 invoicing total can not be submitted for processing.&apos;);
		}
		else if(projectManagerSubstr != userId &amp;&amp; projectCoordinatorSubstr != userId &amp;&amp; !gmemberids.has(userId))
		{
			alert(&apos;You are not allowed to submit this invoice for processing because you are not the Project Manager/ Project Coordinator of the related project.&apos;);
		}
		else if(ProjectCurrency!=invoiceRequestCurrency)
		{
			alert(&apos;Invoice Request currency must be same as related Project currency.&apos;);
		}
		else if(OrderCurrency!=null &amp;&amp; ProjectCurrency!=OrderCurrency)
		{
			alert(&apos;An invoice request can not be submitted if the currency of the related project and order are not same.&apos;);
		}
		else
		{
			var result = sforce.apex.execute(&quot;ProjectInvoice_Manager&quot;, &quot;submitInvoice&quot;, {invoiceId: selectedInvoice});
		}
		}
		top.window.location.href = top.window.location.href;
	}
	else
	{
		alert(&quot;Invoice status should have a status of In Progress to be submitted for processing&quot;);
	}</url>
    </webLinks>
    <webLinks>
        <fullName>Update</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Update</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}

var queryResult = sforce.connection.query(&quot;Select Id, Name, Status__c, Date_Submitted__c,Date_Processed__c,(Select Status, TargetObjectId, CreatedDate  , LastModifiedDate From ProcessInstances where status=&apos;Approved&apos; Or status=&apos;Pending&apos;)  from Project_Invoice__c where Status__c&lt;&gt;&apos;In Progress&apos; AND (Date_Processed__c=null OR Date_Submitted__c=null)&quot;);
alert(queryResult.size);
if (queryResult.size &gt; 0)
{
	var recArray = queryResult.getArray(&quot;records&quot;); 
	for(var j=0;j&lt;recArray.length;j++)
	{ 
  		if(recArray[j].ProcessInstances!=null )
		{
       		var procArray = recArray[j].ProcessInstances.getArray(&quot;records&quot;); 
       		for(var k=0; k&lt;procArray.length;k++)
        	{       
            	var invoice= new sforce.SObject(&quot;Project_Invoice__c&quot;); 
                invoice.Id= recArray[j].Id;
                if(recArray[j].Date_Submitted__c ==null)
                	invoice.Date_Submitted__c=procArray[k].CreatedDate;
                if(recArray[j].Date_Processed__c ==null)
                    invoice.Date_Processed__c=procArray[k].LastModifiedDate;
                var saveResults = sforce.connection.update([invoice]);
             	}
		}
	}
}</url>
    </webLinks>
</CustomObject>
