    <webLinks>
        <fullName>Process_Request</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Process Request</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)} 

var result=sforce.connection.query(&quot;Select Id from GroupMember g where ( g.Group.Name=&apos;SSC&apos; OR g.Group.Name=&apos;OAT&apos;) and g.UserOrGroupId=&apos;{!$User.Id}&apos;&quot;); 
if(result.size&gt;0) 
{ 
if(&quot;{!Project_Invoice__c.Status__c}&quot;==&quot;Processed&quot;) 
{ 
alert(&quot;Sorry! This invoice has already been processed&quot;); 
window.close(); 
} 
else if (&quot;{!Project_Invoice__c.Status__c}&quot;==&quot;In Progress&quot;) 
{ 
alert(&quot;Sorry! This invoice has not been yet submitted for processing.&quot;); 
window.close(); 
} 
else {
if(&quot;{!Project_Invoice__c.Sun_Invoice_No__c}&quot;==&apos;&apos;) 
{
alert(&apos;Please enter the SUN Order No. in order to process this invoice request&apos;); 

}
else
{
var result = sforce.apex.execute(&apos;ProjectInvoice_Manager&apos;, &apos;approveInvoice&apos;, {InvoiicerequestId: &apos;{!Project_Invoice__c.Id}&apos;}); 
if(result!=&apos;true&apos;) 
alert(&quot;Sorry! The invoice request couldn&apos;t be processed. Please try again.&quot;); 
else 
{ 
window.location.reload();

}
	
}
}
} 
else 
{ 
alert(&quot;Sorry ! You are not authorised to process this Request&quot;); 
//window.close(); 
}</url>
    </webLinks>
