    <label>Invoice Request</label>
    <listViews>
        <fullName>All</fullName>
        <columns>Status__c</columns>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>Inv{000000}</displayFormat>
        <label>Invoice Request Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Invoice Requests</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Start_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>End_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Invoice_Header_Reference__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>InvoicingTotal__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Start_Date__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>End_Date__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Invoiced_Amount__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Status__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Invoice_Header_Reference__c</lookupDialogsAdditionalFields>
        <searchFilterFields>NAME</searchFilterFields>
        <searchFilterFields>Sun_Invoice_No__c</searchFilterFields>
        <searchResultsAdditionalFields>Start_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>End_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Invoiced_Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Invoice_Header_Reference__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Account_Contact_Validation</fullName>
        <active>true</active>
        <description>This validation rules checks whether the selected contact belongs the selected Account.</description>
        <errorConditionFormula>Account__r.Id &lt;&gt;  Contact_Name__r.AccountId</errorConditionFormula>
        <errorDisplayField>Contact_Name__c</errorDisplayField>
        <errorMessage>The Selected Contact on the Invoice Request does not belong to the selected Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Credit_Note_Reason_code_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Credit__c , ISPICKVAL( Credit_Note_Reason_code__c ,&quot;&quot;) )</errorConditionFormula>
        <errorDisplayField>Credit_Note_Reason_code__c</errorDisplayField>
        <errorMessage>Credit Note Reason code is required if the Credit tick box has been selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Currency_Should_Match_Project_Currency</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(TEXT(CurrencyIsoCode) = TEXT(  Project__r.CurrencyIsoCode  ))</errorConditionFormula>
        <errorMessage>Invoice Request currency must be same as related Project currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Discount_Approval_Validation</fullName>
        <active>true</active>
        <description>This validation ensures that the user specifies the Discount Approver in case any discounts are allowed.</description>
        <errorConditionFormula>AND(OR(NOT(ISNULL(IM1_Discount__c)),  NOT(ISNULL(IM2_Discount__c)),  NOT(ISNULL(IM2_Discount__c)),  NOT(ISNULL(IM2_Discount__c)), NOT(ISNULL(IM2_Discount__c))), IF(Discount_Approved_By__c = &apos;&apos;, true, false))</errorConditionFormula>
        <errorDisplayField>Discount_Approved_By__c</errorDisplayField>
        <errorMessage>Discounts can only be applied if the approver of such discounts is specified. Please specify the approver of this discount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM1_Limit_DiscountAmount</fullName>
        <active>true</active>
        <description>The validation ensures that the Discount Amount for IM Lookup 1 is not greater than the Amount(Quanity*UnitPrice) for IM1.</description>
        <errorConditionFormula>OR
(
AND( NOT(Credit__c) ,IM1_Discount__c &gt; (IM1_Quantity__c* IM1_UnitPrice__c )),
AND( Credit__c ,IM1_Discount__c&lt; (IM1_Quantity__c* IM1_UnitPrice__c ))
)</errorConditionFormula>
        <errorDisplayField>IM1_Discount__c</errorDisplayField>
        <errorMessage>The Discount amount for IM Lookup 1 cannot be greater than the actual Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM1_LookupCodeAndAmount_Mandatory</fullName>
        <active>true</active>
        <description>This validation rules ensures that either both the LookupCode and Amount of IM1 are entered or none.</description>
        <errorConditionFormula>OR
(
AND( ISPICKVAL(IM1_LookupCode__c, &apos;&apos;),  NOT(ISNULL( IM1_UnitPrice__c ))),
AND( NOT(ISPICKVAL(IM1_LookupCode__c,&apos;&apos;)),  ISNULL( IM1_UnitPrice__c ))
)</errorConditionFormula>
        <errorDisplayField>IM1_UnitPrice__c</errorDisplayField>
        <errorMessage>Please ensure that you either enter both the IM Lookup Code and its respective Amount for IM1 or none</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM2_Limit_DiscountAmount</fullName>
        <active>true</active>
        <description>The validation ensures that the Discount Amount for IM Lookup 2 is not greater than the Amount(Quanity*UnitPrice) for IM2.</description>
        <errorConditionFormula>OR 
( 
AND( NOT(Credit__c) ,IM2_Discount__c &gt; (IM2_Quantity__c* IM2_UnitPrice__c )), 
AND( Credit__c ,IM2_Discount__c&lt; (IM2_Quantity__c* IM2_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM2_Discount__c</errorDisplayField>
        <errorMessage>The Discount amount for IM Lookup 2 cannot be greater than the actual Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM2_LookupCodeAndAmount_Mandatory</fullName>
        <active>true</active>
        <description>This validation rules ensures that either both the LookupCode and Amount of IM2 are entered or none.</description>
        <errorConditionFormula>OR 
( 
AND( ISPICKVAL(IM2_LookupCode__c, &apos;&apos;), NOT(ISNULL( IM2_UnitPrice__c ))), 
AND( NOT(ISPICKVAL(IM2_LookupCode__c,&apos;&apos;)), ISNULL( IM2_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM2_UnitPrice__c</errorDisplayField>
        <errorMessage>Please ensure that you either enter both the IM Lookup Code and its respective Amount for IM 2 or none</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM3_Limit_DiscountAmount</fullName>
        <active>true</active>
        <description>The validation ensures that the Discount Amount for IM Lookup 3 is not greater than the Amount(Quanity*UnitPrice) for IM3.</description>
        <errorConditionFormula>OR 
( 
AND( NOT(Credit__c) ,IM3_Discount__c &gt; (IM3_Quantity__c* IM3_UnitPrice__c )), 
AND( Credit__c ,IM3_Discount__c&lt; (IM3_Quantity__c* IM3_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM3_Discount__c</errorDisplayField>
        <errorMessage>The Discount amount for IM Lookup 3 cannot be greater than the actual Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM3_LookupCodeAndAmount_Mandatory</fullName>
        <active>true</active>
        <description>This validation rules ensures that either both the LookupCode and Amount of IM3 are entered or none.</description>
        <errorConditionFormula>OR 
( 
AND( ISPICKVAL(IM3_LookupCode__c, &apos;&apos;), NOT(ISNULL( IM3_UnitPrice__c ))), 
AND( NOT(ISPICKVAL(IM3_LookupCode__c,&apos;&apos;)), ISNULL( IM3_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM3_UnitPrice__c</errorDisplayField>
        <errorMessage>Please ensure that you either enter both the IM Lookup Code and its respective Amount for IM3 or none</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM4_Limit_DiscountAmount</fullName>
        <active>true</active>
        <description>The validation ensures that the Discount Amount for IM Lookup 4 is not greater than the Amount(Quanity*UnitPrice) for IM4.</description>
        <errorConditionFormula>OR 
( 
AND( NOT(Credit__c) ,IM4_Discount__c &gt; (IM4_Quantity__c* IM4_UnitPrice__c )), 
AND( Credit__c ,IM4_Discount__c&lt; (IM4_Quantity__c* IM4_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM4_Discount__c</errorDisplayField>
        <errorMessage>The Discount amount for IM Lookup 4 cannot be greater than the actual Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM4_LookupCodeAndAmount_Mandatory</fullName>
        <active>true</active>
        <description>This validation rules ensures that either both the LookupCode and Amount of IM4 are entered or none.</description>
        <errorConditionFormula>OR 
( 
AND( ISPICKVAL(IM4_LookupCode__c, &apos;&apos;), NOT(ISNULL( IM4_UnitPrice__c ))), 
AND( NOT(ISPICKVAL(IM4_LookupCode__c,&apos;&apos;)), ISNULL( IM4_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM4_UnitPrice__c</errorDisplayField>
        <errorMessage>Please ensure that you either enter both the IM Lookup Code and its respective Amount for IM4 or none</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM5_Limit_DiscountAmount</fullName>
        <active>true</active>
        <description>The validation ensures that the Discount Amount for IM Lookup 5 is not greater than the Amount(Quanity*UnitPrice) for IM5.</description>
        <errorConditionFormula>OR 
( 
AND( NOT(Credit__c) ,IM5_Discount__c &gt; (IM5_Quantity__c* IM5_UnitPrice__c )), 
AND( Credit__c ,IM5_Discount__c&lt; (IM5_Quantity__c* IM5_UnitPrice__c )) 
)</errorConditionFormula>
        <errorDisplayField>IM5_Discount__c</errorDisplayField>
        <errorMessage>The Discount amount for IM Lookup 5 cannot be greater than the actual Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IM5_LookupCodeAndAmount_Mandatory</fullName>
        <active>true</active>
        <description>This validation rules ensures that either both the LookupCode and Amount of IM5 are entered or none.</description>
        <errorConditionFormula>OR
(
AND( ISPICKVAL(IM5_LookupCode__c, &apos;&apos;),  NOT(ISNULL( IM5_UnitPrice__c ))),
AND( NOT(ISPICKVAL(IM5_LookupCode__c,&apos;&apos;)),  ISNULL( IM5_UnitPrice__c ))
)</errorConditionFormula>
        <errorDisplayField>IM5_UnitPrice__c</errorDisplayField>
        <errorMessage>Please ensure that you either enter both the IM Lookup Code and its respective Amount for IM5 or none</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LBU_Validation</fullName>
        <active>true</active>
        <description>This validation ensures that LBU of the invoice is same as the project&apos;s LBU.</description>
        <errorConditionFormula>TEXT(LBU__c)&lt;&gt; TEXT(Project__r.LBU__c)</errorConditionFormula>
        <errorMessage>The LBU of the invoice request has to be same as the LBU of the project.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProjectCCYequaltoOrderCCY</fullName>
        <active>true</active>
        <description>Update on Invoice Request not allowed if the currency of the related project and the currency of the related order are not same.</description>
        <errorConditionFormula>IF(AND( Project__r.Order_Header_Number__c !=NULL,TEXT( Project__r.CurrencyIsoCode ) !=  TEXT( Project__r.Order_Header_Number__r.CurrencyIsoCode )),true,false )</errorConditionFormula>
        <errorMessage>Update on Invoice Request not allowed if the currency of the related project and the currency of the related order are not same.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderNumberMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL(Status__c, &quot;Processed&quot;), Sun_Invoice_No__c =&quot;&quot;)</errorConditionFormula>
        <errorMessage>Please enter SUN Order Number</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Invoice_Request</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New Invoice Request</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>if(&quot;{!ProjectObject__c.LBU__c}&quot;==&quot;GB1&quot;)
alert(&quot;You cannot create Invoice for GB1 LBU&quot;);
else
{
var url =&apos;{!URLFOR( $Action.Project_Invoice__c.New, Project_Invoice__c.Id , [CF00N20000001KCeI_lkid= ProjectObject__c.Id,CF00N20000001KCeI= ProjectObject__c.Name, CF00N20000001RCWm_lkid=ProjectObject__c.AccountId__c , CF00N20000001RCWm=ProjectObject__c.Account__c ,CF00N20000001RCX0_lkid= ProjectObject__c.ContactId__c, CF00N20000001RCX0= ProjectObject__c.Contact__c,CF00N20000001RCX5_lkid= ProjectObject__c.Billing_ContactId__c ,CF00N20000001RCX5= ProjectObject__c.Billing_Contact__c ,retURL=$Request.retURL,saveURL=$Request.retURL], true)}&apos;; 
window.parent.location.href =url ;
}</url>
    </webLinks>
    <webLinks>
        <fullName>New_Invoice_Request_LEX</fullName>
        <availability>online</availability>
        <description>Related List button at project level, to pre-populate fields from projects on invoice request creation.</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
