        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_Amount_to_be_Invoiced__c</fullName>
        <formula>IM5_UnitPrice__c + IM4_UnitPrice__c + IM2_UnitPrice__c + IM3_UnitPrice__c + IM1_UnitPrice__c + Total_Adjusted_Price__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total for all services and products invoiced in this Invoice Request.</inlineHelpText>
        <label>Total Amount to be Invoiced</label>
