        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/o/Project_Invoice__c/new?defaultFieldValues=Account__c={!ProjectObject__c.AccountId__c},Contact_Name__c={!ProjectObject__c.ContactId__c},LBU__c={!ProjectObject__c.LBU__c},CurrencyIsoCode={!ProjectObject__c.CurrencyIsoCode},Project__c={!ProjectObject__c.Id},Billing_Contact__c={!ProjectObject__c.Billing_ContactId__c}&amp;backgroundContext=/lightning/r/ProjectObject__c/{!ProjectObject__c.Id}/view?</url>
