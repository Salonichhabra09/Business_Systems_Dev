    <fields>
        <fullName>Rater_Types__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Manager_Ratings__c&gt;0, &apos;Manager;&apos;,&apos;&apos;) 
+ IF(Peer_Ratings__c&gt;0, &apos;Peer;&apos;,&apos;&apos;)
+ IF(Subordinate_Ratings__c&gt;0, &apos;Subordinate;&apos;,&apos;&apos;)
+ IF(Customer_Ratings__c&gt;0, &apos;Customer;&apos;,&apos;&apos;)
+ IF(Client_Ratings__c&gt;0, &apos;Client;&apos;,&apos;&apos;)
+ IF(Other_Ratings__c&gt;0, &apos;Other&apos;,&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rater Types</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
