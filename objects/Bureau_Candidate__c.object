        <fullName>Manager_Ratings__c</fullName>
        <description>This field calculates the number of Manager Ratings for this Participant.</description>
        <inlineHelpText>Number of Managers/Supervisors who are rating this Participant.</inlineHelpText>
        <label>Manager Ratings</label>
        <summaryFilterItems>
            <field>Bureau_Rating__c.Rater_Type__c</field>
            <operation>equals</operation>
            <value>Manager, Supervisor</value>
        </summaryFilterItems>
        <summaryForeignKey>Bureau_Rating__c.Participant__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
