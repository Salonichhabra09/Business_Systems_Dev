        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SFDC_Email__c</fullName>
        <externalId>false</externalId>
        <label>SFDC Email</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SFDC_Name__c</fullName>
        <externalId>false</externalId>
        <label>SFDC Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Self_Rating__c</fullName>
        <label>Self Rating</label>
        <summaryFilterItems>
            <field>Bureau_Rating__c.Rater_Type__c</field>
            <operation>equals</operation>
            <value>Self</value>
        </summaryFilterItems>
        <summaryForeignKey>Bureau_Rating__c.Participant__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Sequence_No__c</fullName>
        <description>This field is meant for storing the sequence number of the candidate</description>
        <externalId>false</externalId>
        <inlineHelpText>Sequence No of the candidiate</inlineHelpText>
        <label>Sequence No</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Session_ID__c</fullName>
        <externalId>false</externalId>
        <label>Session ID</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shortfall_Met__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(
OR(ISBLANK(Bureau_Job__r.ShortFall_Manager__c),Bureau_Job__r.ShortFall_Manager__c&lt;= Manager_Ratings__c),
OR(ISBLANK(Bureau_Job__r.Shortfall_Peer__c),Bureau_Job__r.Shortfall_Peer__c&lt;= Peer_Ratings__c),
OR(ISBLANK(Bureau_Job__r.Shortfall_Subordinate__c),Bureau_Job__r.Shortfall_Subordinate__c&lt;= Subordinate_Ratings__c),
OR(ISBLANK(Bureau_Job__r.ShortFall_Customer__c),Bureau_Job__r.ShortFall_Customer__c&lt;= Customer_Ratings__c),
OR(ISBLANK(Bureau_Job__r.Shortfall_Client__c),Bureau_Job__r.Shortfall_Client__c&lt;= Client_Ratings__c),
OR(ISBLANK(Bureau_Job__r.ShortFall_Other__c),Bureau_Job__r.ShortFall_Other__c&lt;= Other_Ratings__c)
),&quot;Yes&quot;,&quot;No&quot;)</formula>
        <label>Shortfall Met</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Special_Requirements__c</fullName>
        <externalId>false</externalId>
        <label>Special Requirements</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status2__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Not Started</fullName>
                    <default>true</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>Pass</fullName>
                    <default>false</default>
                    <label>Pass</label>
                </value>
                <value>
                    <fullName>Fail</fullName>
                    <default>false</default>
                    <label>Fail</label>
                </value>
                <value>
                    <fullName>DNA</fullName>
                    <default>false</default>
                    <label>DNA</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Total_Ratings__c ==  Ratings_Completed__c ,&quot;Completed&quot;,IF(Ratings_Completed__c&gt;0 ||  Ratings_In_Progress__c&gt;0,&quot;In Progress&quot;, &quot;Not Started&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Subordinate_Ratings__c</fullName>
        <description>This field represents the number of the Subordinate ratings for this Participant.</description>
        <inlineHelpText>Number of Direct Reports/Reports/Subordinate who are rating this Participant.</inlineHelpText>
        <label>Subordinate Ratings</label>
        <summaryFilterItems>
            <field>Bureau_Rating__c.Rater_Type__c</field>
            <operation>equals</operation>
            <value>Direct Report, Report, Subordinate</value>
        </summaryFilterItems>
        <summaryForeignKey>Bureau_Rating__c.Participant__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>System_s__c</fullName>
        <description>This field is used to capture System(s) applicable for a candidate</description>
        <externalId>false</externalId>
        <label>System(s)</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TESTDROP__c</fullName>
        <label>TESTDROP</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>1</fullName>
                    <default>false</default>
                    <label>1</label>
                </value>
                <value>
                    <fullName>2</fullName>
                    <default>false</default>
                    <label>2</label>
                </value>
                <value>
                    <fullName>3</fullName>
                    <default>false</default>
                    <label>3</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TEXT_TEST__c</fullName>
        <externalId>false</externalId>
        <label>TEXT  TEST</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Talent_Central_ID__c</fullName>
        <externalId>false</externalId>
        <label>Talent Central ID</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Testing_5th__c</fullName>
        <externalId>false</externalId>
        <label>Testing #/5th</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Title__c</fullName>
        <description>This field is created to store Title on Candidate which will captured via WRF</description>
        <externalId>false</externalId>
        <label>Title</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Ratings__c</fullName>
        <externalId>false</externalId>
        <formula>Ratings_Completed__c +  Ratings_In_Progress__c +  Ratings_Not_Started__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Ratings</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Total_Ratings__c==0,&quot;Respondent&quot;, &quot;Participant&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unique_Link__c</fullName>
        <label>Unique Link</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Username_New__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
				ISBLANK(Username__c), 
			IF(NOT(Email_as_Username__c),
			  NULL
			, Email__c)
			,Username__c
)</formula>
        <label>Username</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Username__c</fullName>
        <description>This field is used to capture Username based on Email as Username field</description>
        <externalId>false</externalId>
        <label>Username</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Work_Request__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Work Request</label>
        <referenceTo>Work_Request__c</referenceTo>
        <relationshipLabel>Managed Services Candidates</relationshipLabel>
        <relationshipName>Managed_Services_Candidates</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Year_of_Birth__c</fullName>
        <externalId>false</externalId>
        <label>Year of Birth</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>checkbox__c</fullName>
        <defaultValue>false</defaultValue>
        <label>checkbox</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>date__c</fullName>
        <label>date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>isExported__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is used for backend processing while candidate export.</description>
        <label>isExported</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>number__c</fullName>
        <externalId>false</externalId>
        <label>number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>test1__c</fullName>
        <externalId>false</externalId>
        <label>&amp;&amp;test1#</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>test__c</fullName>
        <externalId>false</externalId>
        <label>#test#@</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
