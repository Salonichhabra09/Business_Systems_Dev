    <label>Managed Services Candidate</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Participants</fullName>
        <columns>NAME</columns>
        <columns>Email__c</columns>
        <columns>Language__c</columns>
        <columns>Country__c</columns>
        <columns>Reports_Status__c</columns>
        <columns>Shortfall_Met__c</columns>
        <columns>Status__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Total_Ratings__c</field>
            <operation>notEqual</operation>
            <value>0</value>
        </filters>
        <label>Participants</label>
    </listViews>
    <listViews>
        <fullName>Respondents</fullName>
        <columns>NAME</columns>
        <columns>Email__c</columns>
        <columns>Gender__c</columns>
        <columns>Language__c</columns>
        <columns>Country__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Total_Ratings__c</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <label>Respondents</label>
    </listViews>
    <nameField>
        <displayFormat>BC{000000000}</displayFormat>
        <label>Candidate Id</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Managed Services Candidates</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Bureau_Job__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>First_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Last_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Email__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Gender__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Phone_Number__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Product_Assessment__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Export_Candidates</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Export Candidates</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>window.location.href= &apos;/apex/BureauJob_CustomReportGenerator?id={!Job__c.Id}&amp;reportName=CandidatesUploadSheet&apos;;</url>
    </webLinks>
    <webLinks>
        <fullName>Import_Candidates</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Import Candidates</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>window.location.href= &apos;/apex/ImportCandidates?id={!Job__c.Id}&apos;;</url>
    </webLinks>
</CustomObject>
