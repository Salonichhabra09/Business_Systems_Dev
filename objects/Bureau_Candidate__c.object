    <fields>
        <fullName>Number_of_Product_Assessment__c</fullName>
        <description>This field is used to capture the count of Products &amp; Assessments for a Candidate</description>
        <externalId>false</externalId>
        <formula>IF(
					 OR(
										CONTAINS(Category__c, &apos;Self&apos;),
										Category__c == null
								),
					 IF(
								CONTAINS((Product_Assessment__c), &apos;,&apos;),
								LEN(Product_Assessment__c) - LEN( SUBSTITUTE(Product_Assessment__c, &apos;,&apos;, &apos;&apos;)) + 1,
								IF(
								!CONTAINS((Product_Assessment__c), &apos;,&apos;),
								1,
								0)),
					 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number of Product/Assessment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_of_Respondents__c</fullName>
        <description>This field is used to capture the count of Ratings other than Self for a Candidate Roll-Up of candidates with &quot;Rater Type&quot; equals &quot;Manager, Colleagues, Others, Direct Reports&quot;</description>
        <label>Number of Respondents</label>
        <summaryFilterItems>
            <field>Bureau_Rating__c.Rater_Type__c</field>
            <operation>equals</operation>
            <value>Manager, Colleagues, Others, Direct Reports</value>
        </summaryFilterItems>
        <summaryForeignKey>Bureau_Rating__c.Participant__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Number_of_participants__c</fullName>
        <description>This field is used to capture the count of Self Ratings for a Candidate Roll-Up of candidates with &quot;Rater Type&quot; equals &quot;Self&quot;</description>
        <label>Number of participants</label>
        <summaryFilterItems>
            <field>Bureau_Rating__c.Rater_Type__c</field>
            <operation>equals</operation>
            <value>Self</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Bureau_Rating__c.TC_Status__c</field>
            <operation>notEqual</operation>
            <value>Recalled</value>
        </summaryFilterItems>
        <summaryForeignKey>Bureau_Rating__c.Participant__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
