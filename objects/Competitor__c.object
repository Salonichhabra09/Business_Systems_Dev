    <label>Competitor</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Competitor__c</columns>
        <columns>Account__c</columns>
        <columns>Opportunity__c</columns>
        <columns>Incumbent_Vendor__c</columns>
        <columns>Incumbent_Value__c</columns>
        <columns>Industry__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>CMP-{0000000}</displayFormat>
        <label>Competitor Data</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Competitors</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AutoCreate_Displcmnt_Opp_Cant_be_blank</fullName>
        <active>true</active>
        <description>If the Opportunity field is populated on a competitor entry, Auto-create Displacement Opportunity cannot be blank.</description>
        <errorConditionFormula>AND(
Opportunity__c!=&apos;&apos;,
ISPICKVAL(Auto_create_Displacement_Opportunity__c, &quot;&quot;),
$Profile.Name != &apos;System Administrator&apos;
)</errorConditionFormula>
        <errorDisplayField>Auto_create_Displacement_Opportunity__c</errorDisplayField>
        <errorMessage>Auto-create Displacement Opportunity cannot be blank If an Opportunity is linked to a competitor.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Create_Displacement_Opportunity</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( ISPICKVAL(Incumbent_Vendor__c, &quot;Yes&quot;),
ISPICKVAL(Auto_create_Displacement_Opportunity__c, &quot;&quot;),
NOT(ISNULL( Incumbent_Renewal_Date__c )),
$Profile.Name != &apos;System Administrator&apos;
)</errorConditionFormula>
        <errorDisplayField>Auto_create_Displacement_Opportunity__c</errorDisplayField>
        <errorMessage>Do you want to create a holding opportunity timed to displaced this competitor?</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incumbent_Renewal_Date_Cannot_be_in_Past</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 Incumbent_Renewal_Date__c &lt;TODAY(),
OR(
 ISNEW(),
 ISCHANGED(Incumbent_Renewal_Date__c)
),
$Profile.Name !=&apos;System Administrator&apos;)</errorConditionFormula>
        <errorDisplayField>Incumbent_Renewal_Date__c</errorDisplayField>
        <errorMessage>Incumbent Renewal Date cannot be in past. Please insert valid date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incumbent_Renewal_Date_is_required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Auto_create_Displacement_Opportunity__c, &quot;Yes&quot;),
OR(ISNULL(Incumbent_Renewal_Date__c),
ISPICKVAL( Incumbent_Vendor__c ,&apos;&apos;),
 Opportunity__c ==&apos;&apos;
),
 $Profile.Name !=&apos;System Administrator&apos;)</errorConditionFormula>
        <errorMessage>Please provide the incumbent competitor&apos;s renewal date, Incumbent vendor and opportunity  to auto create displacement opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incumbent_Value_required</fullName>
        <active>false</active>
        <description>If Incumbent Vendor = TRUE and related Opportuntiy is NULL create separate validation rule to force Incumbent Value</description>
        <errorConditionFormula>AND(
 ISPICKVAL(Incumbent_Vendor__c,&apos;YES&apos;),
 Opportunity__c=&apos;&apos;,
 ISBLANK(Incumbent_Value__c),
$Profile.Name != &apos;System Administrator&apos;
)</errorConditionFormula>
        <errorDisplayField>Incumbent_Value__c</errorDisplayField>
        <errorMessage>Incumbent Value is required, if incumbent vendor is Yes and no opportunity is linked to the record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Renewal_Date_Requird_if_Vendor_is_Yes</fullName>
        <active>false</active>
        <description>Incumbent renewal date should be mandatory if the Incumbent Vendor is true.</description>
        <errorConditionFormula>AND(
ISPICKVAL(Incumbent_Vendor__c,&apos;YES&apos;),
ISNULL(Incumbent_Renewal_Date__c),
$Profile.Name !=&apos;System Administrator&apos;
)</errorConditionFormula>
        <errorDisplayField>Incumbent_Renewal_Date__c</errorDisplayField>
        <errorMessage>Incumbent Renewal Date is Required if Incumbent vendor is Yes</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Competitor</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/o/Competitor__c/new?defaultFieldValues=Opportunity__c={!Opportunity.Id},Account__c={!Opportunity.AccountId}&amp;backgroundContext=/lightning/r/Opportunity/{!Opportunity.Id}/related/Competitors__r/view</url>
    </webLinks>
</CustomObject>
