                    <default>false</default>
                    <label>Talent Acquisition - Tech</label>
                </value>
                <value>
                    <fullName>Talent Acquisition - Sales</fullName>
                    <default>false</default>
                    <label>Talent Acquisition - Sales</label>
                </value>
                <value>
                    <fullName>Talent Acquisition - Professional</fullName>
                    <default>false</default>
                    <label>Talent Acquisition - Professional</label>
                </value>
