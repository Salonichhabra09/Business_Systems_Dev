    <fields>
        <fullName>Associate_Cost__c</fullName>
        <description>The number of associate days against the associate cost per day (SF field: “day rate”) excluding expenses where cost type = “Associate Consultant” OR “volunteer”</description>
        <formula>IF(OR(TEXT( Associate_Type__c )=&apos;Associate Consultant&apos;,TEXT( Associate_Type__c )=&apos;Volunteer&apos;) , Value__c  , 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The number of associate days against the associate cost per day (SF field: “day rate”) excluding expenses where cost type = “Associate Consultant” OR “volunteer”</inlineHelpText>
        <label>Associate Cost</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
