    <fields>
        <fullName>Total_Costs__c</fullName>
        <description>Sum of Associate Costs, LBU Costs and Expenses</description>
        <formula>Value__c  +  Expenses__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Sum of Associate Costs, LBU Costs and Expenses</inlineHelpText>
        <label>Total Costs</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_Invoice_Amount__c</fullName>
        <formula>Value__c +  Expenses__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Invoice Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Value__c</fullName>
        <formula>Day_Rate__c  * Days_Worked__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This amount should exclude tax</inlineHelpText>
        <label>Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <label>Associate and other Cost</label>
    <listViews>
        <fullName>Europe_Assoc_POs_Specific_Assoc</fullName>
        <columns>Associate__c</columns>
        <columns>Date_Invoiced_Received__c</columns>
        <columns>NAME</columns>
        <columns>Project__c</columns>
        <columns>Associate_Cost__c</columns>
        <columns>Delivery_BU__c</columns>
        <columns>Days_Worked__c</columns>
        <columns>Approved_By__c</columns>
        <columns>Associate_Notes__c</columns>
        <columns>Expenses__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Delivery_BU__c</field>
            <operation>equals</operation>
            <value>BE5,CH1,DE5,DK1,FI1,FR5,IT1,NL5,NO1,SE1,UK1</value>
        </filters>
        <filters>
            <field>Date_Invoiced_Received__c</field>
            <operation>equals</operation>
            <value>LAST_MONTH</value>
        </filters>
        <filters>
            <field>Associate_Type__c</field>
            <operation>equals</operation>
            <value>Associate Consultant,External Partner</value>
        </filters>
        <filters>
            <field>Associate_Status__c</field>
            <operation>equals</operation>
            <value>Provisional,Confirmed</value>
        </filters>
        <filters>
            <field>Associate__c</field>
            <operation>contains</operation>
            <value>Maaike</value>
        </filters>
        <label>Europe Assoc POs - Specific Assoc</label>
    </listViews>
    <listViews>
        <fullName>PO_Status</fullName>
        <columns>NAME</columns>
        <columns>Date_Invoiced_Received__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Associate__c</columns>
        <columns>Associate_Notes__c</columns>
        <columns>Associate_Status__c</columns>
        <columns>Courses__c</columns>
        <columns>Total_Invoice_Amount__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATEDBY_USER</field>
            <operation>equals</operation>
            <value>,sally treloar,aimee murray,tilden lamb,lauren hickford,shola stoute</value>
        </filters>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2009 12:00 AM</value>
        </filters>
        <label>PO Status this year</label>
    </listViews>
    <nameField>
        <displayFormat>T{00000}</displayFormat>
        <label>T Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Associate and other Costs</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Associate__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Courses__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Invoice_Month__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Associate__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Courses__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Invoice_Month__c</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Associate__c</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Courses__c</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Invoice_Month__c</lookupPhoneDialogsAdditionalFields>
        <searchFilterFields>NAME</searchFilterFields>
        <searchFilterFields>Associate__c</searchFilterFields>
        <searchFilterFields>Courses__c</searchFilterFields>
        <searchFilterFields>Invoice_Month__c</searchFilterFields>
        <searchResultsAdditionalFields>Associate__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Courses__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Invoice_Month__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AssociateNameValidationRule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL(Associate_Type__c ,&apos;Associate Consultant&apos;),ISPICKVAL(Associate_Type__c ,&apos;Volunteer&apos;), ISPICKVAL(Associate_Type__c ,&apos;External Partner&apos;) ) , LEN(Associate__c )=0)</errorConditionFormula>
        <errorDisplayField>Associate__c</errorDisplayField>
        <errorMessage>Please select the Associate Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Associate_Notes_field_mandatory</fullName>
        <active>true</active>
        <description>The &apos;Associate Notes&apos; field needs to be mandatory if the &apos;cost type&apos; is set up to &apos;other&apos;</description>
        <errorConditionFormula>AND( ISPICKVAL( Associate_Type__c ,&apos;Other&apos;) , ISBLANK( Associate_Notes__c ) )</errorConditionFormula>
        <errorMessage>The &apos;Associate Notes&apos; field needs to be mandatory as the &apos;cost type&apos; is set up to &apos;other&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Associate_Notes_mandatory_reason_other</fullName>
        <active>true</active>
        <description>The &apos;Associate Notes&apos; field needs to be mandatory as the reason is set up to &apos;other&apos;</description>
        <errorConditionFormula>AND( ISPICKVAL( Reason__c,&apos;Other&apos; ) , ISBLANK( Associate_Notes__c ))</errorConditionFormula>
        <errorMessage>The &apos;Associate Notes&apos; field needs to be mandatory as the reason is set up to &apos;other&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CourseOrProjectRequired</fullName>
        <active>true</active>
        <errorConditionFormula>AND(  Courses__c =&quot;&quot; , Project__c =&quot;&quot;)</errorConditionFormula>
        <errorMessage>Course or Project must be completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DateInvoicedMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Project__c &lt;&gt;&quot;&quot; || Project__c &lt;&gt;&quot;a0920000002roAP&quot;,   NOT( ISPICKVAL(Associate_Type__c,&quot;Development Team&quot;) ),ISNULL(Date_Invoiced_Received__c))</errorConditionFormula>
        <errorDisplayField>Date_Invoiced_Received__c</errorDisplayField>
        <errorMessage>Please populate the Date  Incurred field for all project-related SHL incurred expenses.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Days_Worked_Are_Required</fullName>
        <active>true</active>
        <description>SSE-11327 - To make Days worked mandatory if there is a value in Day Rate field</description>
        <errorConditionFormula>AND(NOT(ISBLANK(Day_Rate__c)),ISBLANK(Days_Worked__c))</errorConditionFormula>
        <errorDisplayField>Days_Worked__c</errorDisplayField>
        <errorMessage>Days worked are required, when a Day rate is defined</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_field_mandatory</fullName>
        <active>true</active>
        <description>Reason field to be mandatory if the &apos;Cost Type&apos; is set up to &apos;Associate Consultant&apos;</description>
        <errorConditionFormula>AND(ISPICKVAL( Associate_Type__c ,&apos;Associate Consultant&apos;), ISPICKVAL(Reason__c, &quot;&quot;) )</errorConditionFormula>
        <errorMessage>Reason field needs to be mandatory as the &apos;Cost Type&apos; is &apos;Associate Consultant&apos;</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New Associate and other Cost</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>var newUrl;
if(&quot;{!ProjectObject__c.Id}&quot;!=&quot;&quot;)
{
newUrl = &quot;{!URLFOR( $Action.Associate__c.New, null,
[CF00N20000001PpCz_lkid=ProjectObject__c.Id,
CF00N20000001PpCz=ProjectObject__c.Name,
retURL=$Request.retURL] ,true)}&quot;;
}
else if (&quot;{!Courses__c.Id}&quot;!=&quot;&quot;)
{
newUrl = &quot;{!URLFOR( $Action.Associate__c.New, null, 
[CF00N20000001IjwC_lkid=Courses__c.Id, 
CF00N20000001IjwC=Courses__c.Name, 
retURL=$Request.retURL] ,true)}&quot;; 
}
else
{
newUrl = &quot;{!URLFOR( $Action.Associate__c.New, null,
[retURL=$Request.retURL] ,true)}&quot;;
}

window.parent.location.replace(newUrl);</url>
    </webLinks>
