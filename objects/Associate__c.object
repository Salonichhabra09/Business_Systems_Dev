    <fields>
        <fullName>LBU_Cost__c</fullName>
        <description>The number of associate days against the associate cost per day (SF field: “day rate”) excluding expenses where cost type = “LBU”</description>
        <formula>IF( TEXT( Associate_Type__c )=&apos;LBU&apos; ,  Value__c,0)</formula>
