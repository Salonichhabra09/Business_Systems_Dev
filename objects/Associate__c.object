    <fields>
        <fullName>Other_Cost__c</fullName>
        <description>To calculate Costs where Cost Type not LBU, Associate Consultant</description>
        <formula>IF( NOT(OR(TEXT( Associate_Type__c )=&apos;LBU&apos; ,
 TEXT( Associate_Type__c )=&apos;Associate Consultant&apos;)),
 Value__c,0)</formula>
        <inlineHelpText>To calculate Costs where Cost Type not LBU, Associate Consultant</inlineHelpText>
        <label>Other Cost</label>
