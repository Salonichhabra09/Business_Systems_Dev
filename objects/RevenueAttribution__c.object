    <validationRules>
        <fullName>Atrribution_Rate_must_be_greater_than_0</fullName>
        <active>true</active>
        <description>When Project- Scoped equals Scoped and Billable equals Billable then Attribution rate must be completed. Value must be greater than zero.</description>
        <errorConditionFormula>AND(  ISPICKVAL( Scoped__c , &quot;Scoped&quot;) ,  ISPICKVAL(  Billable__c  , &quot;Billable&quot;) ,   OR(Attribution_Rate__c&lt;=0, ISNULL(Attribution_Rate__c) ) )</errorConditionFormula>
        <errorMessage>Attribution Rate must be greater than 0 as this Attribution record is set to Scoped and Billable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Attribution_rate_cannot_have_any_value</fullName>
        <active>true</active>
        <description>If Scoped equals Non-scoped OR Scoped equals Scoped and Billable equals Free or Subscription Support then the Attribution rate field cannot have a value</description>
        <errorConditionFormula>IF( ISPICKVAL( Scoped__c , &quot;Non-scoped&quot;) ,  NOT( ISNULL( Attribution_Rate__c ) ) ,  IF( OR( ISPICKVAL( Billable__c , &quot;Free&quot;) ,ISPICKVAL( Billable__c , &quot;Subscription Support&quot;)) , NOT( ISNULL( Attribution_Rate__c ) ), false) )</errorConditionFormula>
        <errorDisplayField>Attribution_Date__c</errorDisplayField>
        <errorMessage>Attribution rate field cannot have a value as this Attribution record is set to Non-Scoped or Scoped and Free or Scoped and Subscription Support.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Milestone_Period_is_closed_on_create</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISNEW(), Attribution_Period__r.Financial_Period_Closed__c )</errorConditionFormula>
        <errorDisplayField>Attribution_Date__c</errorDisplayField>
        <errorMessage>Record cannot be saved as milestone period is closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Milestone_Period_is_closed_on_update</fullName>
        <active>true</active>
        <errorConditionFormula>AND( NOT( ISNEW() ) , NOT(RecordType.Name =&quot;Attribution ReadOnly Record Type&quot;), Attribution_Period__r.Financial_Period_Closed__c )</errorConditionFormula>
        <errorMessage>Record cannot be saved as milestone period is closed.</errorMessage>
    </validationRules>
