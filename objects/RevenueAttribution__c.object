    <fields>
        <fullName>AccountOwnerEmail__c</fullName>
        <description>This field is created to retrieve project&apos;s account owner and is referred in email template.</description>
        <externalId>false</externalId>
        <formula>Project__r.Account__r.Owner.Email</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AccountOwnerEmail</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Attribution_Date__c</fullName>
