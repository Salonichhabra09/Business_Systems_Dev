        <relationshipLabel>PS Invoice Billing Details</relationshipLabel>
        <relationshipName>Invoice_Billing_Details</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
