        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Associate_Costs__c</fullName>
        <description>The number of associate days against the associate cost per day excluding expenses where cost type = “Associate Consultant” OR “volunteer”</description>
        <inlineHelpText>The number of associate days against the associate cost per day excluding expenses where cost type = “Associate Consultant” OR “volunteer”</inlineHelpText>
        <label>Total Associate Costs</label>
        <summarizedField>Associate__c.Value__c</summarizedField>
        <summaryFilterItems>
            <field>Associate__c.Associate_Type__c</field>
            <operation>equals</operation>
            <value>Associate Consultant, Volunteer</value>
        </summaryFilterItems>
        <summaryForeignKey>Associate__c.Project__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Attributions_Day__c</fullName>
