var queryResult=sforce.connection.query(&quot;Select Functional_Area__c from ProjectObject__c&quot;   LIMIT 5);
if (queryResult.size &gt; 0) 
{ 
var recArray = queryResult.getArray(&quot;records&quot;); 

for(var j=0;j&lt;recArray.length;j++) 
{ 
var functionalArea=recArray [j].Functional_Area__c;
functionalArea.replace(&quot;PConsulting&quot;,&quot;PS Consulting&quot;);
alert(functionalArea);
alert(&quot;Replaced &quot;+functionalArea);
