        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)} 
var result = sforce.connection.query(&quot;Select Id,LBU__c, CreatedDate from ProjectObject__c ORDER BY Name ASC LIMIT 1&quot;);
if(result.size&gt;0) 
{ 
var records= result.getArray(&quot;records&quot;); 
for(var j=0;j&lt;records.length;j++) 
{ 
var project= new sforce.SObject(&quot;ProjectObject__c&quot;); 
//var getId= records[j].Id;
///var getLBU= records[j].LBU__c;
///var getdate = records[j].CreatedDate;
var result = sforce.apex.execute(&apos;Project_Manager&apos;, &apos;changeProjectNumberFormat&apos;, {selectedProject:records[j]});
if(result==&apos;false&apos;)
alert(&quot;Sorry! Please try again.&quot;);
} 
}</url>
