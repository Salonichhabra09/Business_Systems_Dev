    <fields>
        <fullName>Total_Chargeable_Expenses__c</fullName>
        <description>To add Associate Chargeable Expenses and Expenses which are chargeable.</description>
        <formula>Chargeable_Expenses__c  +  Associate_Chargeable_Expenses__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Chargeable expenses plus associate chargeable expenses</inlineHelpText>
        <label>Total Chargeable Expenses</label>
