    <fields>
        <fullName>Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR (2 AND 3) OR 4</booleanFilter>
            <errorMessage>Project Cannot be created from a Variation Opportunity.</errorMessage>
            <filterItems>
                <field>Opportunity.Variation_Opportunity__c</field>
                <operation>equals</operation>
                <value>No</value>
            </filterItems>
            <filterItems>
                <field>Opportunity.Variation_Opportunity__c</field>
                <operation>equals</operation>
                <value>Yes</value>
            </filterItems>
            <filterItems>
                <field>Opportunity.CreatedDate</field>
                <operation>lessOrEqual</operation>
                <value>4/6/2021, 9:00 AM</value>
            </filterItems>
            <filterItems>
                <field>$User.Id</field>
                <operation>equals</operation>
                <value>0054G00000CSIBq</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Projects</relationshipLabel>
