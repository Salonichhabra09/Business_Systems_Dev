        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Time_Cost__c</fullName>
        <description>Internal  costs. Recorded timesheet hours (all users, task categories and tasks recorded on the project) against a standard hourly cost. Hourly costs are set in the SF user-profile of each user.</description>
        <inlineHelpText>Internal  costs. Recorded timesheet hours (all users, task categories and tasks recorded on the project) against a standard hourly cost. Hourly costs are set in the SF user-profile of each user.</inlineHelpText>
        <label>Time Cost (Legacy)</label>
