    <webLinks>
        <fullName>Notify_Account_Manager</fullName>
        <availability>online</availability>
        <description>On click of button email will be send to related Account Manager.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Notify Account Manager</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}
var currentuser = &apos;{!User.Id}&apos;;
var proejectmanager = &apos;{!ProjectObject__c.Project_ManagerId__c}&apos;;
var projectcoordinator = &apos;{!ProjectObject__c.Project_Co_ordinatorId__c}&apos;;
if(currentuser == proejectmanager || currentuser ==  projectcoordinator)
	{
	location.replace(&apos;/email/author/emailauthor.jsp?retURL=/{!ProjectObject__c.Id}&amp;p3_lkid={!ProjectObject__c.Id}&amp;template_id=00XD0000002FGDJ&amp;p24={!URLENCODE(ProjectObject__c.Account_Owner_Email__c)}&apos;);
