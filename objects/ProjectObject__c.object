    <fields>
        <fullName>Total_Other_Costs__c</fullName>
        <description>Other cost  excluding expenses where costs type &lt;&gt; “LBU” OR “Associate Consultant” OR “volunteer”</description>
        <inlineHelpText>Other cost  excluding expenses where costs type &lt;&gt; “LBU” OR “Associate Consultant” OR “volunteer”</inlineHelpText>
        <label>Total Other Costs</label>
        <summarizedField>Associate__c.Value__c</summarizedField>
        <summaryFilterItems>
            <field>Associate__c.Associate_Type__c</field>
            <operation>notEqual</operation>
