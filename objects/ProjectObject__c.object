        <summarizedField>RevenueAttribution__c.Attribution_Days__c</summarizedField>
        <summaryFilterItems>
            <field>RevenueAttribution__c.Scoped__c</field>
            <operation>equals</operation>
            <value>Non-scoped</value>
        </summaryFilterItems>
        <summaryForeignKey>RevenueAttribution__c.Project__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
