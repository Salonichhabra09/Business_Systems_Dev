    <validationRules>
        <fullName>Agreed_Deli_target_is_grt_than_delivered</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISCHANGED(Agreed_Delivery_Target__c), ISCHANGED(Delivered__c)), Agreed_Delivery_Target__c &lt; Delivered__c , AND(ISBLANK( Reason_for_Delivery_Target_Variance__c ),NOT(ISCHANGED(Reason_for_Delivery_Target_Variance__c))) )</errorConditionFormula>
        <errorDisplayField>Reason_for_Delivery_Target_Variance__c</errorDisplayField>
        <errorMessage>Reason for Delivery Target Variance is mandatory if Delivered is later than Agreed Delivery Target.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AllowOrderLineNotLinkedToAnyProject</fullName>
        <active>false</active>
        <description>Allow the user to choose order line which is not already linked to a project.</description>
        <errorConditionFormula>AND( ISCHANGED( Order_Line_Number__c ) ,NOT(ISBLANK(Order_Line_Number__r.Project__c )))</errorConditionFormula>
        <errorDisplayField>Order_Line_Number__c</errorDisplayField>
        <errorMessage>Selected order line is already linked to a project. Please find another one.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Audit_Doc_required_for_ClosedDelivered</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($User.Id=&apos;0054G00000CSIBq&apos;),ISPICKVAL( Project_Status__c , &quot;Closed/Delivered&quot;),ISBLANK( Audit_Document__c ))</errorConditionFormula>
        <errorDisplayField>Audit_Document__c</errorDisplayField>
        <errorMessage>Please complete the Audit Document field for Closed/Delivered projects</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Audit_Failure_Reason</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL(Audit_Pass_Fail__c ,&quot;Fail&quot;), ISBLANK( Audit_Comments__c ))</errorConditionFormula>
        <errorDisplayField>Audit_Comments__c</errorDisplayField>
        <errorMessage>Audit comments are needed if the Audit has failed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Commercial_Operations_Exclusive</fullName>
        <active>false</active>
        <description>This validation rules ensures that the Functional Area &apos;Commercial Operations&apos; is only selected exclusively.</description>
        <errorConditionFormula>AND
(
INCLUDES( Functional_Area__c, &apos;Commercial Operations&apos;),
OR
(
INCLUDES( Functional_Area__c, &apos;Pre-sales&apos;),
INCLUDES( Functional_Area__c, &apos;Consulting &amp; Training&apos;),
INCLUDES( Functional_Area__c, &apos;Internal Organization&apos;),
INCLUDES( Functional_Area__c, &apos;Sales&apos;)
)
)</errorConditionFormula>
        <errorMessage>This Functional Area combination is not allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Discount_Approval_Validation</fullName>
        <active>true</active>
        <description>This validation ensures that the user specifies the Discount Approver in case any discounts are allowed.</description>
        <errorConditionFormula>AND(OR(NOT(ISNULL( Discount_Product__c )), NOT(ISNULL( Discount_PS__c)), NOT(ISNULL( Discount_SPS__c)), NOT(ISNULL( Discount_TS__c ))), IF(Discount_Approved_By__c = &apos;&apos;, true, false))</errorConditionFormula>
        <errorDisplayField>Discount_Approved_By__c</errorDisplayField>
        <errorMessage>Discounts can only be applied if the approver of such discounts is specified. Please specify the approver of this discount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Handover_Rejected_then_Reasons_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISPICKVAL(Handover_from_SD_C__c,&apos;&apos;)),ISPICKVAL( Handover_from_SD_C__c,&apos;Rejected&apos;) , ISBLANK(Reason_CPS__c) , ISCHANGED(Handover_from_SD_C__c))</errorConditionFormula>
        <errorDisplayField>Reason_CPS__c</errorDisplayField>
        <errorMessage>Please provide Reasons as Handover from SD&amp;C is selected as &quot;Rejected&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Internal_Organisation_Exclusive</fullName>
        <active>false</active>
        <description>This validation rules ensures that the Functional Area &apos;Sales&apos; is only selected exclusively.</description>
        <errorConditionFormula>AND 
( 
INCLUDES( Functional_Area__c, &apos;Internal Organisation&apos;), 
OR 
( 
INCLUDES( Functional_Area__c, &apos;Pre-sales&apos;), 
INCLUDES( Functional_Area__c, &apos;Consulting &amp; Training&apos;), 
INCLUDES( Functional_Area__c, &apos;Sales&apos;),
INCLUDES( Functional_Area__c, &apos;Commercial Operations&apos;)
) 
)</errorConditionFormula>
        <errorMessage>This Functional Area combination is not allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>KPI_Reasons_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( $User.Id = &apos;0054G00000CSIBq&apos; ),ISBLANK( Reasons_for_Variances_impacting_KPI_s__c) &amp;&amp;
ISPICKVAL( Project_Status__c, &quot;Closed/Delivered&quot;) &amp;&amp;
Scope_versus_actual_hours__c &gt;1)</errorConditionFormula>
        <errorDisplayField>Reasons_for_Variances_impacting_KPI_s__c</errorDisplayField>
        <errorMessage>The actual delivered time for this project is over scope. Please add a reason to the field “Reasons for Variances effecting KPI’s</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Name_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
RecordType.DeveloperName = &apos;CPS_Project&apos;,
ISBLANK( CPS_Project_Manager_New__c ),
 ISBLANK( Technology_Lead_New__c),ISBLANK( I_O_Lead_New__c),
 ISBLANK( Localisation_Lead_New__c)
,NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;))
 )</errorConditionFormula>
        <errorMessage>Must be a name in one of these (CPS Project Manager, I/O Lead, Tech Lead or Localisation Lead)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnlyPMcanChangePMandPC</fullName>
        <active>false</active>
        <description>Only PM can change PM and PC values on the Project.</description>
        <errorConditionFormula>AND(
OR(ISCHANGED(Project_Co_ordinator__c), ISCHANGED(Project_Manager__c)),
AND($User.Id!= PRIORVALUE(Project_Manager__c),$User.Id!= PRIORVALUE(Project_Co_ordinator__c),NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)))
)</errorConditionFormula>
        <errorDisplayField>A_O_Lead__c</errorDisplayField>
        <errorMessage>Only Project Manager or Project co-ordinator can change Project Manager and Project co-ordinator  values on the Project.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OrderNumber_Same_As_OrderOnOpportunity</fullName>
        <active>false</active>
        <description>The Order Number on Project should be same as Order Number on Opportunity.</description>
        <errorConditionFormula>AND(NOT( ISBLANK(Order_Header_Number__c) ), ISCHANGED(Order_Header_Number__c) ,Opportunity__r.Order_Number__c &lt;&gt; Order_Header_Number__c)</errorConditionFormula>
        <errorDisplayField>Order_Header_Number__c</errorDisplayField>
        <errorMessage>The Order Header Number should be same as the Order Number on associated Opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OrderProducts_check_Contract</fullName>
        <active>true</active>
        <errorConditionFormula>IF( AND(ISCHANGED( Order_Header_Number__c ),   Order_Products_Count__c &gt;0) ,True,False)</errorConditionFormula>
        <errorMessage>Contract cannot be changed if order products are linked to Project.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_or_PC_user_can_only_edit_Scoped_days</fullName>
        <active>false</active>
        <description>Rule to the scoped days to ensure it can only be edited by the PM or PC user.</description>
        <errorConditionFormula>IF( ISCHANGED( Scoped_CPS_days__c ) , IF(NOT(   Project_Co_ordinator__r.Id  =  $User.Id  ) &amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)) ,IF(NOT(  Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false),IF(NOT(Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),IF(NOT(Project_Co_ordinator__r.Id  =  $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false),IF(NOT(Project_Co_ordinator__r.Id  =  $User.Id) &amp;&amp; NOT(Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false))),false)</errorConditionFormula>
        <errorMessage>Only Project Manager or Project Coordinator can edit Scoped CPS days (source: PM/PC) Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PM_or_PC_user_can_only_edit_Scp_LPS_days</fullName>
        <active>false</active>
        <description>Rule to the scoped days to ensure it can only be edited by the PM or PC user.</description>
        <errorConditionFormula>IF( ISCHANGED( Scoped_LPS_days__c ) , IF(NOT(   Project_Co_ordinator__r.Id  =  $User.Id  ) &amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)) ,IF(NOT(  Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false),IF(NOT(Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),IF(NOT(Project_Co_ordinator__r.Id  =  $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false),IF(NOT(Project_Co_ordinator__r.Id  =  $User.Id) &amp;&amp; NOT(Project_Manager__r.Id = $User.Id)&amp;&amp;  NOT( CONTAINS( $Profile.Name, &quot;Administrator&quot;)),true,false))),false)</errorConditionFormula>
        <errorMessage>Only Project Manager or Project Coordinator can edit Scoped LPS days (source: PM/PC) Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProjectHealthStatusCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISCHANGED( Project_Health_Detail__c),NOT( ISCHANGED( Project_Description__c )),OR( ISPICKVAL(Project_Health_Detail__c, &apos;Red&apos;),ISPICKVAL(Project_Health_Detail__c, &apos;Amber&apos;) ) )</errorConditionFormula>
        <errorMessage>Project health status cannot be updated without updating the project description. Please update the description and try again.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Project_Edit_Restriction</fullName>
        <active>false</active>
        <errorConditionFormula>IF(((Project_Manager__c = $User.Id )&amp;&amp;(ISPICKVAL($User.PSA_Role__c , &apos;Project Manager&apos;)))
		||(ISPICKVAL( $User.PSA_Role__c , &apos;PSA Lead&apos;))
		||(RecordType.DeveloperName = &apos;CPS_Project&apos;)
                ||(ISNULL(Id) &amp;&amp; ISNEW())
		,false,true)</errorConditionFormula>
        <errorMessage>Only Project Manager or PSA Lead can edit a Project</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Quality_Issue_Reason</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL( Quality_Issue__c ,&quot;Yes&quot;), ISBLANK( Quality_Issue_comments__c ))</errorConditionFormula>
        <errorDisplayField>Quality_Issue_comments__c</errorDisplayField>
        <errorMessage>Quality comments are needed if the there is a quality issue</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RAG_Reason_required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL( RAG__c  , &quot;Amber&quot;),ISPICKVAL( RAG__c  , &quot;Red&quot;)),ISBLANK(RAG_Reason__c ))</errorConditionFormula>
        <errorDisplayField>RAG_Reason__c</errorDisplayField>
        <errorMessage>Reason needs to be entered if RAG is Amber or Red</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_Mandatory_on_additional_scope_day</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(ISBLANK(Additional_Scoped_Days__c))  &amp;&amp; (ISBLANK( additional_scoped_comments__c ) ||  ISPICKVAL(Chargeable__c ,&apos;&apos;) || ISPICKVAL(Reason__c ,&apos;&apos;))</errorConditionFormula>
        <errorMessage>Please provide Reason,Comments and Chargeable values for Additional Scoped Days.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_for_no_Signed_SOW</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL( Signed_SoW__c , &apos;No&apos;),  ISBLANK( Reason_for_no_Signed_SOW__c ) )</errorConditionFormula>
        <errorDisplayField>Reason_for_no_Signed_SOW__c</errorDisplayField>
        <errorMessage>If Signed SOW = NO then there must be a reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reasons_cant_be_filled_without_additiona</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Additional_Scoped_Days__c) &amp;&amp; OR(NOT(ISPICKVAL(Chargeable__c,&apos;&apos;)), NOT(ISBLANK( additional_scoped_comments__c )),NOT(ISPICKVAL( Reason__c,&apos;&apos;)))</errorConditionFormula>
        <errorMessage>Please provide &quot;Additional scope days&quot; when filling value in Reason, Chargeable or Comments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reasons_for_changed_agreed_deliv_target</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISCHANGED(  Agreed_Delivery_Target__c ), ISBLANK( Reason_for_Delivery_Target_Variance__c ) )</errorConditionFormula>
        <errorDisplayField>Reason_for_Delivery_Target_Variance__c</errorDisplayField>
        <errorMessage>Reasons For  Delivery Target Variance is Mandatory If Agreed Delivery Target is changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Project_Deliverable</fullName>
        <active>false</active>
        <description>Deactivated by Prabhat: This Logic if Required will be handled through &quot;Add Product&quot; Functionality on Project</description>
        <errorConditionFormula>AND( Order_Products_Count__c &gt; 0 , Project_Deliverable_Count__c ==0)</errorConditionFormula>
        <errorDisplayField>Order_Line_Number__c</errorDisplayField>
        <errorMessage>Please add project deliverable before adding order line.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RestrictCancellationAndOnHoldReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				$User.ProfileId &lt;&gt; $Label.System_Administrator_Profile_Id,
					OR(
									TEXT(Project_Status__c) == $Label.Project_Status_Cancelled,
									TEXT(Project_Status__c) == $Label.Project_Status_On_Hold
							),
					ISBLANK(TEXT(Cancellation_On_Hold_Reason__c))
			)</errorConditionFormula>
        <errorDisplayField>Cancellation_On_Hold_Reason__c</errorDisplayField>
        <errorMessage>Cancellation/ On Hold Reason is required if Project Status is Cancelled or On Hold</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Exclusive</fullName>
        <active>false</active>
        <description>This validation rules ensures that the Functional Area &apos;Sales&apos; is only selected exclusively.</description>
        <errorConditionFormula>AND 
( 
INCLUDES( Functional_Area__c, &apos;Sales&apos;), 
OR 
( 
INCLUDES( Functional_Area__c, &apos;Pre-sales&apos;), 
INCLUDES( Functional_Area__c, &apos;Consulting &amp; Training&apos;), 
INCLUDES( Functional_Area__c, &apos;Internal Organization&apos;),
INCLUDES( Functional_Area__c, &apos;Commercial Operations&apos;)
) 
)</errorConditionFormula>
        <errorMessage>This Functional Area combination is not allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_ActualDelivery</fullName>
        <active>true</active>
        <description>If status is Closed/Delivered then Actual Delivery must be filled in</description>
        <errorConditionFormula>AND(ISPICKVAL(Project_Status__c  , &apos;Closed/Delivered&apos;), ISNULL(Delivered__c) )</errorConditionFormula>
        <errorDisplayField>Delivered__c</errorDisplayField>
        <errorMessage>If status is Closed/Delivered then Actual Delivery must be filled in</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SurveyInfoRequiredForCompletedProject</fullName>
        <active>true</active>
        <description>This Validation Rule restricts user to mark project as complete without providing survey information i.e recipient name and recipient email for LPS Projects.</description>
        <errorConditionFormula>AND(RecordType.Name = &apos;Project&apos;,
OR(ISCHANGED(Project_Status__c),ISNEW()),
ISPICKVAL(Project_Status__c, &apos;Closed&apos;),
OR(AND(Survey_Recipient_Email__c == &apos;&apos;,
Survey_Recipient_Name__c != &apos;&apos;),
AND(Survey_Recipient_Email__c != &apos;&apos;,
Survey_Recipient_Name__c == &apos;&apos;))
)</errorConditionFormula>
        <errorMessage>When marking a project as close, if there is a value in either the Survey Recipient Email or the Survey Recipient Name then you need to complete both fields please</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Create_CPS_Project</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Create CPS Project</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/30.0/connection.js&quot;)} 
sforce.connection.sessionId = &apos;{!$Api.Session_ID}&apos;; 
var pg = sforce.connection.query(&quot;SELECT Id,(SELECT id FROM GroupMembers WHERE UserOrGroupId=&apos;{!User.Id}&apos;) FROM Group WHERE DeveloperName IN(&apos;Central_PS_A_O&apos;,&apos;Central_PS_Associates&apos;,&apos;Central_PS_MIT&apos;,&apos;Central_PS_QA&apos;,&apos;Central_PS_Tech&apos;,&apos;Central_PS_CS&apos;,&apos;Central_PS_PM_Other&apos;)&quot;); 
var records = pg.getArray(&quot;records&quot;); 
var hasMember = false; 
for(var i=0;i&lt;records.length;i++){ 
	
	if(records[i].GroupMembers != null){
		
		if(records[i].GroupMembers.size&gt;0){
			hasMember = true;
			break;
		}	
	}
} 
if(hasMember){
	window.top.location.href=&quot;/a09/e?&amp;CF00ND0000005Fgnh={!ProjectObject__c.Name}&amp;CF00ND0000005Fgnh_lkid={!ProjectObject__c.Id}&amp;retURL=%2Fapex%2FProject_ViewPage%3Fid%3D{!ProjectObject__c.Id}%26sfdc.override%3D1&amp;nooverride=1&amp;RecordType=012D0000000VAFc&amp;ent=01I200000004s0I&quot;
}else{
	alert(&apos;You do not have access to create a Central PS project.&apos;);
}</url>
    </webLinks>
