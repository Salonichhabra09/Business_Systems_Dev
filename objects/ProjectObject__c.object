        <formula>IF(((Project_Manager__c = $User.Id )&amp;&amp;( ISPICKVAL( $User.PSA_Role__c , &apos;Project Manager&apos;) ))||( ISPICKVAL( $User.PSA_Role__c , &apos;PSA Lead&apos;))||( RecordTypeId = &apos;012D0000000VAFcIAO&apos;), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Edit Filter</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Estimated_Gross_Contribution__c</fullName>
        <description>Revenue – time cost – total expenses – total associate costs – total LBU costs – total other costs</description>
        <formula>IF( Revenue__c ==0, 0, (Revenue__c - Total_Time_Cost__c - Total_LBU_Costs__c -Total_Associate_Costs__c - Total_Other_Costs__c -  Total_Expenses__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Revenue – time cost – total expenses – total associate costs – total LBU costs – total other costs</inlineHelpText>
        <label>Gross Contribution (Amount)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Estimated_Travel_Expenses__c</fullName>
        <label>Estimated Travel Expenses</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Expenses__c</fullName>
        <inlineHelpText>Total expenses both chargeable and non chargeable</inlineHelpText>
        <label>Expenses</label>
        <summarizedField>Expense__c.Value__c</summarizedField>
        <summaryForeignKey>Expense__c.Project__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Function_Invoice__c</fullName>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(Functional_Area__c, &apos;Consulting &amp; Training&apos;), &apos;CT&apos;, 
LEFT 
( 
IF(OR(INCLUDES(Functional_Area__c, &apos;PS Consulting&apos;), INCLUDES(Functional_Area__c, &apos;PS Training&apos;)), &apos;PS;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PST – Client&apos;), &apos;PSTC;&apos;, &apos;&apos;),
LEN 
( 
IF(OR(INCLUDES(Functional_Area__c, &apos;PS Consulting&apos;), INCLUDES(Functional_Area__c, &apos;PS Training&apos;)), &apos;PS;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PST – Client&apos;), &apos;PSTC;&apos;, &apos;&apos;)
) -1 
)
)</formula>
        <label>Function (Invoice)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Function_Timesheet__c</fullName>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(Functional_Area__c, &apos;Internal&apos;), &apos;IN&apos;, 
IF(INCLUDES(Functional_Area__c, &apos;Generic PreSales/Sales&apos;),&apos;AM&apos;, 
IF(INCLUDES(Functional_Area__c, &apos;PST – Generic&apos;), &apos;PSTG&apos;, 
IF(INCLUDES(Functional_Area__c, &apos;Account PreSales/Sales&apos;), &apos;AP&apos;, 
IF(INCLUDES(Functional_Area__c, &apos;Sales&apos;), &apos;SAL&apos;, 
IF(INCLUDES(Functional_Area__c,&apos;Commercial Operations&apos;),&apos;CO&apos;,
IF(INCLUDES(Functional_Area__c, &apos;Internal Organisation&apos;), &apos;INT&apos;, 
LEFT 
( 
IF(INCLUDES(Functional_Area__c, &apos;PS Consulting&apos;), &apos;PSC;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PS Training&apos;), &apos;PST;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PST – Client&apos;), &apos;PSTC;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;Custom Solutions&apos;), &apos;CS;&apos;, &apos;&apos;)+ 
IF(INCLUDES(Functional_Area__c, &apos;Consulting &amp; Training&apos;), &apos;CT;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;Pre-sales&apos;), &apos;PSAL;&apos;, &apos;&apos;), 
LEN 
( 
IF(INCLUDES(Functional_Area__c, &apos;PS Consulting&apos;), &apos;PSC;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PS Training&apos;), &apos;PST;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;PST – Client&apos;), &apos;PSTC;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;Custom Solutions&apos;), &apos;CS;&apos;, &apos;&apos;)+ 
IF(INCLUDES(Functional_Area__c, &apos;Consulting &amp; Training&apos;), &apos;CT;&apos;, &apos;&apos;) + 
IF(INCLUDES(Functional_Area__c, &apos;Pre-sales&apos;), &apos;PSAL;&apos;, &apos;&apos;) 
)-1 
) 
) 
) 
) 
)
) 
) 
)</formula>
        <label>Function (Timesheet)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Functional_Area__c</fullName>
        <description>specifies the functional area of the Project</description>
        <label>Functional Area</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
