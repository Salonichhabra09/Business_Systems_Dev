    <fields>
        <fullName>Task_Time_Recorded__c</fullName>
        <externalId>false</externalId>
        <formula>if(
OR(ISBLANK(Task_Start_Time__c), ISBLANK(Task_End_Time__c)),Actual_Time_Taken__c,
IF(Actual_Time_Taken__c=0
, FLOOR( ( ( (UNIXTIMESTAMP(Task_End_Time__c)*1000 - UNIXTIMESTAMP(Task_Start_Time__c)*1000 - Timer_Offset__c)/1000 ))/60) + + IF(FLOOR( MOD(MOD( (( (UNIXTIMESTAMP(Task_End_Time__c)*1000 - UNIXTIMESTAMP(Task_Start_Time__c)*1000 - Timer_Offset__c)/1000 )), 3600), 60) )&lt; 30, 0, 1)
, Actual_Time_Taken__c 
) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Actual Time Taken</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
