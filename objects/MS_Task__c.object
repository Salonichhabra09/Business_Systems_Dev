    <fields>
        <fullName>Legacy_Task_Id__c</fullName>
        <description>This field retains the SFDC record id of the Legacy Task (standard) on New MS Task Record</description>
        <externalId>false</externalId>
        <label>Legacy Task Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Original_Time_Taken__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
				OR(ISBLANK(Task_Start_Time__c), ISBLANK(Task_End_Time__c)),
				&apos;0 minute&apos;,
    TEXT( FLOOR( ( (  (UNIXTIMESTAMP(Task_End_Time__c)*1000 - UNIXTIMESTAMP(Task_Start_Time__c)*1000 - Timer_Offset__c)/1000 ))/3600) ) &amp; &apos; hour &apos; &amp;
				TEXT(	FLOOR(MOD((( (UNIXTIMESTAMP(Task_End_Time__c)*1000 - UNIXTIMESTAMP(Task_Start_Time__c)*1000 - Timer_Offset__c)/1000 )), 3600)/60 ) + IF(FLOOR( MOD(MOD( (( (UNIXTIMESTAMP(Task_End_Time__c)*1000 - UNIXTIMESTAMP(Task_Start_Time__c)*1000 - Timer_Offset__c)/1000 )), 3600), 60) )&lt; 30, 0, 1) ) &amp; &apos; minutes &apos;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Calculated Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Scheduled_Time__c</fullName>
        <description>This field holds the value of Time of the day at which particular task is scheduled to be picked up.</description>
        <label>Scheduled Time</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Time</type>
    </fields>
