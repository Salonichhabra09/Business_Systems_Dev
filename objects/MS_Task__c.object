    <fields>
        <fullName>Is_Logged_In_User_Task_Owner__c</fullName>
        <description>If logged in user is task owner return &apos;true&apos; otherwise &apos;false&apos;</description>
        <externalId>false</externalId>
        <formula>IF(Owner:User.Id = $User.Id, 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Logged In User Task Owner</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
