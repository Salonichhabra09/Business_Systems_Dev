    <fields>
        <fullName>Timer_Offset__c</fullName>
        <description>Backend use only. It stores the interval time of play/pause of timer.</description>
        <externalId>false</externalId>
        <label>Timer Offset (System Used Only)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Timer_Resumed_At__c</fullName>
        <description>Backend use only. It stores the timestamp at which the timer is resumed for task.</description>
        <label>Timer Resumed At</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Timer_Stopped_At__c</fullName>
        <description>Backend use only. It stores the timestamp at which the timer is stopped for task.</description>
        <label>Timer Stopped At</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>UnScheduled__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This is only used to retain the legacy data of Task for data migration, not used anywhere in new MS logic</description>
        <label>Unscheduled</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
