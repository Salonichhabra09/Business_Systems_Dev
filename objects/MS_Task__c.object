    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Actual_Time_On_Completed_Status</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Task_Status__c, &quot;Completed&quot;),
ISBLANK(Actual_Time_Taken__c),ISNEW(),RecordType.DeveloperName = &quot;General_MS_Task&quot;)</errorConditionFormula>
        <errorMessage>Actual Time Taken should not be blank if Task Staus is &apos;Completed&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_IT_Ticket_Number_Editing</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL(Task_Type__c, &quot;IT Issues&quot;),
ISPICKVAL(Task_Type__c, &quot;Floor Support/Live QA&quot;)),
ISBLANK(IT_Ticket_Number__c))</errorConditionFormula>
        <errorMessage>IT Ticket Number should not be blank if Task Type value is &apos;IT Issues&apos;  or &apos;Floor Support/Live QA&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_In_progress_MS_Task_Creation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Task_Status__c, &quot;In Progress&quot;),
ISNEW(),RecordType.DeveloperName = &quot;General_MS_Task&quot;)</errorConditionFormula>
        <errorMessage>You cannot create MS Task with &apos;In Progress&apos; Task Status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Past_Task_Date</fullName>
        <active>true</active>
        <errorConditionFormula>AND( OR(ISNEW(), ISCHANGED(Task_Date__c)), Task_Date__c &lt; TODAY(),RecordType.DeveloperName &lt;&gt; &quot;General_MS_Task&quot;, NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)))</errorConditionFormula>
        <errorMessage>You cannot schedule a task in the past, please select current or future date</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
