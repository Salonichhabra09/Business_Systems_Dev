    <fields>
        <fullName>Submitted_From__c</fullName>
        <description>Only Applicable for Japan Web cases to determine the submission from which webiste so that cna be routed to correct teams. If from Main website then goes to NVM routing else will be managed within Salesforce via Japan Mailbox.</description>
        <inlineHelpText>To determine the web case submitted from which web page Main or Japan.</inlineHelpText>
        <label>Submitted From?</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Main website</fullName>
                    <default>false</default>
                    <label>Main website</label>
                </value>
                <value>
                    <fullName>Japan website</fullName>
                    <default>false</default>
                    <label>Japan website</label>
                </value>
            </valueSetDefinition>
        </valueSet>
