        <linkType>url</linkType>
        <masterLabel>Create Case</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/500/e?CF00ND00000068vsc={!Talent_Central__c.Name}&amp; CF00ND00000068vsc_lkid={!Talent_Central__c.Id}&amp;cas4={!Talent_Central__c.Account__c}&amp; cas4_lkid={! Talent_Central__c.AccountId__c}&amp; 
cas3={! Talent_Central__c.Transition_Contact__c}&amp;cas3_lkid={! Talent_Central__c.Transition_ContactId__c}</url>
    </webLinks>
