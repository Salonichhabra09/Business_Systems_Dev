<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Field value setting to avoid the hard coding of values in Apex triggers or Classes.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Data_Type__c</fullName>
        <externalId>false</externalId>
        <label>Data Type</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Milestone_Email__c</fullName>
        <description>This field has the distribution list email &apos;AMSmilestones@shl.com&apos;</description>
        <label>Milestone Email</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Object_Name__c</fullName>
        <externalId>false</externalId>
        <label>Object Name</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Skip_email_to_AMSmilestone__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If ticked, an email is sent to distribution list AMSmilestones@cebglobal.com</description>
        <label>Skip email to AMSmilestone</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Value__c</fullName>
        <label>Value</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <label>Field Value Setting</label>
    <visibility>Public</visibility>
</CustomObject>
