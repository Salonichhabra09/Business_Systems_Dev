    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Field_Required_for_Car_Expense</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Expense_Type__c, &quot;Car Travel - 651200 / 751200&quot;),
OR(IF( Car_Travel_From__c=&quot;&quot;,TRUE,FALSE ),IF( Car_Travel_To__c=&quot;&quot;,TRUE,FALSE ),ISPICKVAL( Car_Type__c ,&quot;&quot;),ISNULL( Distance_Travelled__c ),ISPICKVAL( Measurement__c ,&quot;&quot;),ISNULL( Mileage_Rate__c )))</errorConditionFormula>
        <errorMessage>Please complete all fields in the Car Information section for an Expense Type of &apos;Car Travel&apos;.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Expense_for_Lex</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New Expense</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/cmp/c__NewExpense?c__id={!ProjectObject__c.Id},Resource__c={!User.Id},CurrencyIsoCode={!ProjectObject__c.CurrencyIsoCode}&amp;
backgroundContext=/lightning/r/ProjectObject__c/{!ProjectObject__c.Id}/view</url>
    </webLinks>
