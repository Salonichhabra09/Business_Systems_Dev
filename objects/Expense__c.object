    <fields>
        <fullName>Total_in_Home_currency__c</fullName>
        <description>Changed to Number type otherwise reporting as same currency as value.</description>
        <externalId>false</externalId>
        <formula>IF(Exchange_rate__c&gt;0, Value__c * Exchange_rate__c, Value__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the value of the expense in the owner&apos;s home currency (Value x Exchange Rate).</inlineHelpText>
        <label>Total in Home currency</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User_s_Company_BU__c</fullName>
        <externalId>false</externalId>
        <formula>CASE($User.Company_BU__c,
&quot;Abu Dhabi - AD1&quot;,&quot;Abu Dhabi - AD1&quot;,
&quot;AP Region - P10&quot;, &quot;AP Region - P10&quot;,
 &quot;Australia - AU1&quot;,&quot;Australia - AU1&quot;,
&quot;Belgium - BE1&quot;,&quot;Belgium - BE1&quot;,
&quot;Belgium SPS - BE5&quot;,&quot;Belgium SPS - BE5&quot;,
&quot;Canada - CA1&quot;,&quot;Canada - CA1&quot;,
&quot;Denmark - DK1&quot;,&quot;Denmark - DK1&quot;,
&quot;Denmark SPS - DK5&quot;,&quot;Denmark SPS - DK5&quot;,
&quot;EU Region - E50&quot;,&quot;EU Region - E50&quot;,
&quot;Finland - FI1&quot;,&quot;Finland - FI1&quot;,
&quot;France - FR1&quot;,&quot;France - FR1&quot;,
&quot;France SPS - FR5&quot;,&quot;France SPS - FR5&quot;,
&quot;Germany - DE1&quot;,&quot;Germany - DE1&quot;,
&quot;Germany SPS - DE5&quot;,&quot;Germany SPS - DE5&quot;,
&quot;Hong Kong - HK1&quot;,&quot;Hong Kong - HK1&quot;,
&quot;India - IN1&quot;,&quot;India - IN1&quot;,&quot;Ireland - IE1&quot;,
&quot;Ireland - IE1&quot;,&quot;Italy - IT1&quot;,&quot;Italy - IT1&quot;,
&quot;Netherlands - NL1&quot;,&quot;Netherlands - NL1&quot;,
&quot;Netherlands SPS - NL5&quot;,&quot;Netherlands SPS - NL5&quot;,
&quot;New Zealand - NZ1&quot;,&quot;New Zealand - NZ1&quot;,
&quot;Norway - NO1&quot;,&quot;Norway - NO1&quot;,
&quot;Poland - PL1&quot;,&quot;Poland - PL1&quot;,
&quot;Saudi Arabia - SA5&quot;,&quot;Saudi Arabia - SA5&quot;,
&quot;Singapore - SG1&quot;,&quot;Singapore - SG1&quot;,
&quot;South Africa - ZA1&quot;,&quot;South Africa - ZA1&quot;,
&quot;Spain - ES1&quot;,&quot;Spain - ES1&quot;,
&quot;Sweden - SE1&quot;,&quot;Sweden - SE1&quot;,
&quot;Sweden SPS - SE5&quot;,&quot;Sweden SPS - SE5&quot;,
&quot;Switzerland - CH1&quot;,&quot;Switzerland - CH1&quot;,
&quot;UK SCS - UK5&quot;,&quot;UK SCS - UK5&quot;,
&quot;UK - UK1&quot;,&quot;UK - UK1&quot;,
&quot;US - US1&quot;,&quot;US - US1&quot;,
&quot;none&quot;)</formula>
        <label>User&apos;s Company BU</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
