        <label>VAT Applicable</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>VAT_Rate__c</fullName>
        <description>Specify the VAT rate for the expense</description>
        <inlineHelpText>This field should contain all VAT or other Sales Taxes. Only enter these values if they are shown on your receipt</inlineHelpText>
        <label>VAT Rate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Value__c</fullName>
        <inlineHelpText>Please enter the currency and value of the cost incurred.</inlineHelpText>
        <label>Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Expense</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Project__c</columns>
        <columns>Value__c</columns>
        <columns>Resource__c</columns>
        <columns>Date_Incurred__c</columns>
