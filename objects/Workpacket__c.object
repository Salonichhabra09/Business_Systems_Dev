    <label>Workpacket</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Status__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <displayFormat>WP-{00000000}</displayFormat>
        <label>Workpacket Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Workpackets</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Description__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Solution_Type__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Agreed_Delivery__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Client_Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>LBU__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>CPS_Project_Number__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Description__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Solution_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Agreed_Delivery__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Client_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LBU__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CPS_Project_Number__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>ActualDeliveryIsMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISNEW(),AND( ISPICKVAL( Status__c ,&apos;Closed/Delivered&apos;) ,ISBLANK( Actual_Delivery__c )),AND(ISCHANGED( Status__c),ISPICKVAL( Status__c ,&apos;Closed/Delivered&apos;),ISBLANK(Actual_Delivery__c )))</errorConditionFormula>
        <errorMessage>If status is Closed/Delivered then Actual Delivery must be filled in</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ActualdeliveryIsgreaterthanAgreeddeliver</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISNEW(),
   AND
   ( Agreed_Delivery__c  &lt;  Actual_Delivery__c  ,
     ISBLANK(  Delivery_Variance_Comment__c  )
	), 
      AND(
	      OR(
		      ISCHANGED(Agreed_Delivery__c),ISCHANGED(Actual_Delivery__c )
			  ),
			  ( Agreed_Delivery__c  &lt;  Actual_Delivery__c ),
			  ISBLANK( Delivery_Variance_Comment__c )
		)
	)</errorConditionFormula>
        <errorMessage>If actual delivery date is greater than agreed delivery date then “Delivery Variance Comments” is compulsory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Handover_to_QA_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(  Handover_to_QA_Date__c )),  ISBLANK(  Handover_to_QA_Name__c))</errorConditionFormula>
        <errorDisplayField>Handover_to_QA_Name__c</errorDisplayField>
        <errorMessage>Please provide the name of the person who the QA handover has come from</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>HandoversAndQAareMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
		ISPICKVAL( Status__c ,&apos;Closed/Delivered&apos;) ,
		OR(
			ISPICKVAL( Solution_Type__c ,&apos;Custom Report Type 1&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;Custom Report Type 2&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;Custom Report Type 3&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;Custom Report Bespoke&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;SJT Multimedia&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;SJT Text Type 1&apos;),
			ISPICKVAL( Solution_Type__c ,&apos;SJT Text Type 2&apos;),
ISPICKVAL( Solution_Type__c ,&apos;S2P Instrument&apos;),
ISPICKVAL( Solution_Type__c ,&apos;S2P Integration (stub)&apos;)
		),	
			OR(
				ISBLANK( Handover_to_QA_Date__c ),
				ISBLANK( Handover_to_QA_Name__c ),
				ISBLANK( QA_Final_Test_Date__c ),
				ISBLANK( QA_Final_Test_Name__c)
			)
				
	)</errorConditionFormula>
        <errorMessage>Please complete the QA fields for this workpacket</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Name_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISBLANK( CPS_Project_Manager_New__c ),
ISBLANK( Technology_Lead_New__c),ISBLANK( I_O_Lead_New__c),
ISBLANK( Localisation_Lead_New__c)
,NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;))
)</errorConditionFormula>
        <errorMessage>Must be a name in one of these (CPS Project Manager, CS Lead, Tech Lead, A&amp;O Lead, MIT Lead)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>QA_Final_Test_Name_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(   QA_Final_Test_Date__c )),  ISBLANK(   QA_Final_Test_Name__c ))</errorConditionFormula>
        <errorDisplayField>QA_Final_Test_Name__c</errorDisplayField>
        <errorMessage>Please provide the name of the person who completed the final testing</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReasonsForReasonsForChangedtMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISCHANGED( Agreed_Delivery__c ),  ISBLANK( Reasons_For_Changed_Delivery_Date__c) )</errorConditionFormula>
        <errorMessage>Reasons For Changed Delivery Date is Mandatory If Agreed Delivery Date is changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Workpacket_Status_Move</fullName>
        <active>true</active>
        <errorConditionFormula>AND(  NOT($Permission.CPS_Workpacket_closed_delivered_edit_rights), 
AND( 
ISPICKVAL(PRIORVALUE(Status__c),&quot;closed/delivered&quot;), 
OR( 
ISPICKVAL( Status__c,&quot;Planning&quot;), 
ISPICKVAL( Status__c,&quot;Executing&quot;), 
ISPICKVAL( Status__c,&quot;Closing&quot;), 
ISPICKVAL( Status__c,&quot;Closed/Cancelled&quot;), 
ISPICKVAL( Status__c,&quot;On Hold&quot;), 
ISPICKVAL( Status__c,&quot;closed/delivered&quot;) 
)	
) 
)</errorConditionFormula>
        <errorMessage>You do not have permissions to edit Closed/Delivered Workpackets.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Update_Workpackets</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Update Workpackets</masterLabel>
        <openType>sidebar</openType>
        <page>BulkEditWorkpacketProjectVF</page>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
    </webLinks>
</CustomObject>
