    <fields>
        <fullName>Is_Ready_for_Transfer__c</fullName>
        <formula>AND(OR(AND( NOT(ISBLANK(Mailing_Address_Line_1__c)) ,NOT(ISBLANK( Mailing_City__c)),NOT(ISPICKVAL(Global_Mailing_Country__c , &apos;&apos;)),NOT(ISBLANK( Mailing_ZIP_Postal_Code__c))), Same_As_The_Account_Billing_Address__c = True ), Email &lt;&gt; Null, AccountId &lt;&gt; Null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Ready for Transfer(System Use Only)</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
