    <fields>
        <fullName>High_Risk_Country__c</fullName>
        <description>High Risk Countries</description>
        <formula>AND(
NOT(ISBLANK(TEXT(Global_Mailing_Country__c))),		
CONTAINS(&quot;ARGENTINA:AUSTRIA:BULGARIA:CYPRUS:CZECH REPUBLIC:DENMARK:GREECE:ITALY:LIECHTENSTEIN:LITHUANIA:MALTA AND GOZO:ROMANIA:SPAIN:CHINA:ISRAEL&quot;,TEXT(Global_Mailing_Country__c))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>High Risk Country</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
