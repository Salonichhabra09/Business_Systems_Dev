    <fields>
        <fullName>Phoenix_Amber_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Account.BU__c,&apos;South Africa - ZA1&apos;),                               IF(AND(ISBLANK(OPQ_training_date__c),OR(NOT(ISBLANK(Test_admin_training_date__c)),NOT(ISBLANK(Ability_tests_training_date__c)))),&apos;May not Receive Profile Reports&apos; &amp; BR() &amp; &apos;May Administer Assessments&apos;,&apos;&apos;) ,
IF(AND(
OR(ISPICKVAL(Account.BU__c,&apos;UK - UK1&apos;),  ISPICKVAL(Account.BU__c,&apos;US - US1&apos;),  ISPICKVAL(Account.BU__c,&apos;Canada - CA1&apos;)),
NOT(INCLUDES(Qualifications__c,&apos;OPQ&apos;))),
&apos;Check Qualification&apos;,&apos;&apos;))</formula>
        <label>Phoenix Amber Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Green_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Account.BU__c,&apos;South Africa - ZA1&apos;),                               
IF(NOT(ISBLANK(OPQ_training_date__c)),&apos;May Receive Profile Reports&apos; &amp; BR() &amp; &apos;May Administer Assessments&apos;,&apos;&apos;),
IF(AND(
OR(ISPICKVAL(Account.BU__c,&apos;UK - UK1&apos;),  ISPICKVAL(Account.BU__c,&apos;US - US1&apos;),  ISPICKVAL(Account.BU__c,&apos;Canada - CA1&apos;)),
INCLUDES(Qualifications__c,&apos;OPQ&apos;)),
&apos;Qualification Is OPQ&apos;,&apos;Contact OK&apos;))</formula>
        <label>Phoenix Green Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Indicator__c</fullName>
        <externalId>false</externalId>
        <formula>IMAGE( CASE(Phoenix_Status__c, 
&quot;Red&quot;, &quot;/img/samples/light_red.gif&quot;,
&quot;Amber&quot;, &quot;/img/samples/light_yellow.gif&quot;,
&quot;/img/samples/light_green.gif&quot;), &apos;Phoenix Status&apos;)</formula>
        <inlineHelpText>For GCSC use only.</inlineHelpText>
        <label>Trading Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Phoenix_Red_Message__c),IF(ISBLANK(Phoenix_Amber_Message__c), Phoenix_Green_Message__c,Phoenix_Amber_Message__c),Phoenix_Red_Message__c)</formula>
        <inlineHelpText>For GCSC use only.</inlineHelpText>
        <label>Trading Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Red_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(ISPICKVAL(Account.BU__c,&apos;South Africa - ZA1&apos;),ISBLANK(Test_admin_training_date__c),ISBLANK(Ability_tests_training_date__c),ISBLANK(OPQ_training_date__c)),
&apos;May NOT Receive Profile Reports&apos; &amp; BR() &amp; &apos;May Not Administer Assessments&apos;,&apos;&apos;)</formula>
        <label>Phoenix Red Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Phoenix_Red_Message__c),IF(ISBLANK(Phoenix_Amber_Message__c), &apos;Green&apos;,&apos;Amber&apos;),&apos;Red&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Phoenix Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
