        <fullName>NonHotCountryCheck__c</fullName>
        <description>Medium Risk Country and Rest of EU</description>
        <formula>AND(
NOT(ISBLANK(TEXT(Global_Mailing_Country__c))),
CONTAINS(&quot;AUSTRALIA:BELGIUM:CANADA:LUXEMBOURG:NETHERLANDS:NORWAY:POLAND:PORTUGAL:SLOVENIA:SWITZERLAND:SLOVAKIA (Slovak Republic):JAPAN:NEW ZEALAND:CROATIA:ESTONIA:FINLAND:FRANCE:HUNGARY:IRELAND:LATVIA:SWEDEN:UK:SOUTH AFRICA&quot;,TEXT(Global_Mailing_Country__c))
)</formula>
        <label>Medium Risk Country</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
