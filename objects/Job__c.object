        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/o/Job__c/new?
recordTypeId=012D0000000VAaUIAW
&amp;defaultFieldValues=
Parent_Job__c={!Job__c.Id},
MS_Line_of_Business__c={!Job__c.MS_Line_of_Business__c},
Project_Manager__c={!Job__c.Project_ManagerId__c},
JobStatus__c=Booked,
Opportunity__c={!Job__c.OpportunityId__c},
Job_Region__c={!Job__c.Job_Region__c},
Client_Domain__c={!Job__c.Client_Domain__c},
Sender_Email__c={!Job__c.Sender_Email__c},
Start_Date__c={!TEXT(TODAY())},
End_Date__c={!TEXT(Job__c.Contract_End_Date__c)},
Ext_Template_Folder__c={!Job__c.Ext_Template_Folder__c},
Generic_Date_Field_MS_One__c={!TEXT(Job__c.Generic_Date_Field_MS_One__c)}
&amp;backgroundContext=%2Flightning%2Fr%2FJob__c%2F{!Job__c.Id}%2Fview</url>
