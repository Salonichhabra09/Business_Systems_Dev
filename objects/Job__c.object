    <fields>
        <fullName>External_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is meant for looking up a contact that belongs to the selected Account.</description>
        <inlineHelpText>Select an existing Salesforce Contact that belongs to the selected Account. If the contact does not exist on Salesforce, then enter the Contact name in the External Contact (Others) field below as it is mandatory to enter the External Contact.</inlineHelpText>
        <label>External Contact</label>
        <lookupFilter>
            <active>false</active>
            <errorMessage>The External Contact must belong to the Selected Account</errorMessage>
            <filterItems>
                <field>Contact.AccountId</field>
                <operation>equals</operation>
                <valueField>$Source.Account__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Jobs (External Contact)</relationshipLabel>
        <relationshipName>Jobs</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
