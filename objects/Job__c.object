    <label>Job</label>
    <listViews>
        <fullName>AllOPENJobs</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Contract__c</columns>
        <columns>InvoiceMonthly__c</columns>
        <columns>MS_Line_of_Business__c</columns>
        <columns>Opportunity__c</columns>
        <columns>Project_Manager__c</columns>
        <columns>Project_Name__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>JobStatus__c</field>
            <operation>equals</operation>
            <value>UnConfirmed,Confirmed,Scoping,Booked,Pre Launch,Launch,Post Launch</value>
        </filters>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>THIS_MONTH</value>
        </filters>
        <label>All OPEN Jobs</label>
    </listViews>
    <listViews>
        <fullName>All_Bureau_Jobs</fullName>
        <columns>NAME</columns>
        <columns>SubmittedOn__c</columns>
        <columns>ClaimedOn__c</columns>
        <columns>ProcessedOn__c</columns>
        <columns>JobOutsideSLA__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Job__c.Bureau_Service</value>
        </filters>
        <label>All Managed Services Jobs</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>All_Managed_Service_Commenced_Jobs</fullName>
        <columns>NAME</columns>
        <columns>MS_Line_of_Business__c</columns>
        <columns>JobStatus__c</columns>
        <columns>System_Used__c</columns>
        <columns>JobOutsideSLA__c</columns>
        <columns>Contract_Start_Date__c</columns>
        <columns>Contract_End_Date__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Actual_Count_of_Candidates_PassFail__c</columns>
        <columns>Candidate_Max_Sequence_No_New__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <columns>WRFs_Submitted__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Job__c.Managed_Service_Commenced</value>
        </filters>
        <label>All Managed Service Commenced Jobs</label>
    </listViews>
    <listViews>
        <fullName>All_Managed_Service_Pipeline_Jobs</fullName>
        <columns>NAME</columns>
        <columns>Project_Manager__c</columns>
        <columns>JobStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>JobOutsideSLA__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Job__c.Managed_Service_Pipeline</value>
        </filters>
        <label>All Managed Service Pipeline Jobs</label>
    </listViews>
    <listViews>
        <fullName>Convayr</fullName>
        <columns>NAME</columns>
        <columns>Candidate_Transfer_Status__c</columns>
        <columns>Job_Transfer_Status__c</columns>
        <columns>OWNER.FIRST_NAME</columns>
        <columns>Account__c</columns>
        <columns>Candidate_Max_Sequence_No_New__c</columns>
        <columns>Transferred_Candidate_Count__c</columns>
        <columns>Not_Transferred_Candidate_Count__c</columns>
        <columns>WRFs_Submitted__c</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterOrEqual</operation>
            <value>LAST_YEAR</value>
        </filters>
        <label>Convayr</label>
    </listViews>
    <listViews>
        <fullName>CurrentYearJobs</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Internal_Contact__c</columns>
        <columns>Contact__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>RECORDTYPE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2014 12:00 AM</value>
        </filters>
        <label>Current Year Jobs</label>
