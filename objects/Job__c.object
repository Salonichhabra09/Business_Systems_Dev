        <fullName>Opportunity_MS_Value__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Parent_Job__c =&apos;&apos;,
Opportunity_Currency__c &amp; &quot; &quot; &amp; TEXT( ROUND(Opportunity__r.MS_Value_Formula__c,2)), 
IF( Opportunity__c = Parent_Job__r.Opportunity__c ,Opportunity_Currency__c &amp; &quot; &quot; &amp; TEXT(0.00) ,
Opportunity_Currency__c &amp; &quot; &quot; &amp; TEXT( ROUND(Opportunity__r.MS_Value_Formula__c,2)) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
