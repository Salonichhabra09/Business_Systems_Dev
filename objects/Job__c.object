    <fields>
        <fullName>Total_Number_of_Candidates__c</fullName>
        <description>It is used to capture total number of ratings created for a job</description>
        <externalId>false</externalId>
        <formula>CASE($RecordType.DeveloperName, 
&quot;General_Job&quot;,Number_of_Candidates__c, 
&quot;Project_Job&quot;,Number_of_Participants_New__c + Number_of_Respondents_New__c,
&quot;Bureau_Service&quot;,Number_of_Participants_New__c + Number_of_Respondents_New__c,
&quot;Managed_Service_Commenced&quot;,Number_of_Participants_New__c + Number_of_Respondents_New__c, 
&quot;OLBRecordType&quot;,NoOfCandidates__c,0 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Number of Candidates(Total Rating)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Participants__c</fullName>
        <externalId>false</externalId>
        <label>Total Participants</label>
        <precision>10</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Ratings__c</fullName>
        <externalId>false</externalId>
        <formula>Ratings_Not_Started_New__c +  Ratings_In_Progress_New__c +  Ratings_Completed_New__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Ratings</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Time_Spent_All_Jobs__c</fullName>
        <description>Sum of &quot;Total Case Estimated Time&quot; and &quot;Total Time Spent: Task(In Minutes)&quot;  fields on Job</description>
        <externalId>false</externalId>
        <inlineHelpText>Sum of total time spent on parent/child jobs and cases</inlineHelpText>
