    <fields>
        <fullName>Account_BU__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(TEXT(Account__r.BU__c),&apos;Belgium SPS - BE5&apos;,&apos;Belgium - BE5&apos;, &apos;France SPS - FR5&apos;, &apos;France - FR5&apos;,&apos;Netherlands SPS - NL5&apos;,&apos;Netherlands - NL5&apos;,&apos;US - US1&apos;, &apos;US - US5&apos;, TEXT(Account__r.BU__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
