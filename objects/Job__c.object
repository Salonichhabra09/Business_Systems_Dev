    <fields>
        <fullName>Survey_Language__c</fullName>
        <description>Formula field to capture Survey Language based on Preferred Language for Qualtrics Surve</description>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL( Preferred_Language__c , &apos;Dutch&apos;) , &apos;NL&apos;,
IF( ISPICKVAL( Preferred_Language__c , &apos;German&apos;) , &apos;DE&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;Chinese&apos;), &apos;ZH-S&apos;,
IF( ISPICKVAL( Preferred_Language__c , &apos;Danish&apos;), &apos;DA&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;Finnish&apos;), &apos;FI&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;French&apos;), &apos;FR&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;Italian&apos;), &apos;IT&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;Norwegian&apos;), &apos;NO&apos;,
IF(ISPICKVAL( Preferred_Language__c , &apos;Swedish&apos;), &apos;SV&apos;,
&apos;EN-GB&apos;
) ) ) ) ) ) ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Survey Language</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
