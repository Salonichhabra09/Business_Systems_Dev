        <unique>false</unique>
    </fields>
    <fields>
        <fullName>System_Used_Backend_Use__c</fullName>
        <externalId>false</externalId>
        <formula>IF ( INCLUDES (System_Used__c, &quot;MFS&quot; ), &quot;MFS; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;TalentCentral+&quot; ), &quot;TalentCentral+; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;NSDC-MIS&quot; ), &quot;NSDC-MIS; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Client System&quot; ), &quot;Client System;&quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;WPS&quot; ), &quot;WPS; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Manufacturing Toolbox - MTB&quot; ), &quot;Manufacturing Toolbox - MTB; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Scansys&quot; ), &quot;Scansys; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;DM Desktop Profiler&quot; ), &quot;DM Desktop Profiler; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Online Competency Profiler&quot; ), &quot;Online Competency Profiler;&quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;S2P System&quot; ), &quot;S2P System; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;OFFLINE&quot; ), &quot;OFFLINE; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;JCF Creator&quot; ), &quot;JCF Creator; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Career Guidance&quot; ), &quot;Career Guidance; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;OnDemand&quot; ), &quot;OnDemand; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;SHL ONLINE&quot; ), &quot;SHL ONLINE; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;TalentCentral&quot; ), &quot;TalentCentral; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Dashboard&quot; ), &quot;Dashboard; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;Insights&quot; ), &quot;Insights; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;VADC&quot; ), &quot;VADC; &quot;,null ) &amp;
IF ( INCLUDES (System_Used__c, &quot;iAssess&quot; ), &quot;iAssess; &quot;,null )</formula>
        <label>System Used (Backend Use)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
