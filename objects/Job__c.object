    <fields>
        <fullName>Account_Phoenix_Message__c</fullName>
        <description>This field shows the final message generated by the Phoenix Business Rules as per the following criteria: 
If the Red Message is not blank, it shows the Red Message else it checks the Amber Message. 
If the Amber Message is not blank, it shows the Amber Message else it shows the Green Message.</description>
        <externalId>false</externalId>
        <formula>Account__r.Phoenix_Message__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the Status Message generated by the Phoenix Business Rules</inlineHelpText>
        <label>Trading Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
