    <fields>
        <fullName>Candidate_Transfer_Status__c</fullName>
        <defaultValue>&quot;Not Sent to FTP&quot;</defaultValue>
        <description>This field is created to store Overall transfer satus of ratings related to Job. Transfer status is related to transfer to FTP.</description>
        <label>Candidate Transfer Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Sent to FTP</fullName>
                    <default>false</default>
                    <label>Not Transferred to FTP</label>
                </value>
                <value>
                    <fullName>Ready to transfer</fullName>
                    <default>false</default>
                    <label>Ready to Transfer</label>
                </value>
                <value>
                    <fullName>Sent to FTP</fullName>
                    <default>false</default>
                    <label>Transferred to FTP</label>
                </value>
                <value>
