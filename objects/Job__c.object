    <webLinks>
        <fullName>Progress_Report</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Progress Report</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>window.location.href= &apos;/apex/BureauJob_CustomReportGenerator?id={!Job__c.Id}&amp;reportName=Progress Report&apos;;</url>
    </webLinks>
    <webLinks>
        <fullName>Progress_Report_Multi_Page</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Progress Report (Multi-Page)</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>window.location.href= &apos;/apex/BureauJob_CustomReportGenerator?id={!Job__c.Id}&amp;reportName=RatingProgress_MP&apos;;</url>
    </webLinks>
    <webLinks>
        <fullName>Project_Not_Converted</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Project Not Converted</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/30.0/connection.js&quot;)} 
sforce.connection.sessionId = &apos;{!$Api.Session_ID}&apos;; 
if(&apos;{!Job__c.Pipeline_Status__c}&apos;==&apos;Pipeline - Converted&apos;){ 
  alert(&apos;Attention!  This Pipeline job-card has already been converted!  Please navigate to the Project Commenced job-card.&apos;);
}else{
	if(&apos;{!Job__c.Pipeline_Status__c}&apos;==&apos;Pipeline - Not Converted&apos;){
	  alert(&apos;Attention!  This Pipeline job-card has already been marked as Not Converted.  No further actions can be performed on it.&apos;);
	}else{
	    var flag = true; 
		var TaskCheck = sforce.connection.query(&quot;SELECT id FROM Task WHERE Task_Category__c=&apos;Pipeline&apos; AND WhatId=&apos;{!Job__c.Id}&apos; AND Status IN (&apos;Not Started&apos;, &apos;In Progress&apos;) limit 1&quot;); 
		var records = TaskCheck.getArray(&quot;records&quot;); 
		var alertMessage; 
		if(records.length&gt;0){ 
			flag = false; 
			alertMessage=&quot;You still have open Pipeline category tasks. Please close and comment any Pipeline category tasks and then try again.&quot;; 
		}else{ 
			var TaskCheck1 = sforce.connection.query(&quot;SELECT id FROM Task WHERE WhatId=&apos;{!Job__c.Id}&apos; AND Status =&apos;In Progress&apos; limit 1&quot;); 
			var records1 = TaskCheck1.getArray(&quot;records&quot;); 
			if(records1.length&gt;0){ 
				flag = false; 
				alertMessage=&quot;You appear to have one or more tasks marked as started (but not completed) on the Task Tab. Please complete any tasks started before proceeding.&quot;; 
			} 
		} 
	   if(flag){
	     if(confirm(&apos;Please confirm you wish to mark this Pipeline job as Not Converted (this cannot be undone, and no further changes can be made) - Ok to confirm, Cancel to back up.&apos;))
		   window.parent.location.href=&quot;/apex/ManageMSPipeline?id={!Job__c.Id}&amp;u=1&quot;; 
	   }else{ 
		alert(alertMessage); 
	   } 
	}
}</url>
    </webLinks>
