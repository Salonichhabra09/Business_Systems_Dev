    <fields>
        <fullName>JobOutsideSLA__c</fullName>
        <externalId>false</externalId>
        <formula>if(ISNULL(ProcessedOn__c), 
if( 
(NOW() -SubmittedOn__c- 
CASE(MOD( DATEVALUE(SubmittedOn__c) - DATE(1900,1,7) ,7), 
0 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c) ,7),1,1,2,1,3,1,4,1,5,1,6,2,2), 
1 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c) ,7),1,2,2,3,3,4,4,4,5,4,6,5,2), 
2 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,0,4,0,5,2,6,2,2), 
3 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,0,4,2,5,2,6,2,2), 
4 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,2,4,2,5,2,6,2,2), 
5 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c) ,7),1,0,2,2,3,2,4,2,5,2,6,2,2), 
6 , CASE( MOD( DATEVALUE(NOW()) - DATEVALUE(SubmittedOn__c) ,7),1,2,2,2,3,2,4,2,5,2,6,2,2), 
999) 
) 
&gt;1,&apos;Yes&apos;,&apos;No&apos;), 
if( 
(ProcessedOn__c - SubmittedOn__c- 
CASE(MOD( DATEVALUE(SubmittedOn__c) - DATE(1900,1,7) ,7), 
0 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c) ,7),1,1,2,1,3,1,4,1,5,1,6,2,2), 
1 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c) ,7),1,2,2,3,3,4,4,4,5,4,6,5,2), 
2 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,0,4,0,5,2,6,2,2), 
3 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,0,4,2,5,2,6,2,2), 
4 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c), 7),1,0,2,0,3,2,4,2,5,2,6,2,2), 
5 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c) ,7),1,0,2,2,3,2,4,2,5,2,6,2,2), 
6 , CASE( MOD( DATEVALUE(ProcessedOn__c) - DATEVALUE(SubmittedOn__c) ,7),1,2,2,2,3,2,4,2,5,2,6,2,2), 
999) 
) 
&gt;1,&apos;Yes&apos;,&apos;No&apos;) 
)</formula>
        <label>Job Outside SLA?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
