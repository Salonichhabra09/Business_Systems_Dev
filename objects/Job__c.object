    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>BillingDateForRepetableGCSC</fullName>
        <active>true</active>
        <description>Billing start date is Mandatory for Job where related related opportunity is GCSC</description>
        <errorConditionFormula>AND(ISBLANK(Billing_Cycle_Start_Date__c),Is_GCSC_Opp__c, OR(ISCHANGED( RecordTypeId ), ISNEW() ), RecordType.DeveloperName =&apos;Managed_Service_Commenced&apos;)</errorConditionFormula>
        <errorDisplayField>Billing_Cycle_Start_Date__c</errorDisplayField>
        <errorMessage>Billing Start Date is required when related account is repeatable and opportunity is GCSC</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Career_Guidance_Username_required</fullName>
        <active>true</active>
        <description>If system used = Career Guidance, username must be completed.</description>
        <errorConditionFormula>AND ( 
INCLUDES(System_Used__c ,&quot;Career Guidance&quot;), 
ISBLANK(Career_Guidance_Username__c)
)</errorConditionFormula>
        <errorDisplayField>Career_Guidance_Username__c</errorDisplayField>
        <errorMessage>Please ensure you enter the Career Guidance username value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DSPS_and_MFS_cant_be_selected_together</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
INCLUDES(System_Used__c,&apos;DSPS&apos;),
INCLUDES(System_Used__c,&apos;MFS&apos;)
)</errorConditionFormula>
        <errorMessage>DSPS and MFS can&apos;t be selected together</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GDPR_Data_Deletion_Date_is_mandatory</fullName>
        <active>true</active>
        <description>GDPR Data Deletion Date is mandatory when Project Status changes to Completed.</description>
        <errorConditionFormula>AND(
ISPICKVAL(JobStatus__c, &apos;Closed&apos;),
ISBLANK(Generic_Date_Field_MS_One__c),
NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;))
)</errorConditionFormula>
        <errorMessage>GDPR Data Deletion Date is mandatory when Project Status is Completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Internal_Contact_Required</fullName>
        <active>false</active>
        <description>We need this validation rules as if Job type isSHL ONLINE the internal contact should be default to account owner name. If we make this field mandatory on page layout then we can not set the default value.</description>
        <errorConditionFormula>IF(
	RecordType.DeveloperName = &apos;Bureau_Service&apos;, 
	AND(ISBLANK(InternalContact__c), Text(Job_Type__c) != &apos;SHL Online&apos;),false
	)</errorConditionFormula>
        <errorDisplayField>InternalContact__c</errorDisplayField>
        <errorMessage>You must select an existing Internal Contact.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Reopened_End_Date_Required</fullName>
        <active>true</active>
        <description>If Job Reopened check box is checked then Reopened End Date should be populated.</description>
        <errorConditionFormula>AND(Job_Reopened__c ,ISNULL(Reopened_End_Date__c))</errorConditionFormula>
        <errorDisplayField>Reopened_End_Date__c</errorDisplayField>
        <errorMessage>Please enter Reopened End Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Reopened_Required</fullName>
        <active>false</active>
        <description>If Reopened Start Date and Reopened End Date is provided by user then Job Reopened check box should be checked.</description>
        <errorConditionFormula>AND(NOT(Job_Reopened__c) ,OR(NOT(ISNULL(Reopened_Start_Date__c)),NOT(ISNULL(Reopened_End_Date__c))))</errorConditionFormula>
        <errorDisplayField>Job_Reopened__c</errorDisplayField>
        <errorMessage>Please select Job Reopened.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Reopened_Start_Date_Required</fullName>
        <active>true</active>
        <description>If Job Reopened check box is checked then Reopened Start Date should be populated.</description>
        <errorConditionFormula>AND(Job_Reopened__c ,ISNULL(Reopened_Start_Date__c))</errorConditionFormula>
        <errorDisplayField>Reopened_Start_Date__c</errorDisplayField>
        <errorMessage>Please enter Reopened Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MS_LOB_cannot_be_change_if_tasks_present</fullName>
        <active>true</active>
        <description>&apos;MS - Line of Business&apos; field cannot be modified if there is one or more task present under a Job
STORY# :- SSE-18121 (MS Sprint 3)</description>
        <errorConditionFormula>AND(ISCHANGED(MS_Line_of_Business__c), 
					IF(Number_of_Tasks__c != 0, true , false)
				)</errorConditionFormula>
        <errorDisplayField>MS_Line_of_Business__c</errorDisplayField>
        <errorMessage>&apos;MS - Line of Business&apos; cannot be changed as there is one or more task associated to the Job</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PlatformConfigurationFieldsMandatory</fullName>
        <active>true</active>
        <description>This validation rule checks if all the mandatory platform configuration fields are filled before marking the Job as &apos;Ready to Transfer&apos;</description>
        <errorConditionFormula>AND(
    TEXT(Job_Transfer_Status__c) = &apos;Ready to transfer&apos;,
    OR(
        ISBLANK(System_Client_Id__c),
        ISBLANK(System_URL__c),
        ISBLANK(User_Group__c),
        ISBLANK(Assessment_Profile_Name__c),
        ISBLANK(Project_Name__c),
        ISBLANK(Project_Tags__c),
        ISBLANK(Account__c),
        ISPICKVAL(TC_Project_Type__c, &apos;&apos;),
        ISBLANK(TEXT(Report_Notifications__c))
    )
)</errorConditionFormula>
        <errorMessage>Please fill all the fields under Platform Configuration Section and link Account before marking this Job as &apos;Ready to transfer&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Child_Job_Creation_Of_Child_Job</fullName>
        <active>true</active>
        <description>This rule is used to prevent users to create child jobs of child job</description>
        <errorConditionFormula>IF(Parent_Job__c &lt;&gt; NULL, IF(Parent_Job__r.Parent_Job__c &lt;&gt; NULL, true, false), false)</errorConditionFormula>
        <errorMessage>Child Job cannot have a child Job. Please create a child Job from the Parent Job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Commence_To_Pipeline</fullName>
        <active>true</active>
        <errorConditionFormula>AND (ISCHANGED(RecordTypeId), PRIORVALUE(RecordTypeId) = &apos;012D0000000VAaU&apos;)</errorConditionFormula>
        <errorMessage>Cannot change record type when job is commenced</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Project_Manager_Blank_On_Commenced_Job</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( ISCHANGED(RecordTypeId), RecordType.DeveloperName == &apos;Managed_Service_Commenced&apos;, ISBLANK(Project_Manager__c) )</errorConditionFormula>
        <errorMessage>Project Manager Cannot Be Blank on Commenced Job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Purchase_Order_Mendatory</fullName>
        <active>false</active>
        <description>if purchase order Not required is false on selected account then purchase order number on job should be mendatory</description>
        <errorConditionFormula>AND(OR(RecordType.DeveloperName==&apos;Bureau_Service&apos;,RecordType.DeveloperName==&apos;Managed_Service_Pipeline&apos;, 
RecordType.DeveloperName==&apos;Managed_Service_Commenced&apos;), 
NOT(Account__r.PurchaseOrderRequired__c), ISBLANK( PurchaseOrderNo__c),OR(NOT(ISNEW()),AND(ISNEW(),Is_Auto_Pipeline_Job__c = false) ),NOT(ISCHANGED(Is_Opportunity_Stage_Closed_Won__c)))</errorConditionFormula>
        <errorDisplayField>PurchaseOrderNo__c</errorDisplayField>
        <errorMessage>Please enter value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>QualtricsFieldsCanNotBeUpdateSurveySent</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				 ISPICKVAL(MS_Line_of_Business__c, &apos;Talent Management&apos;),
				 TEXT(Survey_Sent_On__c) &lt;&gt; &apos;&apos;,
					Do_Not_Send_Survey__c == FALSE, 
				 ISPICKVAL(JobStatus__c, &apos;Closed&apos;),
					OR(
									ISCHANGED( Survey_Recipient_Name_1__c),
									ISCHANGED( Survey_Recipient_Name_2__c),
									ISCHANGED( Survey_Recipient_Name_3__c),
									ISCHANGED(Survey_Recipient_Email_1__c),
									ISCHANGED(Survey_Recipient_Email_2__c),
									ISCHANGED(Survey_Recipient_Email_3__c),
         ISCHANGED(Preferred_Language__c) 	  								
					    ) 
				)</errorConditionFormula>
        <errorMessage>Once the survey is sent from the Job, nobody should be able to change the value in any of Recipient fields on Job</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Qualtrics_Fields_Mandatory_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				OR(ISPICKVAL(MS_Line_of_Business__c, &apos;Talent Management&apos;),
       ISPICKVAL(MS_Line_of_Business__c, &apos;TA - Corporate&apos;)
    ),
				RecordType.Name = &apos;Managed Service Commenced&apos;,
				ISPICKVAL(JobStatus__c, &apos;Closed&apos;),
				Do_Not_Send_Survey__c == FALSE,
				TEXT(Survey_Sent_On__c) = &apos;&apos;,
				OR( Survey_Recipient_Email_1__c = &apos;&apos;, Survey_Recipient_Name_1__c =&apos;&apos; ),
    OR( Survey_Recipient_Email_2__c = &apos;&apos;, Survey_Recipient_Name_2__c =&apos;&apos; ),
    OR( Survey_Recipient_Email_3__c = &apos;&apos;, Survey_Recipient_Name_3__c =&apos;&apos; )
	)</errorConditionFormula>
        <errorMessage>At least one pair of Qualtrics Survey field is required when job status is Closed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Job_Region_Change</fullName>
        <active>true</active>
        <errorConditionFormula>OR(AND(NOT( ISNEW() ),
ISCHANGED( Job_Region__c )),
AND(ISNEW(),
Parent_Job__c =&apos;&apos;,
If(TEXT(Opportunity__r.Account.BU__c) =&apos;China - CN1&apos;,&apos;China&apos;,if(TEXT(Opportunity__r.Account.BU__c)=&apos;Hong Kong - HK1&apos;,&apos;Hong Kong&apos;,if(TEXT(Opportunity__r.Account.BU__c)=&apos;Singapore - SG1&apos;,&apos;Singapore&apos;,&apos;Non China&apos;))) &lt;&gt; TEXT(Job_Region__c)))</errorConditionFormula>
        <errorDisplayField>Job_Region__c</errorDisplayField>
        <errorMessage>Job Region should align with the Account/Opportunity BU.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Product_Assessment_For_MFS</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Profile.Name != &apos;System Administrator&apos;,
RecordType.DeveloperName == &apos;Managed_Service_Commenced&apos;,
CONTAINS(TEXT(MS_Line_of_Business__c), &apos;Talent Management&apos;),
INCLUDES(System_Used__c, &apos;MFS&apos;),  
ISCHANGED(Product_Assessment__c),
NOT(
				OR(
								CONTAINS(UPPER(Product_Assessment__c), &apos;SHL 360&apos;),
        CONTAINS(UPPER(Product_Assessment__c), &apos;NOMINATION&apos;),
        CONTAINS(UPPER(Product_Assessment__c), &apos;ENGAGEMENT&apos;)
    )
)
)</errorConditionFormula>
        <errorDisplayField>Product_Assessment__c</errorDisplayField>
        <errorMessage>For MFS System, Product/Assessment should have one of the following: SHL 360, Nomination, or Engagement.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_Date_End_Date_Validaiton</fullName>
        <active>true</active>
        <errorConditionFormula>End_Date__c &lt; Start_Date__c</errorConditionFormula>
        <errorMessage>End date cannot be earlier than start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_End_Date_Required</fullName>
        <active>false</active>
        <description>This rule ensures that an start and end date is provided by the user while creating the Bureau Job in case Job Type is not &quot;Offline&quot; and record type is bureau service.</description>
        <errorConditionFormula>IF(RecordType.DeveloperName = &apos;Bureau_Service&apos;,
AND(OR(ISBLANK(Start_Date__c),ISBLANK(End_Date__c)), Text(Job_Type__c) != &apos;Offline&apos;),false)</errorConditionFormula>
        <errorMessage>You must select Start Date and End Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Systems_cannot_be_more_than_3</fullName>
        <active>true</active>
        <description>It disallows the user to select more than 3 systems.</description>
        <errorConditionFormula>IF(INCLUDES(System_Used__c,&apos;DSPS&apos;),1,0) +
IF(INCLUDES(System_Used__c,&apos;DSPS (Client)&apos;),1,0) +		
IF(INCLUDES(System_Used__c,&apos;MFS&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;MFS (Client)&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;OnDemand&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;OnDemand (Client)&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;S2P System&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;S2P System (Client)&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;WPS&apos;),1,0) +	
IF(INCLUDES(System_Used__c,&apos;WPS (Client)&apos;),1,0) &gt; 3</errorConditionFormula>
        <errorMessage>You cannot select more than 3 systems out of DSPS, MFS, OnDemand, SP2 System and WPS.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Clone</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Clone</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>if(confirm(&quot;Are you sure you wish to Clone this Job-Card?&quot;)){
if(&apos;{!Job__c.RecordTypeName__c}&apos;==&apos;Bureau_Service&apos;){
var FromPickListField  =&quot;{!Job__c.System_Used__c}&quot;; 
var ToPickListFieldName =&quot;00N20000001JzJ6&quot;;  
var pairs;
var Fields = &quot;&quot;;
if(FromPickListField.indexOf(&apos;;&apos;) !=-1){
  pairs=FromPickListField.split(&quot;;&quot;);
  for (var i=0;i&lt;pairs.length;i++){  
	var ThisValue = pairs[i];
	Fields = Fields + ToPickListFieldName+  &quot;=&quot; + ThisValue + &quot;&amp;&quot;;
  } 
}else{
  Fields = ToPickListFieldName+  &quot;=&quot; + FromPickListField;
}

window.parent.location.href=&quot;/a00/e?RecordType={!Job__c.RecordTypeId}&amp;00ND0000005FrGk={!Job__c.Client_System__c}&amp;&quot;+Fields+&quot;&amp;CF00N20000000oB15={!Job__c.Account__c}&amp;CF00N20000000oB15_lkid={!Job__c.AccountId__c}&amp;00N200000012CvP={!Job__c.Job_Type__c}&amp;CF00N20000000oB2f={!Job__c.Contact__c}&amp;CF00N20000000oB2f_lkid={!Job__c.ContactId__c}&amp;CF00ND0000003otby={!Job__c.Internal_Contact__c}&amp;CF00ND0000003otby_lkid={!Job__c.InternalContactId__c}&amp;CF00ND0000003otbx={!Job__c.External_Contact__c}&amp;CF00ND0000003otbx_lkid={!Job__c.External_ContactId__c}&amp;00ND0000003otbw={!Job__c.External_Contact_Others__c}&amp;00ND0000005FrHk={!Job__c.Id}&amp;00ND0000005FrGp={!Job__c.External_Contact_Other_Email_Address__c}&amp;retURL=%2F{!Job__c.Id}&quot;; 
}
if(&apos;{!Job__c.RecordTypeName__c}&apos;==&apos;Managed_Service_Commenced&apos;){
window.parent.location.href=&quot;/a00/e?RecordType={!Job__c.RecordTypeId}&amp;CF00N20000000oB15={!Job__c.Account__c}&amp;CF00N20000000oB15_lkid={!Job__c.AccountId__c}&amp;CF00ND0000003otby={!Job__c.Internal_Contact__c}&amp;CF00ND0000003otby_lkid={!Job__c.InternalContactId__c}&amp;CF00N20000000oB2f={!Job__c.Contact__c}&amp;CF00N20000000oB2f_lkid={!Job__c.ContactId__c}&amp;CF00ND0000003otbx={!Job__c.External_Contact__c}&amp;CF00ND0000003otbx_lkid={!Job__c.External_ContactId__c}&amp;00ND0000003otbw={!Job__c.External_Contact_Others__c}&amp;00ND0000005FrGp={!Job__c.External_Contact_Other_Email_Address__c}&amp;CF00ND0000005Df8U={!Job__c.Opportunity__c}&amp;CF00ND0000005Df8U_lkid={!Job__c.OpportunityId__c}&amp;00ND0000005FrHk={!Job__c.Id}&amp;retURL=%2F{!Job__c.Id}&quot;;
}

}</url>
    </webLinks>
    <webLinks>
        <fullName>Commence_Project</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Commence Project</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/30.0/connection.js&quot;)} 
sforce.connection.sessionId = &apos;{!$Api.Session_ID}&apos;;
if(&quot;{!Job__c.Pipeline_Status__c}&quot;==&quot;Pipeline - Not Converted&quot;){ 
 alert(&quot;Attention!  This Pipeline job-card has already been marked as Not Converted .  You cannot convert a Pipeline job-card that has been marked Not Converted.&quot;);
}
else{
	  var systemUsed = &quot;{!Job__c.System_Used__c}&quot;;
	  
	  if(systemUsed.trim()==&apos;&apos;){
		alert(&quot;Attention!  Please provide System Used details!&quot;);
	  }else{
		  if(&quot;{!Job__c.Pipeline_Status__c}&quot;==&quot;Pipeline - Converted&quot;){
			alert(&quot;Attention!  This Pipeline job-card has already been converted to a Project Commenced job-card.  You cannot change a converted Pipeline job-card.&quot;);
		  }else
		  {
			
			var flag = true;        
			var TaskCheck = sforce.connection.query(&quot;SELECT id FROM Task WHERE Task_Category__c=&apos;Pipeline&apos; AND WhatId=&apos;{!Job__c.Id}&apos; AND Status IN (&apos;Not Started&apos;, &apos;In Progress&apos;) limit 1&quot;);
			var records = TaskCheck.getArray(&quot;records&quot;);
			var alertMessage;
			if(records.length&gt;0){
				flag = false;
				alertMessage=&quot;You still have open Pipeline category tasks. Please close and comment any Pipeline category tasks and then try again.&quot;;
			}else{
				var TaskCheck1 = sforce.connection.query(&quot;SELECT id FROM Task WHERE WhatId=&apos;{!Job__c.Id}&apos; AND Status =&apos;In Progress&apos; limit 1&quot;);
				var records1 = TaskCheck1.getArray(&quot;records&quot;);
				if(records1.length&gt;0){
					flag = false;
					alertMessage=&quot;You appear to have one or more tasks marked as started (but not completed) on the Task Tab. Please complete any tasks started before proceeding.&quot;;
				}
			}
			if(flag){
				if(confirm(&quot;Please confirm you wish to convert this Pipeline job to Project Commenced (this cannot be undone) - OK to confirm, Cancel to back up.&quot;))
				   window.parent.location.href=&quot;/apex/ManageMSPipeline?id={!Job__c.Id}&amp;u=auto&quot;;
			  }
			  else{
				alert(alertMessage);
			}
		}
	}
	
}</url>
    </webLinks>
    <webLinks>
        <fullName>Mark_Project_As_Complete</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Mark Project As Complete</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/30.0/connection.js&quot;)} 

if(&apos;{!Job__c.JobStatus__c}&apos;==&apos;Completed&apos;) 
{ 
alert(&apos;Attention! this project is already completed!&apos;); 
} 
else if(&apos;{!Job__c.Generic_Date_Field_MS_One__c}&apos;==&apos;&apos;) 
{ 
alert(&apos;Please provide GDPR Data Deletion Date before marking the Project as Complete.&apos;); 
} 

else 
{ 
if(confirm(&apos;Are you sure?&apos;)){ 
var updateJobStatus = []; 
var A = new sforce.SObject(&quot;Job__c&quot;); 
A.id =&quot;{!Job__c.Id}&quot;; 
A.JobStatus__c = &apos;Completed&apos;; 
updateJobStatus.push(A); 
result = sforce.connection.update(updateJobStatus); 
if(result[0].success){ 
window.parent.location.href=&quot;/{!Job__c.Id}&quot;; 
} 
} 
}</url>
    </webLinks>
    <webLinks>
