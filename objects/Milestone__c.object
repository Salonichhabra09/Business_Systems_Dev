        <requireRowSelection>false</requireRowSelection>
        <url>/lightning/cmp/c__MilestonesFromProject?c__recordId={!ProjectObject__c.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Update_Milestones</fullName>
