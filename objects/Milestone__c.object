    <fields>
        <fullName>Is_Project_Manager__c</fullName>
        <description>This field is used for system use to check if current logged in user is Project Manager of the concerned milestone</description>
        <formula>OR(($User.Id = Project__r.Project_Manager__c),($User.Id =  Project__r.Project_Co_ordinator__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Project Manager</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
