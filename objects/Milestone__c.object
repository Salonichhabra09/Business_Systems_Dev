        <url>/lightning/o/Milestone__c/new?nooverride=1&amp;defaultFieldValues=Project__c={!ProjectObject__c.Id},CurrencyIsoCode={!ProjectObject__c.CurrencyIsoCode},BU__c={!ProjectObject__c.LBU__c}</url>
    </webLinks>
    <webLinks>
        <fullName>New_Milestone_LEX</fullName>
