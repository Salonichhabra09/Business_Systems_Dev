    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AmountMustBeNegativeIfIntraSHLType</fullName>
        <active>false</active>
        <description>Add a new rule so that if the cross border BU on the milestone has a value, the amount must be set to negative.</description>
        <errorConditionFormula>AND(ISPICKVAL( Service_Type2__c ,&quot;Intra SHL Purchase of Services&quot;), Amount__c  &gt;= 0)</errorConditionFormula>
        <errorDisplayField>Amount__c</errorDisplayField>
        <errorMessage>If the service type is Intra SHL Purchase of Services the amount must be set to negative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CannotAddMilestones</fullName>
        <active>true</active>
        <description>Prevent Users from adding Milestones to Projects where the related Opportunity is Closed Lost</description>
        <errorConditionFormula>ISPICKVAL(Project__r.Opportunity__r.StageName , &quot;Closed Lost&quot;)</errorConditionFormula>
        <errorMessage>You cannot add Milestones to Projects where the related Opportunity is Closed Lost</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CrossBUMandatoryWhenIntraSHLServiceType</fullName>
        <active>false</active>
        <description>The Cross Border BU field is mandatory when the Service Type is set to Intra SHL Purchase of Services</description>
        <errorConditionFormula>AND(ISPICKVAL( Service_Type2__c ,&quot;Intra SHL Purchase of Services&quot;),ISBLANK(TEXT( Cross_Border_BU__c)))</errorConditionFormula>
        <errorDisplayField>Cross_Border_BU__c</errorDisplayField>
        <errorMessage>The Cross Border BU field is mandatory when the Service Type is Intra SHL Purchase of Services</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CurrencySameAsProjectCurrency</fullName>
        <active>true</active>
        <description>Currency must be the same as the project currency.</description>
        <errorConditionFormula>IF( TEXT(CurrencyIsoCode) != TEXT( Project__r.CurrencyIsoCode) ,true, false)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>PM Agent - Currency must be the same as the project currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Milestone_Owner_fields_Check</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR(ISCHANGED(  Project__c ),ISCHANGED( BU__c ),ISCHANGED( Amount__c )),
AND(($User.Id != Project__r.Project_Co_ordinator__c ),
($User.Id != Project__r.Project_Manager__c ))
)</errorConditionFormula>
        <errorMessage>Only Project Manager or Project Co-ordinator  can edit Project, BU and Amount Fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NewFinanceProfileCanChangeOnly3Fields</fullName>
        <active>false</active>
        <description>Finance profile or group can only edit the 3 fields on the milestone and no others.</description>
        <errorConditionFormula>IF($Profile.Name !=&apos;New Finance&apos;,false,IF(OR(ISCHANGED(  Project__c),ISCHANGED(Milestone_Period__c)),true,NOT(OR(ISCHANGED( FC_Sign_Off__c ),ISCHANGED(FC_Sign_Off_Date__c),ISCHANGED(FC_Sign_Off_Name__c)))))</errorConditionFormula>
        <errorMessage>New Finance profile can only edit the &apos;FC Sign Off&apos;,&apos;FC Sign Off Date&apos;,&apos;FC Sign Off Name&apos; fields on the milestone and no others.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoChangesIfPeriodClosed</fullName>
        <active>true</active>
        <description>PM agent is not allowed to edit or remove signed milestone lines in closed financial period.</description>
        <errorConditionFormula>AND(
    NOT($Permission.Modify_Milestone_if_Financial_Period_Closed),
    Milestone_Period__r.Financial_Period_Closed__c,
    Is_Signed__c
)</errorConditionFormula>
        <errorDisplayField>Amount__c</errorDisplayField>
        <errorMessage>Any kind of update is not allowed on milestones when financial period is closed and milestone signed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoChangesUnlessProjMan</fullName>
        <active>false</active>
        <description>PM Agent must be same as the Proj Manager field on project.</description>
        <errorConditionFormula>IF(OR($User.Id==Project__r.Project_Manager__c,$User.Id==Project__r.Project_Co_ordinator__c,$User.Id== Milestone_Owner__c ,$Profile.Name ==&apos;System Administrator&apos;),False,If($Profile.Name ==&apos;New Finance&apos;,false,true))</errorConditionFormula>
        <errorMessage>You can only create or edit milestones if you are the Project Manager OR the Project co-ordinator of the project or the Milestone Owner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoSignMilestoneTotalEqualOrderLineValue</fullName>
        <active>false</active>
        <description>The milestones total value must = the order product value.</description>
        <errorConditionFormula>IF(
AND(
Is_Signed__c,
NOT(ISNEW()),
ROUND((IF(ISNEW(),Project__r.Milestones_Value__c,Project__r.Milestones_Value__c-PRIORVALUE(Amount__c))+Amount__c),2) != ROUND((Project__r.Total_Orderline_Value_RollUp__c)
,2) )
,true, false
)</errorConditionFormula>
        <errorDisplayField>Amount__c</errorDisplayField>
        <errorMessage>You can only sign a milestone if the total milestones value = the order product value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoSigningIfNoOrderLine</fullName>
        <active>true</active>
        <description>A validation rule to restrict the PM Agent - The PM Agent is not allowed to sign or remove milestone entries when there is no Orderline Number linked to the project.</description>
        <errorConditionFormula>IF( AND(ISBLANK( Project__r.Order_Products_Count__c ), Is_Signed__c ) ,true,false)</errorConditionFormula>
        <errorMessage>The milestone cannot be signed as there are no Order Products linked to the project.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Practice_Area_Required_for_US5</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(BU__c,&quot;US5&quot;),ISPICKVAL(Practice_Area__c,&apos;&apos;))</errorConditionFormula>
        <errorDisplayField>Practice_Area__c</errorDisplayField>
        <errorMessage>Please provide a practice area for this milestone</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProjManCanNotChange3Fields</fullName>
        <active>false</active>
        <description>Project Manager Or Project co-ordinator can not edit &apos;FC Sign Off&apos;,&apos;FC Sign Off Date&apos;,and &apos;FC Sign Off Name&apos; fields on the milestone.</description>
        <errorConditionFormula>IF( OR(Project__r.Project_Manager__c ==$User.Id,Project__r.Project_Co_ordinator__c ==$User.Id),
IF( ISNEW(),OR( FC_Sign_Off__c,NOT(ISBLANK(FC_Sign_Off_Date__c)),NOT(ISBLANK(FC_Sign_Off_Name__c))),
	        OR(ISCHANGED( FC_Sign_Off__c ),ISCHANGED(FC_Sign_Off_Date__c),ISCHANGED(FC_Sign_Off_Name__c)) ),False)</errorConditionFormula>
        <errorMessage>Project Manager OR Project co-ordinator can not edit &apos;FC Sign Off&apos;,&apos;FC Sign Off Date&apos;,and &apos;FC Sign Off Name&apos; fields on the milestone.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProjectCCYandOrderCCYEqual</fullName>
        <active>true</active>
        <description>user can only edit a milestone when the currency of the project equals the currency of the opportunity</description>
        <errorConditionFormula>AND( NOT(ISBLANK( Project__r.Opportunity__c )), TEXT(Project__r.CurrencyIsoCode) != TEXT( Project__r.Opportunity__r.CurrencyIsoCode ))</errorConditionFormula>
        <errorMessage>You cannot edit a milestone unless the project and opportunity currency values match.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProjectManagerMandatoryToSign</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Is_Signed__c , ISBLANK( Project__r.Project_Manager__c ) )</errorConditionFormula>
        <errorDisplayField>Is_Signed__c</errorDisplayField>
        <errorMessage>Please add Project Manager before signing the milestone.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Same_Milestone_And_Milestone_Period_BU</fullName>
        <active>true</active>
        <description>To validate that the Milestone BU should be same as Milestone Period&apos;s BU.</description>
        <errorConditionFormula>(TEXT( BU__c)  &lt;&gt;  TEXT(Milestone_Period__r.BU__c))  || 
(TEXT( BU__c)  &lt;&gt;  TEXT( Project__r.LBU__c))</errorConditionFormula>
        <errorDisplayField>BU__c</errorDisplayField>
        <errorMessage>Milestone BU should match the related Project BU AND Milestone Period BU. Please choose the correct BU.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_On_Track_Change</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
		OR(ISCHANGED( Track_change__c ),AND(PRIORVALUE(Track_change__c )=&apos;&apos;,Track_change__c !=&apos;&apos;)),
		AND(($User.Id != Project__r.Project_Co_ordinator__c ),
			($User.Id != Project__r.Project_Manager__c ))
	  )</errorConditionFormula>
        <errorMessage>Only Project Co-ordinator and Project Manager can edit the Track Change Filed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Milestone</fullName>
        <availability>online</availability>
        <description>Old URL - {!URLFOR($Action.Milestone__c.New, Milestone__c.Id, [CF00ND0000005EOwO_lkid=ProjectObject__c.Id, CF00ND0000005EOwO=ProjectObject__c.Project_Name__c, CF00NM0000000uOL9=ProjectObject__c.Project_Manager__c, CF00NM0000000uOL9_lkid=ProjectObject__c.Project_ManagerId__c], true)}&amp;00ND0000005EOxC={!ProjectObject__c.LBU__c}&amp;CurrencyIsoCode={!ProjectObject__c.CurrencyIsoCode}&amp;retURL=%2Fapex%2FProject_ViewPage%3Fid%3D{!ProjectObject__c.Id}%26sfdc.override%3D1</description>
        <displayType>massActionButton</displayType>
