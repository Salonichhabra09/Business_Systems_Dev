        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/lightning/cmp/c__BulkEditMilestonesFromProject?c__recordId={!ProjectObject__c.Id}</url>
    </webLinks>
</CustomObject>
