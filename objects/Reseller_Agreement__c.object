    <webLinks>
        <fullName>Terminate</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Terminate</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/13.0/connection.js&quot;)}
var resObj = new sforce.SObject(&quot;Reseller_Agreement__c&quot;);

resObj.Id = &apos;{!Reseller_Agreement__c.Id}&apos;;
var status = &apos;{!Reseller_Agreement__c.Status__c}&apos;;
if(confirm(&quot;Are you sure?&quot;))
{
	if(status==&apos;Live&apos; || status == &apos;Lapsed&apos;)
	{
		resObj.Status__c = &apos;Terminated&apos;;
		var result = sforce.connection.update([resObj]);
		if (result[0].success==&apos;false&apos;) {
			alert(result[0].errors.message);
		} else {
			location.reload(true);
		}
	}
	else
	{
		alert(&apos;Status can only be changed to Terminated if existing status is Live or Lapsed.&apos;);
	}
}</url>
    </webLinks>
