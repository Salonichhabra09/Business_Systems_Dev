    <validationRules>
        <fullName>Case_Number_Required</fullName>
        <active>true</active>
        <description>If Revenu Not in Our Stream is checked or Invoice Type is &quot;Credit&quot; then Credit Case Number is mendatory.</description>
        <errorConditionFormula>IF(
   AND(Job__r.RecordType.DeveloperName = &apos;Bureau_Service&apos;,OR(Revenue_not_in_our_stream__c == true,ISPICKVAL(InvoiceType__c,&apos;Credit&apos;)),ISBLANK(CreditCaseNo__c))
,true,false)</errorConditionFormula>
        <errorDisplayField>CreditCaseNo__c</errorDisplayField>
        <errorMessage>Please select a case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Credit_Instruction_Required</fullName>
        <active>true</active>
        <description>If Invoice Type is &quot;Credit&quot; then Credit Instruction is mandatory.</description>
        <errorConditionFormula>IF(AND(Job__r.RecordType.DeveloperName = &apos;Bureau_Service&apos;,ISPICKVAL(InvoiceType__c,&apos;Credit&apos;),ISBLANK(CreditInstructions__c)),true,false)</errorConditionFormula>
        <errorDisplayField>CreditInstructions__c</errorDisplayField>
        <errorMessage>Please provide value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invoice_Type_Reason_Mandatory</fullName>
        <active>true</active>
        <description>&quot;Invoice Type Reason&quot; is mandatory if &quot;Free of Charge&quot;, &quot;Credit&quot; or &quot;Reissue&quot; has been selected as &quot;Invoice Type&quot;.</description>
        <errorConditionFormula>AND(
	OR(		
		TEXT(InvoiceType__c)=&quot;Credit&quot;,
                TEXT(InvoiceType__c)=&quot;Free of Charge&quot;,
		TEXT(InvoiceType__c)=&quot;Reissue&quot;
	),
	ISPICKVAL(InvoiceTypeReason__c,&apos;&apos;)
)</errorConditionFormula>
        <errorDisplayField>InvoiceTypeReason__c</errorDisplayField>
        <errorMessage>Please provide Invoice Type Reason value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IsAdded_Notes</fullName>
        <active>true</active>
        <description>If Invoice Notes field is not blank then Added Notes should not be unchecked.</description>
        <errorConditionFormula>IF(ISBLANK( Invoice_notes__c ), if(IsAdded_Notes__c==true,true,false),if(IsAdded_Notes__c==false,true,false))</errorConditionFormula>
        <errorDisplayField>IsAdded_Notes__c</errorDisplayField>
        <errorMessage>Please tick this if Invoice Notes have been added.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lock_record_except_admin_if_SOE_Complete</fullName>
        <active>true</active>
        <description>Once the status = &apos;SOE Complete&apos; the record should be locked to all users other than system admins.</description>
        <errorConditionFormula>IF( NOT(ISNEW()), IF( ISPICKVAL(PRIORVALUE
( InvoiceStatus__c ), 
&quot;SOE Complete&quot;) ,IF( NOT( CONTAINS( $Profile.Name , &quot;Admin&quot;) ) ,true,false),false), false)</errorConditionFormula>
        <errorMessage>Cannot edit record as status set to SOE Complete</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SOE_profile_can_set_invoice_status</fullName>
        <active>true</active>
        <description>only users on the SOE profile can choose &apos;SOE Complete&apos;</description>
        <errorConditionFormula>AND(NOT( OR( $Permission.SOE ,CONTAINS( $Profile.Name , &quot;Admin&quot;), $Permission.Permission_to_bypass_SOE_profile_can_set_invoice_status_rule )), ISPICKVAL( InvoiceStatus__c , &quot;SOE Complete&quot;) )</errorConditionFormula>
        <errorMessage>Only users with SOE profile can select SOE Complete status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sun_Order_not_set_blank_if_SOE_Complete</fullName>
        <active>true</active>
        <description>rule to ensure &apos;SOE Complete&apos; cannot be chosen unless there is a value in the Sun order number field.</description>
        <errorConditionFormula>AND( ISPICKVAL( InvoiceStatus__c , &quot;SOE Complete&quot;) , ISBLANK( SUNOrderNo__c ) )</errorConditionFormula>
        <errorMessage>Status SOE Complete cannot be chosen if Sun Order Number is blank</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
