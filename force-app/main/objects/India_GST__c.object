    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>First_2_GST_Number_digit_will_be_number</fullName>
        <active>true</active>
        <description>First_2_GST_Number_digit_will_be_number</description>
        <errorConditionFormula>IF(AND(Name &lt;&gt; &apos;Outside of India&apos;, Name &lt;&gt; &apos;URP&apos; ,  TEXT(Global_Country__c) = &apos;INDIA&apos;), NOT(ISNUMBER(LEFT( Name , 2) ) ), false) &amp;&amp;  RecordType.DeveloperName=&apos;Tax&apos; &amp;&amp;  TEXT(Type__c)=&apos;GST&apos;</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>First two characters of GST Identification Number should be numerical.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GST_Identification_Number_State_Code</fullName>
        <active>true</active>
        <description>GST Identification Number first 2 digits  should be same as of State Code.</description>
        <errorConditionFormula>AND(TEXT(State_Code__c) &lt;&gt; LEFT(Name, 2), NOT(Name = &apos;Outside of India&apos;), NOT(Name = &apos;URP&apos;),TEXT( Global_Country__c )=&apos;INDIA&apos;)&amp;&amp; RecordType.DeveloperName=&apos;Tax&apos; &amp;&amp; TEXT(Type__c)=&apos;GST&apos;</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>The first two digits of GST Identification Number should be same as of the State Code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GST_Identification_Number_of_15_digit</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(LEN(Name )&lt;&gt; 15, Name &lt;&gt; &apos;Outside of India&apos;, Name &lt;&gt; &apos;URP&apos;,TEXT( Global_Country__c )= &apos;INDIA&apos; ) , true, false)&amp;&amp; RecordType.DeveloperName=&apos;Tax&apos; &amp;&amp; TEXT(Type__c)=&apos;GST&apos;</errorConditionFormula>
        <errorMessage>The GST Identification Number should have 15 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Manually_Transferred_unchecked_on_create</fullName>
        <active>false</active>
        <description>Manually Transferred cannot be yes on creation of GST record.</description>
        <errorConditionFormula>(ISNEW() &amp;&amp;  ISPICKVAL(Manual_Transfer__c , &apos;Yes&apos;) ) 
||
(ISPICKVAL(Manual_Transfer__c , &apos;Yes&apos;) &amp;&amp; OR(ISPICKVAL( Transfer_Status__c,&apos;Transferred&apos;),ISPICKVAL( Transfer_Status__c,&apos;On Hold&apos;)))</errorConditionFormula>
        <errorMessage>Manually Transferred cannot be set to &apos;Yes&apos; while creating a new GST record OR when the &apos;Automatic Transfer Status&apos; is in &apos;Transferred&apos; or &apos;On Hold&apos; status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Number_cannot_be_more_than_15_char</fullName>
        <active>true</active>
        <errorConditionFormula>LEN(Name)&gt;15</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Only 15 digits/characters allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>State_code_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISBLANK( TEXT( State_Code__c ) ),TEXT( Global_Country__c )=&apos;INDIA&apos;) &amp;&amp; TEXT(Type__c)&lt;&gt;&apos;Home Address&apos;</errorConditionFormula>
        <errorDisplayField>State_Code__c</errorDisplayField>
        <errorMessage>State code is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>State_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISBLANK( TEXT(State_County__c) ),TEXT( Global_Country__c )=&apos;INDIA&apos;)</errorConditionFormula>
        <errorDisplayField>State_County__c</errorDisplayField>
        <errorMessage>State/County is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>URP_or_Outside_of_India_on_non_IN1_Acc</fullName>
        <active>true</active>
        <description>Cannot create URP or Outside of India on non-IN1 accounts</description>
        <errorConditionFormula>AND(OR(Name == &apos;Outside of India&apos;, Name == &apos;URP&apos;), NOT(ISPICKVAL(Account__r.BU__c, &apos;India - IN1&apos;) ))</errorConditionFormula>
        <errorMessage>You cannot create a URP or Outside of India GST record on non-IN1 accounts</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New_Address_Record</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New Address Record</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/o/India_GST__c/new?recordTypeId=012Q4000001WEFNIA4&amp;defaultFieldValues=Name=Will auto-fill,Account__c={!Account.Id}&amp;backgroundContext=/lightning/r/Account/{!Account.Id}/related/India_GST__r/view</url>
    </webLinks>
    <webLinks>
        <fullName>New_Tax_Record</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New Tax Record</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/o/India_GST__c/new?recordTypeId=012Q4000001WEFOIA4&amp;defaultFieldValues=Account__c={!Account.Id}&amp;backgroundContext=/lightning/r/Account/{!Account.Id}/related/India_GST__r/view</url>
    </webLinks>
    <webLinks>
        <fullName>Transfer_GST_to_SUN</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Transfer GST to SUN</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/33.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/33.0/apex.js&quot;)} 

var AccountStatus = &quot;{!India_GST__c.Account_Transfer_Status__c}&quot;;

if({!ISPICKVAL(India_GST__c.Transfer_Status__c,&apos;Transferred&apos;)}) {
    alert(&quot;This India GST record is already transferred to Infor 10&quot;)
}
else if({!ISPICKVAL(India_GST__c.Transfer_Status__c,&apos;Transferring&apos;)}) {
    alert(&quot;Transfer process for this India GST record is already in-progress.&quot;)
}
else if({!ISPICKVAL(India_GST__c.Transfer_Status__c,&apos;Failed&apos;)} || {!ISPICKVAL(India_GST__c.Manual_Transfer__c,&apos;Yes&apos;)}) {
    alert(&quot;The automatic transfer for this GST record has failed and can only be transferred manually now OR this record has already been transferred manually.&quot;)
}
else if(AccountStatus == &quot;Not Transferred&quot;) {
    alert(&quot;India GST record cannot be transferred until the related account record is transferred to Infor10&quot;)
}
else if(AccountStatus == &quot;Transferred&quot; &amp;&amp; {!ISPICKVAL(India_GST__c.Transfer_Status__c,&apos;On Hold&apos;)}) {
    var newRecords = []; 
    var gst = new sforce.SObject(&quot;India_GST__c&quot;);
    gst.Id = &apos;{!India_GST__c.Id}&apos;;
    gst.Transfer_Status__c =&apos;Transferring&apos;;
    newRecords.push(gst); 
    var result = sforce.connection.update([gst]); 
    window.location.reload();
}</url>
    </webLinks>
</CustomObject>
