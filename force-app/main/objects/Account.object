    <fields>
        <fullName>Status__c</fullName>
        <description>1. Not yet trading with SHL - (definition - the account is new and/or has no trading history with SHL to date)
2. Trading with SHL - (definition - the account has sales recorded with SHL in the last 2 years)
3. Ceased Trading with SHL - (definition - the account has not traded with SHL in the past 12 months but has previously.) 
4. Dead - (Gone out of Business) (definition - The Account for whatever reason is no longer a trading entity)
Previous Values
1. Active with SHL (definition - The account has a track record of sales and/or opportunities managed in the last 2 years)
2. Inactive with SHL (definition - The account is still a trading account but there has been no activity with SHL (sales or opportunities managed) in the last 2 years)</description>
        <inlineHelpText>Status indicates if Account is approved or not. If you believe an unapproved Account should be Approved, Submit for Approval.</inlineHelpText>
        <label>Account Approval Status</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Unapproved</fullName>
                    <default>true</default>
                    <label>Unapproved</label>
                </value>
                <value>
                    <fullName>Submitted for Approval</fullName>
                    <default>false</default>
                    <label>Submitted for Approval</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Unapproved - Out of Business</fullName>
                    <default>false</default>
                    <label>Unapproved - Out of Business</label>
                </value>
                <value>
                    <fullName>Unapproved - Trade Not Allowed</fullName>
                    <default>false</default>
                    <label>Unapproved - Trade Not Allowed</label>
                </value>
                <value>
                    <fullName>Unapproved - Duplicate</fullName>
                    <default>false</default>
                    <label>Unapproved - Duplicate</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Sun_Comment__c</fullName>
        <description>This field is updated by a daily job from Sun and its value is set to the CMMNT field of the customer in the CUST table of Sun.</description>
        <inlineHelpText>This field is updated by a daily job from Sun and its value is set to the CMMNT field of the customer in the CUST table of Sun.</inlineHelpText>
        <label>Sun Comment</label>
