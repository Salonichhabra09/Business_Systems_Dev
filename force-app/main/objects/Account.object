    <fields>
        <fullName>Phoenix_Amber_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(BU__c,&apos;South Africa - ZA1&apos;),
IF(OR(INCLUDES(License_Type_New__c,&apos;OPQ&apos;),INCLUDES(License_Type_New__c,&apos;OPQ UNPAID&apos;),INCLUDES(License_Type_New__c,&apos;OPQ EXEMPT&apos;),INCLUDES(License_Type_New__c,&apos;OPQ GLOBAL&apos;)),&apos;&apos;,&apos;Check Licence&apos; &amp; BR()) &amp; 
IF(Is_Prepaid__c==&apos;No&apos;,&apos;&apos;,&apos;Check PrePaid Status&apos; &amp; BR()) &amp;
IF(ISPICKVAL(CurrencyIsoCode,&apos;ZAR&apos;),&apos;&apos;,&apos;Check Currency&apos; &amp; BR()),
IF(ISBLANK(Sun_Comment__c),&apos;&apos;,&apos;Check Sun Comments&apos; &amp; BR()) &amp; 
IF(Has_Description__c==&apos;No&apos;,&apos;&apos;, &apos;Check Account Description&apos; &amp; BR())) &amp;
IF(AND(ISPICKVAL(BU__c,&apos;UK - UK1&apos;),ISPICKVAL(Irish_Account__c,&apos;Ireland&apos;)),&apos;Account Is Irish&apos; &amp; BR(), &apos;&apos;) &amp; 
IF(PurchaseOrderRequired__c,&apos;&apos;, &apos;Check Purchase Order&apos; &amp; BR()) &amp;
IF(SPN_Member__c,&apos;SPN Account - Check Pricing&apos; &amp; BR(),&apos;&apos;)</formula>
        <label>Phoenix Amber Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Green_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(BU__c,&apos;South Africa - ZA1&apos;),&apos;Account OK&apos;,
IF(AND(ISPICKVAL(BU__c,&apos;UK - UK1&apos;),PurchaseOrderRequired__c),&apos;No Purchase Order Required&apos; &amp; BR(),&apos;&apos;) &amp; 
IF(ISPICKVAL(Status__c,&apos;Approved&apos;), &apos;Trading with SHL&apos;,&apos;&apos;))</formula>
        <label>Phoenix Green Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Indicator__c</fullName>
        <description>This field displays the Phoenix Status in the form of an image.</description>
        <externalId>false</externalId>
        <formula>IMAGE( CASE(Phoenix_Status__c,
&quot;Red&quot;, &quot;/img/samples/light_red.gif&quot;,
&quot;Amber&quot;, &quot;/img/samples/light_yellow.gif&quot;,
&quot;/img/samples/light_green.gif&quot;), &apos;Phoenix Status&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>For GCSC use only.</inlineHelpText>
        <label>Trading Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Message__c</fullName>
        <description>This field shows the final message generated by the Phoenix Business Rules as per the following criteria:
If the Red Message is not blank, it shows the Red Message else it checks the Amber Message.
If the Amber Message is not blank, it shows the Amber Message else it shows the Green Message.</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Phoenix_Red_Message__c),IF(ISBLANK(Phoenix_Amber_Message__c), Phoenix_Green_Message__c,Phoenix_Amber_Message__c),Phoenix_Red_Message__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>For GCSC use only.</inlineHelpText>
        <label>Trading Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Red_Message__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c,&apos;Approved&apos;),&apos;&apos;,&apos;Check Account Status&apos; &amp; BR()) &amp;
IF(AND(ISPICKVAL(BU__c,&apos;UK - UK1&apos;),NOT(ISPICKVAL(Sun_Status__c, &apos;Open&apos;))),&apos;Sun Status Is Not Open&apos; &amp; BR(),&apos;&apos;) &amp;
IF(ISPICKVAL(BU__c,&apos;South Africa - ZA1&apos;),&apos;&apos;, IF(PurchaseOrderRequired__c,&apos;&apos;,&apos;Check Purchase Order&apos; &amp; BR()) &amp; IF(Sun_Shows_Valid_Credit__c,&apos;&apos;,&apos;Check Sun Credit&apos;))</formula>
        <label>Phoenix Red Message</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phoenix_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Phoenix_Red_Message__c),IF(ISBLANK(Phoenix_Amber_Message__c), &apos;Green&apos;,&apos;Amber&apos;),&apos;Red&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Phoenix Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Process_Guide__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Process Guide?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
