    <fields>
        <fullName>NoOfCandidates__c</fullName>
        <externalId>false</externalId>
        <formula>IF( OR(Job__r.RecordTypeName__c =&apos;Project_Job&apos;,Job__r.RecordTypeName__c =&apos;Bureau_Service&apos;,Job__r.RecordTypeName__c =&apos;Managed_Service_Commenced&apos;), IF(Units__c==0, Job__r.Number_of_Participants_New__c, Units__c), 
Job__r.NoOfCandidates__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number Of Candidates</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
