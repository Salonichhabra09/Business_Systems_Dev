    <fields>
        <fullName>Booking_Availability__c</fullName>
        <label>Booking Availability</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Low Touch - Date Pre-allocated</fullName>
                    <default>false</default>
                    <label>Low Touch - Date Pre-allocated</label>
                </value>
                <value>
                    <fullName>Global Priority Slot - By Special Request</fullName>
                    <default>false</default>
                    <label>Global Priority Slot - By Special Request</label>
                </value>
                <value>
                    <fullName>Standard_Bookable</fullName>
                    <default>false</default>
                    <label>Standard - Bookable</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Confirmed_Total__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Confirmed Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Date__c</fullName>
        <label>Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Free_Spaces__c</fullName>
        <externalId>false</externalId>
        <formula>Maximum_Transitions__c  - ( Provisional_Total__c  +  Confirmed_Total__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Free Spaces</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Full__c</fullName>
        <externalId>false</externalId>
        <formula>If(  Free_Spaces__c  &lt;= 0, IMAGE(&quot;/servlet/servlet.FileDownload?file=01520000000Xjc7&quot;, &quot;Course Full&quot;),null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Full</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Maximum_Transitions__c</fullName>
        <externalId>false</externalId>
        <label>Maximum Transitions</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Month__c</fullName>
        <externalId>false</externalId>
        <formula>Case(TEXT(MONTH(Date__c)),&apos;1&apos;,&apos;January&apos;,&apos;2&apos;,&apos;February&apos;,&apos;3&apos;,&apos;March&apos;,&apos;4&apos;,&apos;April&apos;,&apos;5&apos;,&apos;May&apos;,&apos;6&apos;,&apos;June&apos;,&apos;7&apos;,&apos;July&apos;,&apos;8&apos;,&apos;August&apos;,&apos;9&apos;,&apos;September&apos;,&apos;10&apos;,&apos;October&apos;,&apos;11&apos;,&apos;November&apos;,&apos;12&apos;,&apos;December&apos;,&apos;&apos;)</formula>
        <label>Month</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Provisional_Total__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Provisional Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
