        </valueSet>
    </fields>
    <label>TC Transition Slot</label>
    <listViews>
        <fullName>All_Transitions</fullName>
        <columns>NAME</columns>
        <columns>Date__c</columns>
        <columns>Transition_Slot_Type__c</columns>
        <columns>Free_Spaces__c</columns>
        <columns>Provisional_Total__c</columns>
        <columns>Confirmed_Total__c</columns>
        <columns>Maximum_Transitions__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Transition_Slot_Type__c</field>
            <operation>equals</operation>
            <value>Standard,Complex,Integrated,Low Touch</value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </filters>
        <label>All Transitions today</label>
        <language>en_US</language>
    </listViews>
