    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store information like price increase percentages and yearly unit rates.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Applicable_Year__c</fullName>
        <defaultValue>TEXT(YEAR(TODAY()))</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>Add value of calendar year for whch the rates/price increase is applicable</inlineHelpText>
        <label>Applicable Year</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Business_Unit__c</fullName>
        <label>Business Unit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>BU</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Price_Increase_age__c</fullName>
        <inlineHelpText>Renewal Price Increase percentage</inlineHelpText>
        <label>Price Increase %age</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Unit_Rates__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Add the applicable Unit Rates for each respective BU and currency</inlineHelpText>
        <label>Unit Rates</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Price Trend</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Applicable_Year__c</columns>
        <columns>Business_Unit__c</columns>
        <columns>Price_Increase_age__c</columns>
        <columns>Unit_Rates__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>PTR-{0000}</displayFormat>
        <label>Price Trend Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Price Trends</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Business_Unit__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Applicable_Year__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Price_Increase_age__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Unit_Rates__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CURRENCY_ISO_CODE</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
