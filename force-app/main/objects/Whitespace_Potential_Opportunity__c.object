    </fields>
    <fields>
        <fullName>Potential_Value_In_USD__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
TEXT(CurrencyIsoCode) = &apos;USD&apos;,  Potential_Value__c ,
Potential_Value__c / CURRENCYRATE(TEXT(CurrencyIsoCode))*CURRENCYRATE(&apos;USD&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Potential Value In USD</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
