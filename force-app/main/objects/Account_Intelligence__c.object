    <fields>
        <fullName>AccountName__c</fullName>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Intelligences</relationshipLabel>
        <relationshipName>Account_Intelligences</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>AccountPlan__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account Plan</label>
        <referenceTo>Account_Plan__c</referenceTo>
        <relationshipLabel>Account Intelligences</relationshipLabel>
        <relationshipName>Account_Intelligences</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Account_Intelligence_Name__c</fullName>
        <externalId>false</externalId>
        <formula>AccountName__r.Name + &apos; &apos; +  Salesforce_System_Id__r.System_Name__c</formula>
        <label>Account Intelligence Title</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Intelligence_Type__c</fullName>
        <label>Account Intelligence Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Core HR System/s</fullName>
                    <default>false</default>
                    <label>Core HR System/s</label>
                </value>
                <value>
                    <fullName>Applicant Tracking System/s (ATS)</fullName>
                    <default>false</default>
                    <label>Applicant Tracking System/s (ATS)</label>
                </value>
                <value>
                    <fullName>Learning Management System/s (LMS)</fullName>
                    <default>false</default>
                    <label>Learning Management System/s (LMS)</label>
                </value>
                <value>
                    <fullName>IT Provider/s</fullName>
                    <default>false</default>
                    <label>IT Provider/s</label>
                </value>
                <value>
                    <fullName>Level of integration of HR systems</fullName>
                    <default>false</default>
                    <label>Level of integration of HR systems</label>
                </value>
                <value>
                    <fullName>Other comments re platforms</fullName>
                    <default>false</default>
                    <label>Other comments re platforms</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Archived__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Archived</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Salesforce_System_Id__c</fullName>
        <label>HRMS System</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>System__c.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>HR_MS_System</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>System__c</referenceTo>
        <relationshipLabel>Account Intelligences</relationshipLabel>
        <relationshipName>Account_Intelligences</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
