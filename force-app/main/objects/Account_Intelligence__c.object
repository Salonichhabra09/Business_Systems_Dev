    <label>Account Intelligence</label>
    <nameField>
        <displayFormat>AI{000000}</displayFormat>
        <label>Account Intelligence Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Intelligences</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AccountShouldNotBeSanctioned</fullName>
        <active>true</active>
        <errorConditionFormula>TEXT(AccountName__r.Status__c) = &apos;Rejected - Sanctioned Account&apos;</errorConditionFormula>
        <errorMessage>Operation not allowed as Account is marked Rejected - Sanctioned Account</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Archived</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
