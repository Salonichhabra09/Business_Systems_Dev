    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Account_Name__c</fullName>
        <description>Report Field to display Account Name to filter and summarize the report for better visibility.</description>
        <externalId>false</externalId>
        <formula>Job__r.Account__r.Name   +  &apos; | &apos;   +  Job__r.Account__r.Account_Number__c</formula>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Channel__c</fullName>
        <description>Created for Pendula Integration</description>
        <label>Channel</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Email</fullName>
                    <default>false</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>SMS</fullName>
                    <default>false</default>
                    <label>SMS</label>
                </value>
                <value>
                    <fullName>WhatsApp</fullName>
                    <default>false</default>
                    <label>WhatsApp</label>
                </value>
                <value>
                    <fullName>WeChat</fullName>
                    <default>false</default>
                    <label>WeChat</label>
                </value>
            </valueSetDefinition>
        </valueSet>
