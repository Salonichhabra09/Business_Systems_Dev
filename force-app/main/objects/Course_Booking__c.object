    <label>Course Booking</label>
    <listViews>
        <fullName>ANZ_Delegate_Certificates</fullName>
        <columns>Course_Start_Date__c</columns>
        <columns>Course_Number__c</columns>
        <columns>NAME</columns>
        <columns>Booking_Status__c</columns>
        <columns>Course_Description__c</columns>
        <columns>Billing_Account__c</columns>
        <columns>Delegate_Contact__c</columns>
        <columns>Elearning__c</columns>
        <columns>Assessments__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Course_Booking_BU__c</field>
            <operation>equals</operation>
            <value>Australia,New Zealand</value>
        </filters>
        <filters>
            <field>Booking_Status__c</field>
            <operation>notContain</operation>
            <value>Cancelled</value>
        </filters>
        <filters>
            <field>Course_Start_Date__c</field>
            <operation>greaterThan</operation>
            <value>YESTERDAY</value>
        </filters>
        <filters>
            <field>Course_Description__c</field>
            <operation>notContain</operation>
            <value>system,workshop,CBI</value>
        </filters>
        <label>~ANZ Delegate Pre-Course Work</label>
        <language>en_US</language>
        <sharedTo>
            <group>ANZAdmin</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>ANZ_Pre_Course_Tracking</fullName>
        <columns>Course_Start_Date__c</columns>
        <columns>Course_Number__c</columns>
        <columns>NAME</columns>
        <columns>Course_Description__c</columns>
        <columns>Delegate_Contact__c</columns>
        <columns>Elearning__c</columns>
        <columns>Contact_Notes__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Course_Booking_BU__c</field>
            <operation>equals</operation>
            <value>Australia,New Zealand</value>
        </filters>
        <filters>
            <field>Booking_Status__c</field>
            <operation>equals</operation>
            <value>Confirmed</value>
        </filters>
        <filters>
            <field>Course_Start_Date__c</field>
            <operation>lessThan</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>Course_Start_Date__c</field>
            <operation>greaterThan</operation>
            <value>LAST_N_DAYS:60</value>
        </filters>
        <filters>
            <field>Course_Description__c</field>
            <operation>notContain</operation>
            <value>system,workshop</value>
        </filters>
        <label>~ANZ Delegate Certificates</label>
        <language>en_US</language>
        <sharedTo>
            <group>ANZAdmin</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>AllAmericasBookings</fullName>
        <columns>Course_Name__c</columns>
        <columns>Course_Start_Date__c</columns>
        <columns>Delegate_Contact__c</columns>
        <columns>Course_Venue__c</columns>
        <columns>NAME</columns>
        <columns>Course_Number__c</columns>
        <columns>Booking_Status__c</columns>
        <columns>LAST_ACTIVITY</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Booking_Status__c</field>
            <operation>equals</operation>
            <value>Provisional</value>
        </filters>
        <filters>
            <field>Profit_Centre__c</field>
            <operation>equals</operation>
            <value>Canada - CA1,US - US1,US - US5</value>
        </filters>
        <filters>
            <field>Course_Start_Date__c</field>
            <operation>greaterOrEqual</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>Course_Name__c</field>
            <operation>notContain</operation>
            <value>SODA</value>
        </filters>
        <filters>
            <field>Course_Description__c</field>
            <operation>notContain</operation>
            <value>SODA</value>
        </filters>
        <label>All Americas Provisional Bookings</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>AllBookingsspecificcompany</fullName>
        <columns>Course_Name__c</columns>
