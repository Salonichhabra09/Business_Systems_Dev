    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>BillingContactCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
ISCHANGED( Invoice_Status__c ),
 ISPICKVAL(Invoice_Status__c, &apos;Ready for OAT&apos;),
  Billing_Contact__r.AccountId  &lt;&gt;  Billing_Account__r.Id,
NOT(ISPICKVAL(Billing_Contact__r.Contact_Status__c, &apos;Active&apos;)) 
)</errorConditionFormula>
        <errorDisplayField>Billing_Contact__c</errorDisplayField>
        <errorMessage>Selected Billing Contact is not part of Billing Account or the Billing Contact is inactive. Please select correct Billing Contact/Account to mark Invoice status as &apos;Ready for OAT&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Booking_Status_RestrictedTraining</fullName>
        <active>true</active>
        <description>Training profile can still set one of the status fields to Complete&apos; or &apos;Ready for invoicing/crediting&apos;.</description>
        <errorConditionFormula>AND(IF($Permission.Training,
	IF( 
	OR(
		IF(
			ISCHANGED(Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Invoice_Status__c, &apos;Ready for OAT&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Unit Transfer&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Credit_Status__c, &apos;Ready for OAT&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Unit Transfer&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Other_Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Other_Credit_Status__c, &apos;Ready for OAT&apos;),
					ISPICKVAL(Other_Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Other_Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Other_Credit_Status__c, &apos;Unit Transfer&apos;)
				),false,true
			),false
		)
	),true,
	false),
	false
),NOT(IsAutomationBypassed__c))</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Other Credit Status to Complete&apos; or &apos;Ready for invoicing/crediting&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Booking_Status_Restricted_OAT</fullName>
        <active>true</active>
        <description>OAT profile can still set one of the status fields to &apos;Completed&apos;.</description>
        <errorConditionFormula>IF( $Permission.OATs ,
	IF( 
		OR(
			IF(
				ISCHANGED(Invoice_Status__c),
				IF(
					OR(
						ISPICKVAL(Invoice_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Unit Transfer&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Ready to be invoiced&apos;)
					),false, IF(IsAutomationBypassed__c=true,false, true)  
				),false
			),
			IF(
				ISCHANGED(Credit_Status__c),
				IF(
					OR(
						ISPICKVAL(Credit_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Unit Transfer&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Ready to be credited&apos;)
					),false,true
				),false
			),
			IF(
				ISCHANGED(Other_Credit_Status__c),
				IF(
					OR(
						ISPICKVAL(Other_Credit_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Other_Credit_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Other_Credit_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Other_Credit_Status__c, &apos;Unit Transfer&apos;),
						ISPICKVAL(Other_Credit_Status__c, &apos;Ready to be credited&apos;)
					),false,true
				),false
			)
		),true,
	false),
	false
)</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Other Credit Status to &apos;Completed&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Booking_Status_Restricted_SOE</fullName>
        <active>true</active>
        <description>Training profile can still set one of the status fields to &apos;Ready for OAT&apos; or &apos;Ready for invoicing/crediting&apos; or &apos;Unit transfer&apos;.</description>
        <errorConditionFormula>IF( $Permission.SOE ,
	IF( 
	OR(
		IF(
			ISCHANGED(Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Completed&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Completed&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Other_Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Other_Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Other_Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Other_Credit_Status__c, &apos;Completed&apos;)
				),false,true
			),false
		)
	),true,
	false),
	false
)</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Other Credit Status to &apos;Ready for OAT&apos; or &apos;Ready for invoicing/crediting&apos; or &apos;Unit transfer&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_booking_transfer_deferral_month</fullName>
        <active>true</active>
        <description>Ensure deferral month is complete if booking set to transferred.</description>
        <errorConditionFormula>AND ( 
ISPICKVAL(Transferred_Booking__c ,&quot;Yes&quot;), 
ISBLANK(Deferral_Month__c)
)</errorConditionFormula>
        <errorMessage>Please enter the deferral month.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_booking_transfer_new_reference</fullName>
        <active>true</active>
        <description>If the course booking transfer checkbox field is selected, either the new or from course booking reference must be added.</description>
        <errorConditionFormula>AND ( 
ISPICKVAL( Transferred_Booking__c ,&quot;Yes&quot;), 
Course_Booking_Transferred_To__c  =&quot;&quot;,
Course_Booking_Transferred_From__c  =&quot;&quot;
)</errorConditionFormula>
        <errorMessage>Please ensure you enter either the new or from course booking reference for the transferred booking.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CreditStatusandSectionDetails</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR( 
Reason_for_Cancellation__c =&quot;&quot;, 
ISNULL(Date_Cancelled__c), 
ISPICKVAL( Cancellation_Refund_Type__c ,&quot;&quot;), 
ISNULL(Credit_Amount__c), 
ISPICKVAL( Credit_Reason__c ,&quot;&quot;), 
Credit_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Public Booking Cancellation Credit Details section fields (except SUN Credit Note No. &amp; Credit note Notes) if the Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_order_ref_blank_check</fullName>
        <active>true</active>
        <description>If the purchase order is required on the account of the billing account then the customer order ref cannot be blank. Needs all invoice and credit status ready rules to have the customer order ref removed too. JM 30/11/09</description>
        <errorConditionFormula>AND (NOT (ISBLANK( Billing_Account__c )) ,NOT ( Billing_Account__r.PurchaseOrderRequired__c ), ISBLANK ( Customer_Order_Ref__c ), ISPICKVAL( Invoice_Status__c ,&quot;Ready for OAT&quot;) )</errorConditionFormula>
        <errorMessage>Please ensure you enter the customer order ref.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DelegateAccountOwnershouldbeActive</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				 NOT(CONTAINS($Profile.Name,&apos;System Admin&apos;)),
					OR(
					ISPICKVAL(Booking_Status__c, &apos;Confirmed&apos;),
					ISPICKVAL(Booking_Status__c, &apos;Cancelled&apos;),
					ISPICKVAL(Booking_Status__c, &apos;Waiting&apos;)
					),
					NOT(Delegate_Account_Owner__r.IsActive),
				 ISCHANGED(Booking_Status__c)
)</errorConditionFormula>
        <errorMessage>Delegate Account Owner is Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DiscountApprovedByMandatory</fullName>
        <active>true</active>
        <description>Discount Approved By field is mandatory if the Discount amount is greater than zero.</description>
        <errorConditionFormula>AND(   Course_Price_Discount__c  &gt;0,  DiscountApprovedBy__c=&quot;&quot; )</errorConditionFormula>
        <errorMessage>Discount Approved By field is mandatory as the  Course Discount amount is greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvStatusCompleted_SUN_order_number_reqd</fullName>
        <active>true</active>
        <description>The SUN order number becomes a required field is the invoice status is completed</description>
        <errorConditionFormula>AND 
( 
SUN_Order_Number__c=&quot;&quot; , 
(ISPICKVAL( Invoice_Status__c ,&quot;Completed&quot;)))</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Invoice Status is &quot;Completed&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatus_and_NoofUnitsTransferred</fullName>
        <active>true</active>
        <description>Checks that if the Invoice Status field is set to Unit Transfer that an actual amount is entered into the No of Units Transferred field.</description>
        <errorConditionFormula>OR( 
AND(ISPICKVAL( Invoice_Status__c , &quot;Unit Transfer&quot;) 
, ISNULL( No_of_Units_Transferred__c ) ) 
,AND(ISPICKVAL( Invoice_Status__c , &quot;Unit Transfer&quot;) 
, No_of_Units_Transferred__c = 0) 
)</errorConditionFormula>
        <errorDisplayField>No_of_Units_Transferred__c</errorDisplayField>
        <errorMessage>Please enter the number of units transferred.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatusandSectionDetails</fullName>
        <active>true</active>
        <description>Removed customer order ref - JM 1/12/09</description>
        <errorConditionFormula>AND (
ISPICKVAL( Invoice_Status__c ,&quot;Ready for OAT&quot;),
OR(
Billing_Account__c =&quot;&quot;,
Billing_Contact__c =&quot;&quot;,
ISPICKVAL(Invoice_Language__c,&quot;&quot;),
ISPICKVAL( Item_Master_Lookup__c ,&quot;&quot;),
Invoice_Text_Description__c =&quot;&quot;,
ISPICKVAL( Currency_to_Invoice__c ,&quot;&quot;),
ISPICKVAL( Department_Code__c ,&quot;&quot;),
ISBLANK(Course_Price__c )
)
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Course Price &amp; Public Booking Invoice Details section fields (except SUN Order No. &amp; Order Ref ) if the Invoice Status is &quot;Ready for OAT&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LeadSourceMandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND 
( 
ISPICKVAL( Course_Number__r.Course_Category__c ,&quot;Public&quot;), 
ISPICKVAL( Lead_Source__c ,&quot;&quot;) 
)</errorConditionFormula>
        <errorDisplayField>Lead_Source__c</errorDisplayField>
        <errorMessage>It is mandatory to select Lead Source if the Course Category on the Course is &quot;Public&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Offer_code_when_discount_is_added</fullName>
        <active>true</active>
        <description>Offer code to be mandatory when a discount is applied</description>
        <errorConditionFormula>AND(Course_Price_Discount__c &gt;=0.01,ISBLANK(Offer_Code__c ),NOT(ISCHANGED(Delegate_Account_Owner__c)))</errorConditionFormula>
        <errorMessage>Discount has been applied to this booking - please enter the course offer code</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnlyConfirmedBookingsCanBeInvoiced</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISPICKVAL(Booking_Status__c,&apos;Confirmed&apos;)),
ISPICKVAL( Invoice_Status__c , &apos;Ready For OAT&apos;))</errorConditionFormula>
        <errorMessage>Only Course Bookings with &apos;Confirmed&apos; booking status can be marked as &apos;Ready For OAT&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OtherCreditStatusandSectionDetails</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( 
ISPICKVAL(Other_Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR( 
ISNULL(Other_Credit_Amount__c ), 
ISPICKVAL( Other_Credit_Reason__c ,&quot;&quot;), 
Other_Credit_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Public Booking Other Credits section fields (except Other Credit SUN Credit Note No. &amp; Other Credit Notes) if the Other Credit Status is &quot;Ready to be credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderNoMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND 
( 
SUN_Order_Number__c=&quot;&quot; , 
OR 
( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
ISPICKVAL(Other_Credit_Status__c ,&quot;Ready to be credited&quot;) 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Credit Status or Other Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Transferredbooking_SUN_order_number_reqd</fullName>
        <active>true</active>
        <description>The SUN order number becomes a required field if the Transferred Booking field is set to Yes</description>
        <errorConditionFormula>AND 
( SUN_Order_Number__c=&quot;&quot; , (ISPICKVAL( Transferred_Booking__c ,&quot;Yes&quot;)))</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Transferred Booking is set to &quot;Yes&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Unit_Transfer_units_required</fullName>
        <active>true</active>
        <description>When the invoice status field on the course booking and course has the unit transfer picklist option chosen, there should be a field and validation rule to ensure the user enters the number of units to transfer.</description>
        <errorConditionFormula>AND (ISPICKVAL(Invoice_Status__c,&quot;Unit Transfer&quot;),  ISBLANK( No_of_Units_Transferred__c ))</errorConditionFormula>
        <errorMessage>Please enter number of units transfered</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>CourseBooking_Clone</fullName>
        <availability>online</availability>
        <description>Displays Qualification Check &amp; Waiting Message while Clone a booking</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Clone</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>window.alert(&quot;Please create a booking from the Courses Tab&quot;);</url>
    </webLinks>
    <webLinks>
        <fullName>CourseBooking_New</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/support/console/28.0/integration.js&quot;)}
if(&quot;{!Courses__c.Course_Status__c}&quot; == &quot;Cancelled&quot;)
{
alert(&quot;No new booking can be created as this Course has been Cancelled.&quot;);
if (sforce.console.isInConsole()) { 
srcUp(&apos;{!URLFOR( $Action.Courses__c.View , Courses__c.Id, null, true)}&apos;); 
} else { 
window.parent.location.href =&apos;{!URLFOR( $Action.Courses__c.View   , Courses__c.Id, null, true)}&apos;;
}
}
else
{
alert(&quot;Please ensure the delegate has the required qualifications for this course before making the booking.&quot;); 

if (&quot;{!Courses__c.Course_Free_Spaces__c}&quot;&lt;= 0) 
	alert(&quot;This course is currently full so this booking will be saved with a status of Waiting.&quot;); 

var Currency=&apos;{!Courses__c.CurrencyIsoCode}&apos;;
var completeUrl;

var url =&apos;{!URLFOR($Action.Course_Booking__c.New, Course_Booking__c.Id, [CF00N20000000pPXU_lkid=Courses__c.Id, CF00N20000000pPXU=Courses__c.Name], true)}&apos;;

completeUrl= url+&apos;&amp;CurrencyIsoCode=&apos;+Currency;
if (sforce.console.isInConsole()) { 
srcUp(completeUrl + &apos;&amp;00N20000000pQaK={!TEXT(Courses__c.Course_Price__c)}&amp;00N20000000pQaZ={!TEXT(Courses__c.Course_Residential_Price__c)}&amp;00N20000001I2pZ={!TEXT(Courses__c.Extra_night_price__c)}&apos;); 
} else { 
window.parent.location.href =completeUrl + &apos;&amp;00N20000000pQaK={!TEXT(Courses__c.Course_Price__c)}&amp;00N20000000pQaZ={!TEXT(Courses__c.Course_Residential_Price__c)}&amp;00N20000001I2pZ={!TEXT(Courses__c.Extra_night_price__c)}&apos;;
}

}</url>
    </webLinks>
    <webLinks>
        <fullName>CourseBooking_PassDelegate</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Pass Booking</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/8.0/connection.js&quot;)}
var records = {!GETRECORDIDS($ObjectType.Course_Booking__c)}; 
var newRecords = [];
if (records[0] == null)
{
    alert(&quot;Please select at least one row&quot;)
}
else
{
    courseBooking = sforce.connection.retrieve(&quot;Id, Pass_Status__c,Booking_Status__c&quot;, &quot;Course_Booking__c&quot;, records);

    for (var i in courseBooking) 
    {
        if(courseBooking[i].Booking_Status__c ==&quot;Confirmed&quot; &amp;&amp; courseBooking[i].Pass_Status__c== null)
        courseBooking[i].Pass_Status__c= &quot;Pass&quot;;
    
        
    }
    saveresult = sforce.connection.update(courseBooking );
   top.window.location.href = top.window.location.href;
    alert(&quot;Pass status for Confirmed Bookings updated successfully&quot;); 
}</url>
    </webLinks>
    <webLinks>
        <fullName>New_Course_Booking_Bulk</fullName>
        <availability>online</availability>
        <description>Used to create the Course Booking in bulk from Course Related List</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>New CB Bulk</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/lightning/cmp/c__CourseBookingsFromCourse?c__recordId={!Courses__c.Id}&amp;c__courseStatus={!Courses__c.Course_Status__c}</url>
