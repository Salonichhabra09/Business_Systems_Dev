        <relationshipName>R00N20000000pQatEAE</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Total_Price__c</fullName>
        <description>Calculation based on the Extra Night &amp; Require Residence flag values.</description>
        <formula>IF(ISPICKVAL(Requires_Residence__c, &quot;Residential&quot;),  Residential_price__c , Course_Price__c) + IF(ISPICKVAL(Extra_Night__c,&quot;Yes&quot;),Extra_night_price__c,0) - Course_Price_Discount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Prices are now fixed in Sun based on agreed price.</inlineHelpText>
        <label>Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
