        <customTabListAdditionalFields>Course_Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Course_Start_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Delegate_Contact__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Course_Venue__c</customTabListAdditionalFields>
