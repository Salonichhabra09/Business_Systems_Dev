    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Bespoke_materials_mandatory</fullName>
        <active>true</active>
        <description>If the standard materials option is not checked then bespoke materials is mandatory.</description>
        <errorConditionFormula>AND(NOT ( Standard_Course_Materials__c  ), 
				ISBLANK( Bespoke_Material_Notes__c ) ) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Please ensure you update the bespoke materials notes if the standard materials is not checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CheckNumber</fullName>
        <active>true</active>
        <errorConditionFormula>AND (NOT($Permission.CSIT), NOT( ISNUMBER( Duration__c ) )) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorDisplayField>Duration__c</errorDisplayField>
        <errorMessage>Invalid Number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_Course_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>AND( OR(ISPICKVAL(Course_Status__c,&apos;Completed&apos;), ISPICKVAL(Course_Status__c,&apos;Completed (assumed)&apos;)), NOT(OR(ISPICKVAL(Course_Type__c ,&quot;System Demo&quot;) , ISPICKVAL(Course_Type__c ,&quot;System Training&quot;))) , Course_End_Date__c &gt; TODAY()) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Course status can not be set as completed before course end date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CourseEndDateSmall</fullName>
        <active>true</active>
        <errorConditionFormula>AND($Profile.Name!=&quot;System Administrator&quot;,(Course_End_Date__c &lt; Course_Start_Date__c ), NOT(OR(ISPICKVAL(Course_Type__c ,&quot;System Demo&quot;) , ISPICKVAL(Course_Type__c ,&quot;System Training&quot;)))) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Course End Date must be after Course Start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Description_Mandatory</fullName>
        <active>true</active>
        <description>Course Description should be mandatory for all values other than System Training + system demo</description>
        <errorConditionFormula>AND($Profile.Name!=&quot;System Administrator&quot;,
ISBLANK(Course_Description__c),
NOT(OR(ISPICKVAL(Course_Type__c ,&quot;System Demo&quot;) , ISPICKVAL(Course_Type__c ,&quot;System Training&quot;)))) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorDisplayField>Course_Description__c</errorDisplayField>
        <errorMessage>Course Description is Mandatory for this Course Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Status_restricted_OAT</fullName>
        <active>false</active>
        <description>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Status to &apos;Complete&apos;.</description>
        <errorConditionFormula>IF($Profile.Name =&apos;OAT&apos;,
	IF( 
		OR(
			IF(
				ISCHANGED(Credit_Status__c),
				IF(
					OR(
						ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Ready to be credited&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Credit_Status__c, &apos;Unit transfer&apos;)
					),false,true
				),false
			),
			IF(
				ISCHANGED(Expense_Credit_Status__c),
				IF(
					OR(
						ISPICKVAL(Expense_Credit_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Expense_Credit_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Expense_Credit_Status__c, &apos;Ready to be credited&apos;),
						ISPICKVAL(Expense_Credit_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Expense_Credit_Status__c, &apos;Unit transfer&apos;)
					),false,true
				),false
			),
			IF(
				ISCHANGED(Expense_Invoice_Status__c),
				IF(
					OR(
						ISPICKVAL(Expense_Invoice_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Expense_Invoice_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Expense_Invoice_Status__c, &apos;Ready to be invoiced&apos;),
						ISPICKVAL(Expense_Invoice_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Expense_Invoice_Status__c, &apos;Unit transfer&apos;)
					),false,true
				),false
			),
			IF(
				ISCHANGED(Invoice_Status__c),
				IF(
					OR(
						ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Ready to be invoiced&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Ready for OAT&apos;),
						ISPICKVAL(Invoice_Status__c, &apos;Unit transfer&apos;)
					),false,true
				),false
			)
		),true,
		false
		),
	false
)</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Status to &apos;Complete&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Status_restricted_SOE</fullName>
        <active>false</active>
        <description>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Status to &apos;Ready for OAT&apos; or &apos;Unit transfer&apos; or &apos;Ready for invoicing/crediting&apos;.</description>
        <errorConditionFormula>IF($Profile.Name =&apos;SOE&apos;,
IF( 
	OR(
		IF(
			ISCHANGED(Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Complete&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Expense_Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Expense_Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Expense_Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Expense_Credit_Status__c, &apos;Completed&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Expense_Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Completed&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Complete&apos;)
				),false,true
			),false
		)
	),
	true,
	false
),
false
)</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Statusto &apos;Ready for OAT&apos; or &apos;Unit transfer&apos; or &apos;Ready for invoicing/crediting&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_Status_restricted_training</fullName>
        <active>false</active>
        <description>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Status to &apos;Ready for invoicing/crediting&apos; or &apos;Completed&apos;.</description>
        <errorConditionFormula>IF($Profile.Name = &apos;Training Services UK&apos;,
IF( 
	OR(
		IF(
			ISCHANGED(Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Unit Transfer&apos;),
					ISPICKVAL(Credit_Status__c, &apos;Ready for OAT&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Expense_Credit_Status__c),
			IF(
				OR(
					ISPICKVAL(Expense_Credit_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Expense_Credit_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Expense_Credit_Status__c, &apos;Unit Transfer&apos;),
					ISPICKVAL(Expense_Credit_Status__c, &apos;Ready for OAT&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Expense_Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Unit Transfer&apos;),
					ISPICKVAL(Expense_Invoice_Status__c, &apos;Ready for OAT&apos;)
				),false,true
			),false
		),
		IF(
			ISCHANGED(Invoice_Status__c),
			IF(
				OR(
					ISPICKVAL(Invoice_Status__c, &apos;Completed via order&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Queried&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Unit Transfer&apos;),
					ISPICKVAL(Invoice_Status__c, &apos;Ready for OAT&apos;)
				),false,true
			),false
		)
	),
	true,
	false
),
false
)</errorConditionFormula>
        <errorMessage>You can not set Invoice Status or Credit Status or Expense Credit Status or Expense Invoice Status to &apos;Ready for invoicing/crediting&apos; or &apos;Completed&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Course_transfer_new_reference</fullName>
        <active>false</active>
        <description>If the course transfer checkbox field is selected, either the new or from course reference must be added.</description>
        <errorConditionFormula>AND ( 
ISPICKVAL( Transferred_Course__c ,&quot;Yes&quot;), 
Course_Transferred_To__c  =&quot;&quot;,
Course_Transferred_From__c  =&quot;&quot;
)</errorConditionFormula>
        <errorMessage>Please ensure you enter either the new or from course reference for the transferred course</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CreditStatusandSectionFields</fullName>
        <active>false</active>
        <errorConditionFormula>AND 
( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR 
( 
ISNULL(Credit_Amount__c), 
ISPICKVAL(Credit_Reason__c,&quot;&quot;), 
Credit_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Incompany Course Credit Details section fields (except SUN Credit Note No. &amp; Credit note Notes) if the Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_order_ref_blank_check</fullName>
        <active>false</active>
        <description>Please ensure you add the customer order ref. (skipped for GCSC profile and automation process)</description>
        <errorConditionFormula>AND (
NOT ( ISBLANK( Partner_Account_Name__c )),
NOT ( Partner_Account_Name__r.PurchaseOrderRequired__c ),
ISBLANK (Customer_Order_Ref__c ),
NOT ( $Profile.Name = &apos;GCSC General&apos;)
) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Please ensure you add the customer order ref.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Deferral_month_must_be_completed</fullName>
        <active>true</active>
        <description>If the Transferred course = y then the deferral month must be completed.</description>
        <errorConditionFormula>AND ( 
ISPICKVAL(Transferred_Course__c ,&quot;Yes&quot;), 
ISBLANK(Deferral_Month__c)
) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Please ensure you enter the deferral month.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DiscountApprovedByMandatory</fullName>
        <active>true</active>
        <description>Discount  Approved By field is mandatory if the Discount amount is greater than zero.</description>
        <errorConditionFormula>AND( Discount_Amount__c&gt;0,  DiscountApproved_By__c =&quot;&quot; ) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>Discount  Approved By field is mandatory as the Discount amount is greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Error_on_Course_Extra_Night_field_change</fullName>
        <active>false</active>
        <description>Throws an error whenever the Course Extra Night Price field is changed.</description>
        <errorConditionFormula>IF( NOT( ISBLANK( Extra_night_price__c) ), IF 
(AND ( 
NOT($User.Allow_C_B_Price_Change__c ), 
ISCHANGED( Extra_night_price__c), 
NOT( ISBLANK(PRIORVALUE(Extra_night_price__c) )) 
) ,true,false) , 
false)</errorConditionFormula>
        <errorMessage>You do not have the required permissions to change the price fields on a course - please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Error_on_Course_Price_field_change</fullName>
        <active>true</active>
        <description>Throws an error whenever the Public Course Price field is changed.</description>
        <errorConditionFormula>IF( NOT( ISBLANK( Course_Price__c) ), 
IF (AND 
( 
NOT($User.Allow_C_B_Price_Change__c ), 
ISCHANGED( Course_Price__c ), 
NOT( ISBLANK(PRIORVALUE(Course_Price__c ) ) ) 
) ,true,false 
) 
,false) &amp;&amp; IsAutomationBypassed__c = false</errorConditionFormula>
        <errorMessage>You do not have the required permissions to change the price fields on a course - please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Error_on_Course_Residential_Price_change</fullName>
        <active>false</active>
        <description>Throws an error whenever the Course Residential Price field is changed.</description>
        <errorConditionFormula>IF( NOT( ISBLANK( Course_Residential_Price__c) ), 
IF (AND( 
NOT($User.Allow_C_B_Price_Change__c ), 
ISCHANGED( Course_Residential_Price__c ), 
NOT( ISBLANK(PRIORVALUE(Course_Residential_Price__c ) )) 
),true,false) , 
false)</errorConditionFormula>
        <errorMessage>You do not have the required permissions to change the price fields on a course - please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExpenseCreditStatusandSectionDetails</fullName>
        <active>false</active>
        <errorConditionFormula>AND ( 
ISPICKVAL(Expense_Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR( 
ISNULL(Expense_Credit_Amount__c), 
ISPICKVAL(Expense_Credit_Reason__c ,&quot;&quot;), 
Expense_Credit_Text_Description__c=&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Incompany Course Expense Credit Details section fields (except Expense SUN Credit note No. &amp; Expense Credit Notes) if the Expense Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExpenseInvoiceStatusandSectionFields</fullName>
        <active>false</active>
        <errorConditionFormula>AND ( 
ISPICKVAL( Expense_Invoice_Status__c ,&quot;Ready to be invoiced&quot;), 
OR 
( 
Inco_Expense_IM_Code__c =&quot;&quot;, 
ISNULL(Expense_Amount__c), 
Expense_Invoice_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Incompany Course Expense Invoice Details section fields (except Expense SUN Order No. &amp; Expense Invoice Notes) if the Expense Invoice Status is &quot;Ready to be Invoiced&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvStatusCompleted_SUN_order_number_reqd</fullName>
        <active>false</active>
        <description>The SUN order number becomes a required field is the invoice status is completed</description>
        <errorConditionFormula>AND
(
 Sun_Order_Number__c =&quot;&quot; ,
(ISPICKVAL(  Invoice_Status__c ,&quot;Complete&quot;)))</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Invoice Status is &quot;Complete&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatus_and_NoofUnitsTransferred</fullName>
        <active>false</active>
        <description>Checks that if the Invoice Status field is set to Unit Transfer that an actual amount is entered into the No of Units Transferred field.</description>
        <errorConditionFormula>OR( 
AND(ISPICKVAL( Invoice_Status__c , &quot;Unit Transfer&quot;) 
, ISNULL( No_of_Units_Transferred__c ) ) 
,AND(ISPICKVAL( Invoice_Status__c , &quot;Unit Transfer&quot;) 
, No_of_Units_Transferred__c = 0) 
)</errorConditionFormula>
        <errorDisplayField>No_of_Units_Transferred__c</errorDisplayField>
        <errorMessage>Please enter the number of units transferred.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LeadSourceMandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND 
( 
ISPICKVAL( Course_Category__c ,&quot;In Company&quot;), 
ISPICKVAL( Lead_Source__c ,&quot;&quot;) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to select Lead Source if the Course Category is &quot;In Company&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderNoMandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND 
( 
Sun_Order_Number__c=&quot;&quot; , 
OR 
( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
ISPICKVAL(Expense_Credit_Status__c,&quot;Ready to be credited&quot;) 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Credit Status or Expense Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Transferredcourse_SUN_order_number_reqd</fullName>
        <active>false</active>
        <description>The SUN order number becomes a required field if the Transferred Course field is set to Yes</description>
        <errorConditionFormula>AND
(
 Sun_Order_Number__c =&quot;&quot; ,
(ISPICKVAL( Transferred_Course__c  ,&quot;Yes&quot;)))</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Transferred Course is set to &quot;Yes&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>WorkshopModule_Mandatory_field</fullName>
        <active>false</active>
        <description>It is mandatory to specify the Workshop Modules if the course name begins with TRW or TRM.</description>
        <errorConditionFormula>AND(
ISBLANK(People_Management_Workshop__c),
OR(
BEGINS(TEXT(Course_Name__c),&quot;TRM&quot;),
BEGINS(TEXT(Course_Name__c),&quot;TRW&quot;)
)
)</errorConditionFormula>
        <errorMessage>It is mandatory to specify the Workshop Modules if the course name begins with TRW or TRM.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Clone_Override</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Clone</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>this.parent.location.href = &quot;{!UrlFor( $Action.Courses__c.Clone , Courses__c.Id ,null,true)}&apos;;</url>
    </webLinks>
    <webLinks>
        <fullName>Course_EndCourse</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>End Course</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}

var result = sforce.apex.execute(&quot;Course_Manager&quot;, &quot;endCourse&quot;, {courseId : &apos;{!Courses__c.Id}&apos;});
if(result == &apos;SUCCESS&apos;)
   alert(&quot;Pass status for Confirmed Bookings and Course status updated successfully&quot;);
else if(result == &apos;End_Course_cannot_be_Completed&apos;)
	alert(&quot;End Course cannot be used as the Course Status is already &apos;Completed&apos;&quot;);
else if(result == &apos;Course_cannot_be_Ended&apos;)
	alert(&quot;Sorry! You are not allowed to end this course.&quot;);
else if(result == &apos;NO_CONFIRMED_COURSE_BOOKINGS&apos;)
    alert(&quot;Sorry! Pass Status cannot be updated as there are no Confirmed Bookings for this course.&quot;);
	else
	alert(result);
top.window.location.href = top.window.location.href;</url>
    </webLinks>
    <webLinks>
        <fullName>Course_GenerateCertificates</fullName>
        <availability>online</availability>
        <description>Certificates generated as Word document for the confirmed delegates and attached to the Course Attachment section</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Generate Certificates</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/9.0/connection.js&quot;)} 

function base64Encode(data)
{ 
	if (typeof(btoa) == &apos;function&apos;) return btoa(data);//use internal base64 functions if available (gecko only) 
	var b64_map = &apos;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=&apos;; 
	var byte1, byte2, byte3; 
	var ch1, ch2, ch3, ch4; 
	var result = new Array(); //array is used instead of string because in most of browsers working with large arrays is faster than working with large strings 
	var j=0; 
	for (var i=0; i&lt;data.length; i+=3) 
	{ 
		byte1 = data.charCodeAt(i); 
		byte2 = data.charCodeAt(i+1); 
		byte3 = data.charCodeAt(i+2); 
		ch1 = byte1 &gt;&gt; 2; 
		ch2 = ((byte1 &amp; 3) &lt;&lt; 4) | (byte2 &gt;&gt; 4); 
		ch3 = ((byte2 &amp; 15) &lt;&lt; 2) | (byte3 &gt;&gt; 6); 
		ch4 = byte3 &amp; 63; 
		if (isNaN(byte2)) 
		{ 
			ch3 = ch4 = 64; 
		} 
		else if (isNaN(byte3)) 
		{ 
			ch4 = 64; 
		} 
		result[j++] = b64_map.charAt(ch1)+b64_map.charAt(ch2)+b64_map.charAt(ch3)+b64_map.charAt(ch4); 
	} 
	return result.join(&apos;&apos;); 
} 


try 
{ 
	var courseQueryResult = sforce.connection.query(&quot;SELECT Id, Name, Course_Start_Date__c, Course_End_Date__c, (SELECT Id, Delegate_Contact__r.Id, Delegate_Contact__r.Name, Delegate_Contact__r.Registration_Number__c FROM Course_Booking__r WHERE Booking_Status__c =&apos;Confirmed&apos;) FROM Courses__c WHERE Id = &apos;{!Courses__c.Id}&apos;&quot;); 
	
	if(courseQueryResult.size&gt;0)
   {
		if(courseQueryResult.getArray(&quot;records&quot;)[0].Course_Booking__r != null)
      {

			var course = courseQueryResult.getArray(&quot;records&quot;)[0]; 
	
			var courseBookings = courseQueryResult.getArray(&quot;records&quot;)[0].Course_Booking__r.getArray(&quot;records&quot;); 
			
			if(courseBookings.length&gt;0)
			{
					var emailTemplateQueryResult = sforce.connection.query(&quot;SELECT Id, Name, HtmlValue FROM EmailTemplate WHERE Name = &apos;CB - Certificate&apos;&quot;); 
			
					if(emailTemplateQueryResult.size&gt;0)
					{
 						var certficateEmailTemplate = emailTemplateQueryResult.getArray(&quot;records&quot;)[0];
							
						var attachment = new sforce.SObject(&quot;Attachment&quot;); 
						attachment.Name = &quot;{!Courses__c.Name}-Certficates.doc&quot;; 
						
						var htmlVal =&quot;&lt;html&gt;&lt;body&gt;&quot;; 
						
						for(var a=0;a&lt;courseBookings.length;a++) 
						{ 
							htmlVal += certficateEmailTemplate.HtmlValue; 
							if (eval(a+1)!=courseBookings.length) 
								htmlVal += &quot;&lt;p style=&apos;page-break-before:always;&apos;&gt;&quot;; 
						
							htmlVal = htmlVal.replace(&quot;{&quot; + &quot;!&quot; + &quot;Courses__&quot; + &quot;c.Name&quot; + &quot;}&quot;,&apos;{!Courses__c.Name}&apos;); 
							htmlVal = htmlVal.replace(&quot;{&quot; + &quot;!&quot; + &quot;Courses__&quot; + &quot;c.Course_Start_Date__c&quot; + &quot;}&quot;,&apos;{!Courses__c.Course_Start_Date__c}&apos;); 
							htmlVal = htmlVal.replace(&quot;{&quot; + &quot;!&quot; + &quot;Courses__&quot; + &quot;c.Course_End_Date__c&quot; + &quot;}&quot;,&apos;{!Courses__c.Course_End_Date__c}&apos;); 
							htmlVal = htmlVal.replace(&quot;{&quot; + &quot;!&quot; + &quot;Course_Booking__&quot; + &quot;c.Delegate_Contact__c&quot; + &quot;}&quot;, courseBookings[a].Delegate_Contact__r.Name); 
							htmlVal = htmlVal.replace(&quot;{&quot; + &quot;!&quot; + &quot;Contac&quot; + &quot;t.Registration_Number__c&quot; + &quot;}&quot;, courseBookings[a].Delegate_Contact__r.Registration_Number__c); 
						}
						
						
						while(htmlVal.indexOf(&quot;&lt;![CDATA[&quot;) &gt; -1) 
							htmlVal = htmlVal.replace(&quot;&lt;![CDATA[&quot;, &quot;&quot;).replace(&quot;]]&gt;&quot;, &quot;&quot;);
											
						htmlVal+=&quot;&lt;/body&gt;&lt;/html&gt;&quot;;

						attachment.Body = base64Encode(htmlVal); 
						attachment.ParentId = &apos;{!Courses__c.Id}&apos;; 
						result = sforce.connection.create([attachment]); 
						if(result[0].success == &quot;false&quot;) 
							throw result;
						
					}
					else
					{
						alert(&quot;Certificate Email Template doesn&apos;t exist&quot;);
					}
					alert(&quot;Certificate(s) generated successfully.&quot;); 
						window.location.reload(); 
			}
			else
			{
				alert(&quot;Sorry! Certificate(s) cannot be generated as there are no confirmed Bookings for this course.&quot;);
    		}
		}
		else
		{
			alert(&quot;Sorry! Certificate(s) cannot be generated as there are no confirmed Bookings for this course.&quot;);
    	}
	}
	else
	{
		alert(&quot;Sorry! Certificate(s) cannot be generated as there are no confirmed Bookings for this course.&quot;);
   }
}
catch(e)
{ 
alert(&quot;Sorry! Certificate(s) could not be generated due to some problem.&quot; 
+ &quot;\n\nPlease contact your administrator in regards to this error.&quot; 
+ &quot;\n\nError: &quot;+e.faultCode?e.faultCode:e.message?e.message:e); 
}</url>
    </webLinks>
