        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Course_DurationOld__c</fullName>
        <description>Duration between Course Start and Course End date in terms of Working Days
JM 15/2/08 - renamed for new duration field with automatic calculations removed.</description>
        <externalId>false</externalId>
        <formula>IF(MOD(   Course_Start_Date__c   - DATE(1900, 1, 7), 7)&gt; MOD(    Course_End_Date__c  - DATE(1900, 1, 7), 7),(((  Course_End_Date__c  -   Course_Start_Date__c  )-(2 * FLOOR((  Course_End_Date__c   -   Course_Start_Date__c )/7))-2)+1),(((  Course_End_Date__c   -    Course_Start_Date__c   )-(2 * FLOOR(( Course_End_Date__c   -   Course_Start_Date__c )/7))))+1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>DurationOld</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Course_End_Date__c</fullName>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Course_Free_Spaces__c</fullName>
        <description>Calculated field to get the free/available spaces for a Course.</description>
        <externalId>false</externalId>
        <formula>Maximum_Delegates__c -( Course_Provisional_Total__c + Course_Confirmed_Total__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Free Spaces</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Course_Name__c</fullName>
        <label>Course Name</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Course_Type__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>360</fullName>
                    <default>false</default>
                    <label>360</label>
                </value>
                <value>
                    <fullName>360 Feedback half day</fullName>
                    <default>false</default>
                    <label>360 Feedback half day</label>
                </value>
                <value>
