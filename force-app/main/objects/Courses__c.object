    <webLinks>
        <fullName>Course_UpdateQualifications</fullName>
        <availability>online</availability>
        <description>Update Qualifications &amp; Training Completion dates for Contact record.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Update Qualifications</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}

var selectedCourse=&apos;{!Courses__c.Id}&apos;;
var courseName = &apos;{!Courses__c.Course_Name__c}&apos;;
var courseQualification=&apos;{!Courses__c.Qualification_Available__c}&apos;;
var courseType =&apos;{!Courses__c.Course_Type__c }&apos;


if (courseQualification !=&apos;&apos; || courseName.indexOf(&apos;SODA&apos;)!=-1 || courseType == &apos;System Training&apos;)

{ 
                var result = sforce.apex.execute(&quot;Course_Manager&quot;, &quot;updateQualifications&quot;, {courseId : selectedCourse});
                 if(result == &apos;&apos;)
	    alert(&quot;Qualifications have been Updated successfully.&quot;); 
                 else if(result == &apos;0&apos;)
	    alert(&quot;Sorry! Qualifications can&apos;t be updated as there are no passed Confirmed Bookings for this Course.&quot;);  
                 else
	    alert(&quot;Qualifications have not been Updated successfully. Error:   &quot; + result);
}
else
{
alert(&quot;No available Qualification for this Course&quot;);
}</url>
