    <webLinks>
        <fullName>Update_SSC</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Update SSC</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}

var result = sforce.connection.query(&quot;Select Id,Profit_Centre__c,SSC_Email__c from Courses__c Where SSC_Email__c =&apos;uksoe@shlgroup.com&apos;&quot;); 
alert(result.size);

if(result.size&gt;0)

{

var records= result.getArray(&quot;records&quot;);

for(var j=0;j&lt;records.length;j++) 

{ 

var course = new sforce.SObject(&quot;Courses__c&quot;); 

course.Id = records[j].Id;

var setEmail= records[j].Profit_Centre__c;

var email=setEmail.substr(setEmail.indexOf(&apos;-&apos;)+2,3).toLowerCase()+&quot;soe@shlgroup.com&quot;;


course.SSC_Email__c=email;

saveresult = sforce.connection.update([course]); 

} 

}

alert(&quot;Updated  &quot;+result.size+&quot;  records Successfully&quot;);</url>
