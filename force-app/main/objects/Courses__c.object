    <webLinks>
        <fullName>Update_Profit_Centre</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Update Profit Centre</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/12.0/connection.js&quot;)}

var result = sforce.connection.query(&quot;Select Id,Course_Number__r.Profit_Centre__c,Profit_Centre__c from Course_Booking__c where Profit_Centre__c=&apos;&apos;&quot;); 

alert(result);

alert(result.size);

if(result.size&gt;0)

{

var records= result.getArray(&quot;records&quot;);

for(var j=0;j&lt;records.length;j++) 

{ 

var courseBooking = new sforce.SObject(&quot;Course_Booking__c&quot;); 

courseBooking.Id = records[j].Id;

courseBooking.Profit_Centre__c=records[j].Course_Number__r.Profit_Centre__c;

saveresult = sforce.connection.update([courseBooking]);

} 

}

alert(&quot;Updated  &quot;+result.size+&quot;  records Successfully&quot;);</url>
