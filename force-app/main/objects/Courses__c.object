    <fields>
        <fullName>Course_Name_on_Certificate__c</fullName>
        <description>Course Name to add to Course Certificates</description>
        <externalId>false</externalId>
        <label>Course Name on Certificate</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Course_Partner_Logo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Partner_Logo_Content_Version_ID__c != &apos;&apos;,IMAGE(&apos;/sfc/servlet.shepherd/version/download/&apos;&amp;Partner_Logo_Content_Version_ID__c,&quot;Partner Logo&quot;, -150, 150) ,&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Certificate Logo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Course_Price__c</fullName>
        <inlineHelpText>Prices are now fixed in Sun based on agreed price.</inlineHelpText>
        <label>Public Course Price</label>
        <precision>8</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Course_Provisional_Total__c</fullName>
        <description>Roll Up summary field for Provisional Bookings</description>
        <label>Provisional Total</label>
        <summaryFilterItems>
            <field>Course_Booking__c.Booking_Status__c</field>
            <operation>equals</operation>
            <value>Provisional</value>
        </summaryFilterItems>
        <summaryForeignKey>Course_Booking__c.Course_Number__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Course_Residential_Price__c</fullName>
