    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>BR{000000000}</displayFormat>
        <label>Rating Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Managed Services Ratings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>BureauRating_OtherRaterCheck</fullName>
        <active>true</active>
        <description>This rule ensures that the Participant and Respondent are different if the rater type is not Self.</description>
        <errorConditionFormula>IF(
ISPICKVAL( Rater_Type__c,&quot;Self&quot;),
Participant__c &lt;&gt; Respondent__c,false
)</errorConditionFormula>
        <errorDisplayField>Respondent__c</errorDisplayField>
        <errorMessage>Respondent cannot not be same as the Participant unless the Rater Type is not Self.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BureauRating_SelfRaterCheck</fullName>
        <active>true</active>
        <description>This rule ensures that the Participant and Respondent are the same if the rater type is Self.</description>
        <errorConditionFormula>IF(
ISPICKVAL( Rater_Type__c,&quot;Self&quot;),
Participant__c &lt;&gt; Respondent__c,false
)</errorConditionFormula>
        <errorDisplayField>Respondent__c</errorDisplayField>
        <errorMessage>Respondent must be same as the Participant if Rater type is Self</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BureauRating_SelfRatingMustExist</fullName>
        <active>true</active>
        <description>If a rating is being created with this candidate as a Participant and a rater type other than Self, then it needs to check if a Self rating exists for this Candidate.</description>
        <errorConditionFormula>AND(NOT(ISPICKVAL(Rater_Type__c,&apos;Self&apos;)),Participant__r.Self_Rating__c==0)</errorConditionFormula>
        <errorMessage>Participant must have a Self Rating before being rated by any other Respondent.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
