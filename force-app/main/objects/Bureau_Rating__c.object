    </fields>
    <fields>
        <fullName>Overall_Status__c</fullName>
        <externalId>false</externalId>
        <formula>if(TEXT(MFS_Status__c) = null &amp;&amp; TEXT(TC_Status__c)= null,null,
if(TEXT(MFS_Status__c)!= null &amp;&amp; TEXT(TC_Status__c)= null,TEXT(MFS_Status__c),
If(TEXT(MFS_Status__c)= null &amp;&amp; TEXT(TC_Status__c)!= null,TEXT(TC_Status__c),
if(TEXT(MFS_Status__c)= &apos;Not Started&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Not Started&apos;,&apos;Not Started&apos;,
if(TEXT(MFS_Status__c)= &apos;Not Started&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;In Progress&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Not Started&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Completed&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;In Progress&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Not Started&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;In Progress&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;In Progress&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;In Progress&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Completed&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Ready to Submit&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Not Started&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Ready to Submit&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;In Progress&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Ready to Submit&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Completed&apos;,&apos;Ready to Submit&apos;,
if(TEXT(MFS_Status__c)= &apos;Completed&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Not Started&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Completed&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;In Progress&apos;,&apos;In Progress&apos;,
if(TEXT(MFS_Status__c)= &apos;Completed&apos; &amp;&amp; TEXT(TC_Status__c)= &apos;Completed&apos;,&apos;Completed&apos;,null))))))))))))))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Overall Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
