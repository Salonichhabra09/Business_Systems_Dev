    <fields>
        <fullName>Participant__c</fullName>
        <description>This field represents the Bureau Candidate who shall be acting as a participant and shall be rated by the Respondent.</description>
        <inlineHelpText>Specify the Bureau Candidate to be rated</inlineHelpText>
        <label>Participant</label>
        <referenceTo>Bureau_Candidate__c</referenceTo>
        <relationshipName>Bureau_Ratings_As_Participant</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Rater_Order__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(Rater_Type__c, &quot;Self&quot;,1,&quot;Manager&quot;,2,&quot;Supervisor&quot;, 2, &quot;Peer&quot;, 3, &quot;Colleague&quot;, 3, &quot;Others&quot;, 3, &quot;Direct Report&quot;, 4, &quot;Report&quot;, 4, &quot;Subordinate&quot;,4, &quot;Internal Customer&quot;, 5, &quot;External Customer&quot;, 5, &quot;Internal Client&quot;, 6, &quot;External Client&quot;, 6,&quot;Client&quot;,6, &quot;Stakeholder&quot;,7, &quot;Other&quot;,7,8)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rater Order</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
