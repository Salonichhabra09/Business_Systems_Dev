                    <default>false</default>
                    <label>Updated from FTP</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Rating_Unique_Id_Development_Use__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>This field is calculated through lightning flow, it holds value of JobId+ParticipantEmail+RespondantEmail</description>
        <externalId>false</externalId>
        <label>Rating Unique Id (Development Use)</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Ready_for_Pendula__c</fullName>
        <formula>OR
(
   AND(NOT(ISBLANK(Single_Use_Link__c)),ISPICKVAL(TC_Status__c, &quot;Not Started&quot;) ),

    AND(OR(ISPICKVAL(TC_Status__c, &quot;Not Started&quot;),ISPICKVAL(TC_Status__c, &quot;In Progress&quot;)),NOT(ISBLANK(Invite_Timestamp__c))),

    AND(ISPICKVAL(TC_Status__c, &quot;Completed&quot;), ISBLANK(Invite_Timestamp__c))

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ready for Pendula?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Reminder_1__c</fullName>
        <externalId>false</externalId>
        <label>Reminder 1</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Reminder_Timestamp__c</fullName>
        <description>To capture last reminder date</description>
        <label>Reminder Email Timestamp</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Reminder__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    TEXT(Rater_Type__c) = &apos;Self&apos;,
    IF(
        OR(
            AND(ISBLANK(TEXT(MFS_Report_Sent__c)), TEXT(TC_Report_Sent__c) = &apos;Sent&apos;),
            AND(TEXT(MFS_Report_Sent__c) = &apos;Sent&apos;, TEXT(TC_Report_Sent__c) = &apos;Sent&apos;),
            Overall_Status__c = &apos;Completed&apos;
        ),
        &apos;Not Eligible&apos;,
        &apos;Eligible&apos;
    ),
    Reminder_1__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Reminder</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
