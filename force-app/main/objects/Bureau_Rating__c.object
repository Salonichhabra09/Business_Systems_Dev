    <fields>
        <fullName>Rating_Transfer_Status__c</fullName>
        <defaultValue>&quot;Not Transferred&quot;</defaultValue>
        <description>This field is created to store the transfer status of rating. Transfer is related FTP</description>
        <label>Rating Transfer Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Transferred</fullName>
                    <default>false</default>
                    <label>Not Transferred</label>
                </value>
                <value>
