        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Professional / Individual Contributor</fullName>
                    <default>false</default>
                    <label>Professional / Individual Contributor</label>
                </value>
                <value>
                    <fullName>Manager</fullName>
                    <default>false</default>
                    <label>Manager</label>
                </value>
                <value>
                    <fullName>Vocational</fullName>
                    <default>false</default>
                    <label>Vocational</label>
                </value>
                <value>
                    <fullName>Entry Level / Associate</fullName>
                    <default>false</default>
                    <label>Entry Level / Associate</label>
                </value>
                <value>
                    <fullName>Graduate and Intern</fullName>
                    <default>false</default>
                    <label>Graduate and Intern</label>
                </value>
                <value>
                    <fullName>Supervisor</fullName>
                    <default>false</default>
                    <label>Supervisor</label>
                </value>
                <value>
                    <fullName>Individual Contributor Leader</fullName>
                    <default>false</default>
                    <label>Individual Contributor Leader</label>
                </value>
                <value>
                    <fullName>Senior leadership</fullName>
                    <default>false</default>
                    <label>Senior leadership</label>
                </value>
                <value>
                    <fullName>All Levels</fullName>
                    <default>false</default>
                    <label>All Levels</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Total_Price__c</fullName>
        <formula>Sales_Price__c  *  Quantity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>8</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Usage_Allowance__c</fullName>
        <inlineHelpText>Select if usage is capped or uncapped.</inlineHelpText>
        <label>Usage Allowance</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Capped</fullName>
                    <default>false</default>
                    <label>Capped</label>
                </value>
                <value>
                    <fullName>Uncapped</fullName>
                    <default>false</default>
                    <label>Uncapped</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Usage_Cap_or_Estimation__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>If Basis of Fees is Candidates, Applications, Assessments, Units - enter the usage cap or usage estimate. If FTEs - enter FTE number used in calculator</inlineHelpText>
        <label>Total Equivalent Units</label>
        <precision>16</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Volume__c</fullName>
        <description>The Field value will be populated from Rate Card Import for Ignite Opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Field value will be populated from Rate Card Import for Ignite Opportunity.</inlineHelpText>
        <label>Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Product &amp; Service (Future Period)</label>
    <nameField>
        <displayFormat>P&amp;S(FY)-{0000}</displayFormat>
        <label>Future OppLine Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Products &amp; Services (Future Period)</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>EquivalentUnitsRequiredforProductFamily</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ISPICKVAL(Product__r.Family , &quot;Product&quot;) &amp;&amp; ISBLANK(Usage_Cap_or_Estimation__c) &amp;&amp; NOT(ISPICKVAL( Basis_of_Fees__c , &quot;Units&quot;)) &amp;&amp; $User.Id &lt;&gt; &apos;0054G00000AOE8n&apos; &amp;&amp; NOT(ISPICKVAL(Platform__c , &quot;iAssess&quot;)) , true, false)</errorConditionFormula>
        <errorMessage>Equivalent units is required for Master Product Family : Product and selected platform is not iAccess.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ListPriceSalesPriceCannotBeNegetive</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ( ListPrice__c  &lt; 0 ||  Sales_Price__c  &lt; 0), true, false)</errorConditionFormula>
        <errorMessage>List Price or Sales Price cannot be negetive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Other_field_mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISBLANK( Other__c ) , ISPICKVAL( Basis_of_Fees__c ,&quot;Other&quot;))</errorConditionFormula>
        <errorDisplayField>Other__c</errorDisplayField>
        <errorMessage>Please provide additional information</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PlatformRequiredforProductFamily</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ISPICKVAL( Product__r.Family , &quot;Product &amp; Platform&quot;) &amp;&amp; ISPICKVAL( Platform__c,&quot;&quot; ) , true, false)</errorConditionFormula>
        <errorMessage>Platform is required for Product Family : Product &amp; Platform</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_OAT_from_editing_Pricebooks</fullName>
        <active>true</active>
        <errorConditionFormula>AND((Text(Opportunity__r.StageName)== $Label.Opportunity_Stage_6), OR(ISCHANGED(Quantity__c),ISCHANGED(Sales_Price__c)), $Permission.OATs,NOT(Opportunity__r.Apply_Price_Increase_Switch__c))</errorConditionFormula>
        <errorMessage>You do not have the permission to edit Sales price or Quantity field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_creation_of_pricebooks</fullName>
        <active>false</active>
        <description>Price books items cannot be added on a Closed Won or Closed Lost Opportunity</description>
        <errorConditionFormula>AND(
	ISNEW(), 
	NOT(Opportunity__r.Skip_Validation_Auto_Renewal__c),
	OR(
		(Text(Opportunity__r.StageName)== $Label.Opportunity_Stage_6),
		(Text(Opportunity__r.StageName)== $Label.Opportunity_Stage_7 )
	),
	IF(CONTAINS($Profile.Name, &apos;System Admin&apos;),false,true)
	)</errorConditionFormula>
        <errorMessage>Products cannot be added on a Closed Won or Closed Lost Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>UsageAllowanceRequiredforProductFamily</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ISPICKVAL( Product__r.Family , &quot;Product &amp; Platform&quot;) &amp;&amp; ISPICKVAL(  Usage_Allowance__c  ,&quot;&quot; ) , true, false)</errorConditionFormula>
        <errorMessage>Usage Allowance is required for Product Family : Product &amp; Platform</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Edit_Future_Products</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Edit Future Products</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/Clone_Custom_Add_Products_Page?Id={!Opportunity.Id}</url>
    </webLinks>
</CustomObject>
