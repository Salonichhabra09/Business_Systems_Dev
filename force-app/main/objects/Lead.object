        <formula>IF(Contains( OwnerId,&apos;00G&apos;), Owner:Queue.QueueEmail, Owner:User.Email )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Owner_fullname__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Contains( OwnerId,&apos;00G&apos;),Owner:Queue.QueueName, Owner:User.FirstName&amp;&quot; &quot;&amp; Owner:User.LastName)</formula>
        <label>Owner fullname</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
