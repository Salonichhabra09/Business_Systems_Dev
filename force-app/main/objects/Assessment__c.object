    <label>Assessment</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Category__c</columns>
        <columns>Name__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All_Group_Assessments</fullName>
        <columns>NAME</columns>
        <columns>Category__c</columns>
        <columns>Name__c</columns>
        <columns>Description__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Category__c</field>
            <operation>equals</operation>
            <value>Group T&amp;E,Group A&amp;B</value>
        </filters>
        <label>All Group Assessments</label>
    </listViews>
    <listViews>
        <fullName>All_Individual_Assessments</fullName>
        <columns>NAME</columns>
        <columns>Category__c</columns>
        <columns>Description__c</columns>
        <columns>Name__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Assessment_Date__c</field>
            <operation>greaterThan</operation>
            <value>1/1/2022</value>
        </filters>
        <label>All Individual Assessments</label>
    </listViews>
    <nameField>
        <displayFormat>AS{000000}</displayFormat>
        <label>Assessment Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Assessments</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Start_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>End_Date__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Category__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Name__c</lookupDialogsAdditionalFields>
        <searchFilterFields>NAME</searchFilterFields>
        <searchResultsAdditionalFields>Category__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Name__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>AssessmentEndDateSmall</fullName>
        <active>true</active>
        <errorConditionFormula>End_Date__c &lt; Start_Date__c</errorConditionFormula>
        <errorMessage>Assessment End Date must be after Assessment Start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CreditStatusandSectionFields</fullName>
        <active>true</active>
        <errorConditionFormula>AND 
( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR 
( 
ISNULL(Credit_Amount__c), 
ISPICKVAL(Credit_Reason__c,&quot;&quot;), 
Credit_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Assessment Credit Details section fields (except SUN Credit Note No. &amp; Credit note Notes) if the Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExpenseCreditStatusandSectionDetails</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( 
ISPICKVAL(Expense_Credit_Status__c ,&quot;Ready to be credited&quot;), 
OR( 
ISNULL(Expense_Credit_Amount__c), 
ISPICKVAL(Expense_Credit_Reason__c ,&quot;&quot;), 
Expense_Credit_Text_Description__c=&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Assessment Expense Credit Details section fields (except Expense SUN Credit note No. &amp; Expense Credit Notes) if the Expense Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ExpenseInvoiceStatusandSectionFields</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( 
ISPICKVAL( Expense_Invoice_Status__c ,&quot;Ready to be invoiced&quot;), 
OR 
( 
Inco_Expense_IM_Code__c =&quot;&quot;, 
ISNULL(Expense_Amount__c), 
Expense_Invoice_Text_Description__c =&quot;&quot; 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Assessment Expense Invoice Details section fields (except Expense SUN Order No. &amp; Expense Invoice Notes) if the Expense Invoice Status is &quot;Ready to be Invoiced&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceStatusandSectionFields</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( 
ISPICKVAL( Invoice_Status__c ,&quot;Ready to be invoiced&quot;), 
OR( 
Partner_Account_Name__c =&quot;&quot;, 
Billing_Contact__c =&quot;&quot;, 
ISPICKVAL(Item_Master_Lookup__c,&quot;&quot;), 
ISPICKVAL(Invoice_Language__c,&quot;&quot;), 
Invoice_Text_Description__c =&quot;&quot;, 
Customer_Order_Ref__c =&quot;&quot;, 
ISPICKVAL( Currency_to_Invoice__c ,&quot;&quot;), 
ISPICKVAL( Department_Code__c ,&quot;&quot;), 
ISNULL(Total_Price__c) 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter the Assessment Invoice Details section fields (except SUN Order No. &amp; Invoice Notes) if the Invoice Status is &quot;Ready to be Invoiced&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SunOrderNoMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND 
( 
Sun_Order_Number__c=&quot;&quot; , 
OR 
( 
ISPICKVAL(Credit_Status__c ,&quot;Ready to be credited&quot;), 
ISPICKVAL(Expense_Credit_Status__c,&quot;Ready to be credited&quot;) 
) 
)</errorConditionFormula>
        <errorMessage>It is mandatory to enter SUN Order Number if Credit Status or Expense Credit Status is &quot;Ready to be Credited&quot;.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
