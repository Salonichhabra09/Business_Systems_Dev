    <fields>
        <fullName>Course_Booking__c</fullName>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(Opportunity.Opportunity_Nickname__c,&apos;Opportunity for Course Booking&apos;),
			RIGHT(Opportunity.Opportunity_Nickname__c, 9), &apos;&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Course Booking</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Daylight_End_Date_US_submission__c</fullName>
        <formula>DATETIMEVALUE(DATE(YEAR(DATEvalue(Submitted_to_OATs__c )),11,1)
+
( 7
-
CASE( MOD(DATE ( YEAR (DATEvalue(Submitted_to_OATs__c )),11,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEvalue(Submitted_to_OATs__c )),11,1) - DATE (1900,1,7),7))
)) + 6/24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Daylight End Date US(submission)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Daylight_Start_Date_US_Submission__c</fullName>
        <formula>DATETIMEVALUE(DATE(YEAR(DATEvalue(Submitted_to_OATs__c )),3,1)
+
( 14
-
CASE( MOD(DATE ( YEAR (DATEvalue(Submitted_to_OATs__c )),3,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEvalue(Submitted_to_OATs__c )),3,1) - DATE (1900,1,7),7))
)) + 7/24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Daylight Start Date US(Submission)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
