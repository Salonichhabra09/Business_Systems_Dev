    <fields>
        <fullName>Daylight_End_Date_US_Submission__c</fullName>
        <formula>DATETIMEVALUE(DATE(YEAR(DATEvalue(Final_Submission_Date_EST__c)),11,1) 
+ 
( 7 
- 
CASE( MOD(DATE ( YEAR (DATEvalue(Final_Submission_Date_EST__c)),11,1) - DATE (1900,1,7),7) , 
0,7,MOD(DATE ( YEAR (DATEvalue(Final_Submission_Date_EST__c)),11,1) - DATE (1900,1,7),7)) 
)) + 6/24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Daylight End Date US(submission)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Daylight_Start_Date_US_Submission__c</fullName>
        <formula>DATETIMEVALUE(DATE(YEAR(DATEvalue(Final_Submission_Date_EST__c)),3,1)
+
( 14
-
CASE( MOD(DATE ( YEAR (DATEvalue(Final_Submission_Date_EST__c)),3,1) - DATE (1900,1,7),7) ,
0,7,MOD(DATE ( YEAR (DATEvalue(Final_Submission_Date_EST__c)),3,1) - DATE (1900,1,7),7))
)) + 7/24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Daylight Start Date US(Submission)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
