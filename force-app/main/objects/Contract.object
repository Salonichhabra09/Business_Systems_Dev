    <fields>
        <fullName>Last_Possible_Submission_Date_Daylight__c</fullName>
        <description>Calculates Final submission date with adding daylight saving value and used in calculating Last possible submission date field.</description>
        <label>Last Possible Submission Date Daylight</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Last_Possible_Submission_Date__c</fullName>
        <formula>DATETIMEVALUE(CASE(MOD(DATE( 
YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
CASE( MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
2, IF( MOD( YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 4) = 0, 29, 28), 
4, 30, 
6, 30, 
9, 30, 
11, 30, 
31 
) 
)- DATE(2013, 1, 6),7),0,DATE( 
YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
CASE( MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
2, IF(MOD(YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 4) = 0, 27, 26), 
4, 28, 
6, 28, 
9, 28, 
11, 28, 
29 
) 
),6,DATE( 
YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
CASE( MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
2, IF( MOD( YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 4) = 0, 28, 27), 
4, 29, 
6, 29, 
9, 29, 
11, 29, 
30 
) 
),DATE( 
YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
CASE( MONTH(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 
2, IF( MOD( YEAR(DATEVALUE(Last_Possible_Submission_Date_Daylight__c)), 4) = 0, 29, 28), 
4, 30, 
6, 30, 
9, 30, 
11, 30, 
31 
))))+ ((23 -(Submission_Offset__c/3600000))/24) + (59/1440)</formula>
        <label>Last Possible Submission Date(Legacy)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
