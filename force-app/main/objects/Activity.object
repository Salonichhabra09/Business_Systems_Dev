    <fields>
        <fullName>Event_Type__c</fullName>
        <inlineHelpText>An event is a significant 2-way interaction with a customer or potential customer. Choose the type that best fits.</inlineHelpText>
        <label>Event Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Account Management</fullName>
                    <default>false</default>
                    <label>Account Management</label>
                </value>
                <value>
                    <fullName>Central PS</fullName>
                    <default>false</default>
                    <label>Central PS</label>
                </value>
                <value>
                    <fullName>Professional Services</fullName>
                    <default>false</default>
                    <label>Professional Services</label>
                </value>
                <value>
                    <fullName>Sales</fullName>
                    <default>false</default>
                    <label>Sales</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Hours_work__c</fullName>
        <externalId>false</externalId>
        <label>Hours work</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Completed__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used to track progress on Strategy</description>
        <label>Is Completed</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Method__c</fullName>
        <label>Method</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Call</fullName>
                    <default>false</default>
                    <label>Call</label>
                </value>
                <value>
                    <fullName>In person meeting</fullName>
                    <default>false</default>
                    <label>In person meeting</label>
                </value>
                <value>
                    <fullName>Virtual meeting</fullName>
                    <default>false</default>
                    <label>Virtual meeting</label>
                </value>
                <value>
                    <fullName>Email</fullName>
                    <default>false</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>NBB_CrossSell_Events__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Events related to (NBB and Cross sell) opportunity type Opportunities</description>
        <label>NBB_CrossSell_Events?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Opportunity_Stage__c</fullName>
        <description>The stage of the opportunity which is updated automatically when the event is created and then locked so it cannot change either manually in the event or via the stage being updated in the opportunity.</description>
        <externalId>false</externalId>
        <label>Opportunity Stage (do not use)</label>
        <length>30</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Send_email_to_assignee__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Send email to assignee when checked.</description>
        <inlineHelpText>Checking the box will send an email to the user to whom the event is assigned</inlineHelpText>
        <label>Send email to assignee</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Scheduled</fullName>
                    <default>false</default>
                    <label>Scheduled</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Target_Date__c</fullName>
        <label>Target Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Task_Category__c</fullName>
        <externalId>false</externalId>
        <label>Task Category</label>
        <length>200</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Task_End_Time__c</fullName>
        <label>Task End Time</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Task_Start_Time__c</fullName>
        <description>When user click on Task start button. this field will be populated with the current time</description>
        <label>Task Start Time</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>UnScheduled__c</fullName>
        <defaultValue>false</defaultValue>
        <label>UnScheduled?</label>
        <type>Checkbox</type>
    </fields>
</CustomObject>
