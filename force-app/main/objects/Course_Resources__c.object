    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Course_Director_Validation</fullName>
        <active>true</active>
        <description>It ensures that there can be only one Course Director for a course</description>
        <errorConditionFormula>AND 
( 
IF(ISNEW(),TRUE, ISCHANGED( Resource_Role__c )), 
ISPICKVAL(Resource_Role__c, &quot;Course Director&quot;), 
IF (OR ( ISBLANK(Course_Name__r.Course_Director__c) ,(Course_Name__r.Course_Director__c)=&quot;0032000000atnKF&quot;),false,true ) 
)</errorConditionFormula>
        <errorMessage>There already exists a Course Director for this course . You cannot add this resource as Course Director.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Resource_NameSHL_cannot_be_blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND( 
ISPICKVAL(Resource_Role__c,&apos;Course Director&apos;),
ISPICKVAL(Resource_Type__c,&apos;SHL&apos;),
ISBLANK(Resource_Name_SHL__c),
ISPICKVAL(Course_Name__r.Course_Type__c,&apos;System Training&apos;)
)</errorConditionFormula>
        <errorDisplayField>Resource_Name_SHL__c</errorDisplayField>
        <errorMessage>Resource Name(SHL) cannot be blank if Resource Role is &apos;Course Director&apos; ,Resource Type is &apos;SHL&apos; and Course Type is &apos;System Training&apos;.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
