                </value>
                <value>
                    <fullName>1</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>1</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Light</fullName>
                    <default>false</default>
                    <label>Light</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
