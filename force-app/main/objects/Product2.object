    </fields>
    <fields>
        <fullName>MS_Type__c</fullName>
        <description>Value in this field defines the Product used by which MS Team, also this field being used to map LOB on auto created jobs based on the product selected at Opportunity level.</description>
        <label>MS Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>TA - Corporate</fullName>
                    <default>false</default>
                    <label>TA - Corporate</label>
                </value>
                <value>
                    <fullName>TA - Vocational</fullName>
                    <default>false</default>
                    <label>TA - Vocational</label>
                </value>
                <value>
                    <fullName>Talent Management</fullName>
                    <default>false</default>
                    <label>Talent Management</label>
                </value>
                <value>
                    <fullName>TA - Credentialing</fullName>
                    <default>false</default>
                    <label>TA - Credentialing</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
