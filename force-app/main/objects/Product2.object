    <fields>
        <fullName>Client_Friendly_Name__c</fullName>
        <label>Client Friendly Name</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Deployment_URL__c</fullName>
        <label>Deployment URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Deployment__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(Deployment_URL__c, &quot;Link&quot;, &quot;_blank&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Deployment</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
