        <type>AutoNumber</type>
    </fields>
    <fields>
        <fullName>RAG_Indicator__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(RAG_Option__c, &apos;High&apos;) ,  IMAGE(&quot;/resource/1674447737000/RAG_Indicator_Red?&quot; , &quot;Red&quot; , 25, 26) ,
				IF( ISPICKVAL(RAG_Option__c, &apos;Light&apos;) ,  IMAGE(&quot;/resource/1674447737000/RAG_Indicator_Green?&quot; , &quot;Green&quot; , 25 ,26) , 
						IF(ISPICKVAL(RAG_Option__c, &apos;Medium&apos;) , IMAGE(&quot;/resource/1674447737000/RAG_Indicator_Amber?&quot; , &quot;Amber&quot; , 25,26), &quot;&quot;)))</formula>
        <label>RAG Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RAG_Option__c</fullName>
        <inlineHelpText>This is used to describe the complexity of PS products</inlineHelpText>
        <label>RAG Option</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
