    <fields>
        <fullName>System_Login__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The field represents the System Login to be used by the Bureau Job to access the selected system.</description>
        <inlineHelpText>Specify the System Login to be used to access the selected system.</inlineHelpText>
        <label>System Login</label>
        <referenceTo>System_Login__c</referenceTo>
        <relationshipName>Bureau_Systems</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>System_Type__c</fullName>
        <description>This field shows the System Type of the selected System</description>
        <externalId>false</externalId>
        <formula>TEXT(System__r.System_Type__c)</formula>
        <inlineHelpText>This is the System Type of the selected System</inlineHelpText>
        <label>System Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
