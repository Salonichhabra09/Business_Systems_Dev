    <fields>
        <fullName>EACV_Formula__c</fullName>
        <externalId>false</externalId>
        <formula>EACV__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>EACV Formula (Legacy)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EACV__c</fullName>
        <formula>IF(RecordType.DeveloperName = &apos;Configurator_Opportunity&apos;,IF(Total_Product_Count__c==0,Amount,  RAG_Indicator_Amber__c + RAG_Indicator_Green__c),Running_total_of_subscription_amount__c + Running_total_of_non_subscription_amount__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Estimated Annual Contract Value – first year value where subscriptions are prorated to 1 year. For Ignite Opportunities this will equal Total Sales Price until Product and Assessment is uploaded.</inlineHelpText>
        <label>EACV (Legacy)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
