    <fields>
        <fullName>Account_Approval_Status__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Account.Status__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Approval Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_LBU__c</fullName>
        <externalId>false</externalId>
        <formula>RIGHT(TEXT( Account.BU__c ), 3)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account LBU</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Number__c</fullName>
        <description>This field displays Account Number of Account linked to</description>
        <externalId>false</externalId>
        <formula>Account.Account_Number__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Territory_Region__c</fullName>
        <description>Field created to get territory Region</description>
        <externalId>false</externalId>
        <formula>IF(
    CONTAINS(TEXT(Account.Territory__r.Region__c), &quot;-&quot;),
    TRIM(
        LEFT(
            TEXT(Account.Territory__r.Region__c),
            FIND(&quot;-&quot;, TEXT(Account.Territory__r.Region__c)) - 1
        )
    ),
    TEXT(Account.Territory__r.Region__c)
)</formula>
        <label>Account Territory : Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
