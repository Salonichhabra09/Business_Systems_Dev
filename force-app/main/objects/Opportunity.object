    <fields>
        <fullName>Qualified_for_Auto_Close__c</fullName>
        <description>This formula describes, which all records are ready to update &quot;Eligible for Auto Close&quot; field on Opp</description>
        <formula>AND(
    NOT(IsClosed),
    Can_be_Auto_renewed__c = TRUE,
    ISPICKVAL(Business_Type__c, &quot;Renewal&quot;),
    ISPICKVAL(Account.Status__c, &quot;Approved&quot;),
    Eligible_for_Auto_Close__c = FALSE,
    Renewal_Opportunity__c = TRUE,
    Opportunity_Deal_Year__c = 1,
    NOT(ISBLANK(Original_Opportunity__c)),
    ISPICKVAL(Actual_Record_Type_Name__c, &quot;Configurator Opportunity&quot;),
    ISBLANK(Rejected_Order_IDs__c),
    Total_Product_Count__c &gt; 0,
    ISBLANK(TEXT(CLM_Contract_Status__c)),
    NOT(ISBLANK(Renewal_Date__c)),
    Days_left_to_Close_Opp__c&gt; 31,
    Days_left_to_Close_Opp__c&lt; 365
)</formula>
        <label>Qualified for Auto Close?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>RAG_Indicator_Amber__c</fullName>
