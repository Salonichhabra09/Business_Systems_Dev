    <fields>
        <fullName>Total_Equivalent_Units__c</fullName>
        <description>Outdated helptext: If Basis of Fees is Candidates, Applications, Assessments, Units - enter the usage cap or usage estimate. If FTEs - enter FTE number used in calculator</description>
        <externalId>false</externalId>
        <label>Total Equivalent Units</label>
        <precision>16</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_List_Price__c</fullName>
        <formula>List_Price__c  *  Quantity</formula>
