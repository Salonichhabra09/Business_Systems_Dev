        <fullName>Status__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(PricebookEntry.Product2.Status__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
