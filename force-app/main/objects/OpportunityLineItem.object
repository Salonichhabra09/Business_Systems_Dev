    <fields>
        <fullName>Product_Family__c</fullName>
        <externalId>false</externalId>
        <label>Product Family</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product_Name__c</fullName>
        <description>This field is used to filter the rollup field Opportunity MS Value on opportunity which again is used on the MS Pipeline Job Card. We can not use formula field in filters, that is why i have created this field as text field.</description>
        <externalId>false</externalId>
        <label>Product Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product_Services_Stream__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(PricebookEntry.Product2.Revenue_Category__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product &amp; Services Stream</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product_Stream__c</fullName>
        <description>This field holds the value of Stream (Revenue Category) from Product, used in Roll-Up on Opp Header</description>
        <externalId>false</externalId>
        <label>Product Stream</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
