    </fields>
    <fields>
        <fullName>Debooked_Solution_Cap__c</fullName>
        <description>This field is used to store the debooked solution cap for an opportunity line item. The value is further used in the logic to display the remaining debooking scope of the solution cap for that specific opportunity line item</description>
        <externalId>false</externalId>
        <label>Debooked Solution Cap</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Debooked_Total_Value__c</fullName>
        <description>This field is used to store the debooked amount for an opportunity line item. The value is further used in the logic to display the remaining debooking scope for that specific opportunity line item.</description>
        <externalId>false</externalId>
        <label>Debooked Total Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>6</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Delete_Required__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If opportunity record type changes from GCSC, Standard to Ignite, this gets checked.This is used to delete the product.</description>
        <label>Delete Required?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Discount_Value__c</fullName>
        <description>This captures the discount value per line, mapped from Configurator i.e the difference of List Price &amp; Sales Price</description>
        <inlineHelpText>This field automatically reflects the discount value calculated using configurator logic or the difference between the unit price and the list price.</inlineHelpText>
        <label>Discount Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>8</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Discount__c</fullName>
        <description>This field captures the discount percentage based on configurator logic or the difference between the unit price and list price.</description>
        <inlineHelpText>This field automatically reflects the discount percentage calculated using configurator logic or the difference between the unit price and the list price.</inlineHelpText>
        <label>Discount %age</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
