    <fields>
        <fullName>Short_Long_Term__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
Estimated_Completion_Date__c&lt;=today() , &quot;In the past&quot;,
If(Estimated_Completion_Date__c&lt;=(today()+90) , &quot;Short (0-3 months)&quot;,
If(Estimated_Completion_Date__c&lt;=(today()+180) , &quot;Med (3-6 months)&quot;,
If(Estimated_Completion_Date__c&lt;=(today()+265) , &quot;Long (6-12 months)&quot;,&quot;+1 year&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Short / Long Term</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
