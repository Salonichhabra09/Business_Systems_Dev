    <fields>
        <fullName>Progress_on_tasks__c</fullName>
        <formula>IF( Number_of_tasks_completed__c=0 || Number_of_tasks_created__c =0 , 0, Number_of_tasks_completed__c/Number_of_tasks_created__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Progress on strategy</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
