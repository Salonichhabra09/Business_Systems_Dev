    <fields>
        <fullName>Delivery_Hours_Timesheet__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(Task_Category__c,&quot;Advisory Services&quot;),
ISPICKVAL(Task_Category__c,&quot;Client Support&quot;),
ISPICKVAL(Task_Category__c,&quot;Job Analysis and Competency Design&quot;),
ISPICKVAL(Task_Category__c,&quot;Migration&quot;),
ISPICKVAL(Task_Category__c,&quot;Problem Resolution&quot;),
ISPICKVAL(Task_Category__c,&quot;Product Consulting&quot;),
ISPICKVAL(Task_Category__c,&quot;PS Consulting&quot;),
ISPICKVAL(Task_Category__c,&quot;Re-work&quot;),
ISPICKVAL(Task_Category__c,&quot;Solutions Consulting&quot;),
ISPICKVAL(Task_Category__c,&quot;System Configuration and Implementation&quot;),
ISPICKVAL(Task_Category__c,&quot;Training&quot;),
ISPICKVAL(Task_Category__c,&quot;Travel&quot;)
),Hours__c,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Delivery Hours Timesheet</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
