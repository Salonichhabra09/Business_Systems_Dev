    <fields>
        <fullName>IsCPSTimesheet__c</fullName>
        <formula>Project__r.RecordType.DeveloperName   &lt;&gt; &apos;Project&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is CPS Timesheet</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>LPSProject__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Project__r.RecordType.Name = &apos;Project&apos;,  HYPERLINK(LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260))+Project__c   , Project__r.Name, &apos;_blank&apos;),  HYPERLINK(LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260))+Project__r.PS_Project_Number__c,  Project__r.PS_Project_Number__r.Name , &apos;_blank&apos;) 
 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>LPS Project</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>LPS_Project_Number_Report_Filter__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Project__r.RecordType.Name=&apos;Project&apos;,  Project__r.Name ,  Project__r.PS_Project_Number__r.Name )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>LPS Project Number (Report Filter)</label>
        <required>false</required>
