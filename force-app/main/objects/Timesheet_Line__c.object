    <label>Timesheet</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>My_Timesheets</fullName>
        <columns>NAME</columns>
        <columns>Project__c</columns>
        <columns>Time_Category__c</columns>
        <columns>Task_Category__c</columns>
        <columns>Task__c</columns>
        <columns>Resource__c</columns>
        <columns>Date_Invoiced__c</columns>
        <columns>Hours__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Current_Logged_In_User__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>Date_Invoiced__c</field>
            <operation>equals</operation>
            <value>THIS_YEAR</value>
        </filters>
        <label>My Timesheets</label>
    </listViews>
    <nameField>
        <displayFormat>TSL{000000}</displayFormat>
        <label>Timesheet Line Ref</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Timesheets</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Resource__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Task_Category__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Task__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Date_Invoiced__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Hours__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Billing_Rate__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Day__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Resource__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Task_Category__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Task__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Hours__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Restrict_TimeLogs_on_CompletedOldProject</fullName>
        <active>true</active>
        <description>This rule restricts logging timesheets on 6 months old cancelled or closed projects.</description>
        <errorConditionFormula>AND(
OR(
AND(
NOT(ISNEW()),
ISCHANGED(Hours__c)),                      
ISNEW()),  
NOT(ISBLANK(Project__r.Project_Closed_Date__c)),
OR(ISPICKVAL(Project__r.Project_Status__c, &quot;Closed&quot;),
ISPICKVAL(Project__r.Project_Status__c, &quot;Cancelled&quot;)),
ADDMONTHS(Project__r.Project_Closed_Date__c, 6) &lt; TODAY()
)</errorConditionFormula>
        <errorMessage>You cannot log time to a project if the status was set to Closed / Cancelled more than 6 months ago.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Timesheet_Function_Values_Validate</fullName>
        <active>false</active>
        <description>if task category is not filtered on the basis of newly added values on function field, display message &apos;this record can not be saved as the function value has been discontinued.&apos;</description>
        <errorConditionFormula>IF( Text(Function__c)  &lt;&gt;  Project__r.Function_Timesheet__c , true,false)</errorConditionFormula>
        <errorMessage>The functional area selected for this timesheet row has been discontinued.So, kindly create a new timesheet row for entering time against this project.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>TimesheetLine_New</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>///top.window.location =&quot;servlet/servlet.Integration?lid=01r2000000052XT&amp;ic=1&quot;;
top.window.location =&quot;{!URLFOR( $Action.Timesheet_Line__c.Tab, $ObjectType.Timesheet_Line__c )}&quot;;</url>
    </webLinks>
