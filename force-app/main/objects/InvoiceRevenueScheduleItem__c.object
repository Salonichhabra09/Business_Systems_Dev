    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>IM_LookupCode_Reference__c</fullName>
        <label>IM Lookup Code Reference</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>IM1</fullName>
                    <default>false</default>
                    <label>IM1</label>
                </value>
                <value>
                    <fullName>IM2</fullName>
                    <default>false</default>
                    <label>IM2</label>
                </value>
                <value>
                    <fullName>IM3</fullName>
                    <default>false</default>
                    <label>IM3</label>
                </value>
                <value>
                    <fullName>IM4</fullName>
                    <default>false</default>
                    <label>IM4</label>
                </value>
                <value>
                    <fullName>IM5</fullName>
                    <default>false</default>
                    <label>IM5</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>IM_LookupCode__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( IM_LookupCode_Reference__c, 
&apos;IM1&apos;, TEXT(Invoice_Request__r.IM1_LookupCode__c), 
&apos;IM2&apos;, TEXT(Invoice_Request__r.IM2_LookupCode__c), 
&apos;IM3&apos;, TEXT(Invoice_Request__r.IM3_LookupCode__c), 
&apos;IM4&apos;, TEXT(Invoice_Request__r.IM4_LookupCode__c), 
&apos;IM5&apos;, TEXT(Invoice_Request__r.IM5_LookupCode__c),
&quot;None&quot;
)</formula>
        <label>IM LookupCode</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Invoice_Request__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Invoice Request</label>
        <referenceTo>Project_Invoice__c</referenceTo>
        <relationshipLabel>Invoice Revenue Schedule</relationshipLabel>
        <relationshipName>InvoiceRevenueScheduleItem</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Month__c</fullName>
        <inlineHelpText>Please select the month that the revenue will be recognised in. This should reflect the forecast on the opportunity.</inlineHelpText>
        <label>Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>RMonth__c</fullName>
        <externalId>false</externalId>
        <formula>tEXT(MONTH(Month__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Month</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RYear__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR(Month__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Year</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Revenue__c</fullName>
        <label>Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Invoice Revenue Schedule Item</label>
    <nameField>
        <displayFormat>InvRS{0000000}</displayFormat>
        <label>Invoice Revenue Schedule Item Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Invoice Revenue Schedule</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
