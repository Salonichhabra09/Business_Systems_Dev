    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Integrator_account_required</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(  Integrated__c , &quot;Yes&quot;) ,ISBLANK( Integrator_Account__c), !ISCHANGED(Date_Upgraded__c ) )</errorConditionFormula>
        <errorDisplayField>Integrator_Account__c</errorDisplayField>
        <errorMessage>Please link this system to the related integrator account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Integrator_platform_required</fullName>
        <active>false</active>
        <description>AND(ISPICKVAL( Integrated__c , &quot;Yes&quot;) ,ISBLANK(TEXT( Integrator_Platform__c)), !ISCHANGED(Date_Upgraded__c ) )</description>
        <errorConditionFormula>AND(ISPICKVAL( Integrated__c , &quot;Yes&quot;) ,ISBLANK(TEXT( Integrator_Platform__c)),  CONTAINS( Integrator_Account__r.Name , &apos; (Alliance)&apos;)  )</errorConditionFormula>
        <errorDisplayField>Integrator_Platform__c</errorDisplayField>
        <errorMessage>Please update the Integrator Platform field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Live_date_required_if_status_is_Live</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL( Status__c , &quot;Live&quot;) , ISBLANK(Live_Date__c ), !ISCHANGED(Date_Upgraded__c ),RecordType.Name&lt;&gt; &quot;Generic System&quot;)</errorConditionFormula>
        <errorDisplayField>Live_Date__c</errorDisplayField>
        <errorMessage>A live date should entered for all live systems</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>System_URL_Mandatory</fullName>
        <active>true</active>
        <description>To make the System URL field mandatory for all System Type except SODA.</description>
        <errorConditionFormula>AND( NOT( ISPICKVAL( System_Type__c ,&quot;SODA&quot;)),  
				ISBLANK(System_URL__c), !ISCHANGED(Date_Upgraded__c ),RecordType.Name&lt;&gt; &quot;Generic System&quot;)</errorConditionFormula>
        <errorDisplayField>System_URL__c</errorDisplayField>
        <errorMessage>Please fill the System URL field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TC_Integration_Type_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(System_Type__c , &apos;TalentCentral&apos;) , ISPICKVAL(Integrated__c,&apos;Yes&apos;) ,OR(ISPICKVAL(  TC_Integration_Type__c,&apos;&apos;),ISPICKVAL(  TC_Integration_Type__c,&apos;None&apos;)  ))</errorConditionFormula>
        <errorDisplayField>TC_Integration_Type__c</errorDisplayField>
        <errorMessage>Please select TC Integration Type</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
