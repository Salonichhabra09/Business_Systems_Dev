    <validationRules>
        <fullName>Additional_Comments_Required</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(ISPICKVAL( PS_Offering__c , &apos;Other&apos;) , Additional_Comments__c ==&apos;&apos;), true, false)</errorConditionFormula>
        <errorDisplayField>Additional_Comments__c</errorDisplayField>
        <errorMessage>Additional Comments is required if PS Offering is Other.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Zero_is_not_allowed</fullName>
        <active>true</active>
        <errorConditionFormula>Number__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Number__c</errorDisplayField>
        <errorMessage>Please enter value greater than Zero.</errorMessage>
    </validationRules>
