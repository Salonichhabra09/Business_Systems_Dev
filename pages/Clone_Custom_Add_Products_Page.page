                            }
                            else{
                                poductListPrice.classList.remove("slds-has-error");
                                //hideObject(getProductRecord(rowIndex,"listPriceError"));
                            }
                        }
                        
                        //SalesPrice Error
                        var poductSalesPrice = getProductRecord(rowIndex,"salesprice");
                        if(poductSalesPrice != null ) 
                        { 
                            if(poductSalesPrice.value=='')
                            {
                                poductSalesPrice.classList.add("slds-has-error");
                                //showObject(getProductRecord(rowIndex,"salesPriceError"));
                                isValid=0;
                            }
                            else{
                                poductSalesPrice.classList.remove("slds-has-error");
                                //hideObject(getProductRecord(rowIndex,"salesPriceError"));
                            }
                        }
                        
                        //Proposition Error
                        var poductProposition = getProductRecord(rowIndex,"proposition");
                        if(poductProposition != null ) 
                        { 
                            if(poductProposition.value=='')
                            {
                                poductProposition.classList.add("slds-has-error");
                                //showObject(getProductRecord(rowIndex,"propositionError"));
                                isValid=0;
                            }
                            else{
                                poductProposition.classList.remove("slds-has-error");
                                //hideObject(getProductRecord(rowIndex,"propositionError"));
                            }
                        }
                        
                        //Package Error
                        var poductPackage = getProductRecord(rowIndex,"package");
                        if(poductPackage != null ) 
                        { 
                            if(poductPackage.value=='')
                            {
                                poductPackage.classList.add("slds-has-error");
                                //showObject(getProductRecord(rowIndex,"packageError"));
                                isValid=0;
                            }
                            else{
                                poductPackage.classList.remove("slds-has-error");
                                //hideObject(getProductRecord(rowIndex,"packageError"));
                            }
                        }
                        
                        
                    }    
                        if(isValid==1)
                        return true;
                    showObject(document.getElementById("messageBar"));          
                    return null;
                    
                } 
                catch(e) 
                {
                    alert(e);
                    return false;
                }
            }
            
