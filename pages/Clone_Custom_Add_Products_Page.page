                        //Quantity Error
                        var poductquantity = getProductRecord(rowIndex,"quantity");
                        if(poductquantity != null ) 
                        { 
                            if(poductquantity.value=='' || poductquantity.value=='0')
                            {
                                poductquantity.classList.add("slds-has-error");
                                //showObject(getProductRecord(rowIndex,"quantityError"));
                                isValid=0;
                            }
                            else{
                                poductquantity.classList.remove("slds-has-error");
                                //hideObject(getProductRecord(rowIndex,"quantityError"));
                            }
                        }
                        
                        //Basis of fees Error
                        var poductbasisoffees = getProductRecord(rowIndex,"fees");
                        if(poductbasisoffees != null ) 
