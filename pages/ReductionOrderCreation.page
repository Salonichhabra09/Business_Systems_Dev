<apex:page standardcontroller="Order" lightningStyleSheets="true"  extensions="ReductionOrderCreationCls" showHeader="false" sidebar="false">
    
    <apex:includeScript value="{!URLFOR($Resource.jquery_1_8_23, 'js/jquery.min.js')}" />
    <apex:includeScript value="{!URLFOR($Resource.jquery_1_8_23, 'js/jquery-ui.custom.min.js')}" />
    <apex:stylesheet value="{!URLFOR($Resource.jquery_1_8_23, '/css/ui-lightness/jquery-ui.custom.css')}"  />
    <apex:includeScript value="/support/console/37.0/integration.js"/>
    <script type="text/javascript">
        function RedirtToNewOrder(flow,orderactid) 
            {
                var pageUrl="{!URLFOR('/flow/Reduction_Order')}";
                var parameters = '?recordId=' + orderactid + '&' + 'retURL=' + orderactid;
                var link = pageUrl + parameters;
                if(sforce.console.isInConsole())
                {
                    var primaryTabId = sforce.console.getEnclosingPrimaryTabId().id;
                    sforce.console.openSubtab(primaryTabId , link, true, 
                    'Reduction Order', null);
                }
                else{
                    window.top.location.href =link;
                }
            }
        function CloseAndRefresh()
            {
            
                window.parent.reload();
                  window.close();
            }
    </script>
    <apex:outputpanel rendered="{!(Order.status =='Activated' && Order.Reduction_Order__c ==False && Order.Variation_Opportunity__c =='No')}" layout="none">
        <apex:pageMessage title="This is an original activated order with a related closed/won opportunity therefore you may vary it if required." summary="Please click the 'Create Reduction Order' button below to create reduction Order."  severity="info" strength="1">
           <button title="Submit New Form"  onclick="RedirtToNewOrder(false,'{!Order.Id}')" rerender="myDIV" class="slds-button slds-button--brand" >
                 Create Reduction Order </button>
        </apex:pageMessage> 
    </apex:outputpanel>
</apex:page>