<aura:component controller="OrderTriggerManager" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
	<aura:attribute name="recordId" type="id" access="global" />
    <aura:attribute name="OderObj" type="Order"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <lightning:card>
        <ui:message title="Caution!" severity="warning" closable="false">
            <b>Linked Order Products have missing information, either around Use Case, Solution or Renewablity, please reject the order and get it re-submitted with completed information.</b>
        </ui:message>
        
    </lightning:card>
</aura:component>