<aura:component implements="force:hasRecordId,force:appHostable,flexipage:availableForAllPageTypes,lightning:isUrlAddressable,flexipage:availableForRecordHome" 
                access="global" >  
    <aura:attribute name="loadall" type="boolean" default="false"/>
    <aura:attribute name="recordId" type="string" />
    <aura:handler name="init" value="{!this}"  action="{!c.doInit}"/>
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.doInit}"/>
    <aura:if isTrue="{!v.loadall}">
     <c:accountIntelligenceRelated aura:id="accountIntelligenceRelated"
                                   recordId="{!v.recordId}"  calledFromAura="true">
     </c:accountIntelligenceRelated> 
    </aura:if>
</aura:component>