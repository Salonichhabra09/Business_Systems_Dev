<aura:component  controller = "NewExpense" implements="lightning:isUrlAddressable" access="global" >
    <aura:attribute name="url" type="String"/>
    <aura:attribute name="UserCurrency" type="String"/>
    <lightning:navigation aura:id="navigate" />
    <aura:attribute name="recordId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.navigatetoNewExpense}"/>
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.navigatetoNewExpense}"/>
  
	
</aura:component>