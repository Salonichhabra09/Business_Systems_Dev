<aura:component controller="WorkpacketBulkController" implements= "force:hasSObjectName,lightning:actionOverride,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global">
    <aura:attribute name="WorkpacketList" type="Workpacket__c[]"/>
    <aura:attribute name="ProjectId" type="String" access="global" description="Used to Hold the Id of record in Context"/>
    <aura:attribute name="ProjectRecord" type="ProjectObject__c"/>
    <aura:attribute name="ShowDetails" type="Boolean" default="False"/>
    <aura:handler name="init" value="this" action="{!c.doInit}"/><aura:if isTrue="{!v.ShowDetails}">
    <lightning:recordViewForm recordId="{!v.ProjectRecord.Id}" objectApiName="ProjectObject__c" density="comfy">
        <lightning:card title="CPS Project Details">
            <lightning:layout multipleRows="true">
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="Project_Name__c"/>
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="LBU__c" />
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="Project_Health_Detail__c" />
                </lightning:layoutItem>                  
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="Milestone_Status__c" />
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="Total_Orderline_Value_RollUp__c" />
                </lightning:layoutItem>
                <lightning:layoutItem flexibility="auto, no-grow" padding="horizontal-medium">
                    <lightning:outputField fieldName="Milestones_Value__c" />
                </lightning:layoutItem>                  
                
            </lightning:layout>
        </lightning:card>
    </lightning:recordViewForm>
    </aura:if>
    
    
    
    <div class="slds-page-header">
        <div class="slds-page-header__row">
            <div class="slds-page-header__col-title">
                <div class="slds-media" style="padding: 8px;">
                    <div class="slds-media__body">
                        <div class="slds-page-header__name">
                            <div class="slds-page-header__name-title">
                                <h1>
                                    <span class="slds-page-header__title slds-truncate" title="Create Workpackets">Create Workpackets</span>
                                </h1>
                            </div>
                        </div>
                        
                        <div align="center">
                            <lightning:button variant="Brand" label="Save" onclick="{!c.save}"/>  &nbsp;
                            <lightning:button variant="Brand" label="Cancel" onclick="{!c.cancel}"/>
                            <div style="display:inline" class="slds-float_right">
                                <lightning:button label="ADD ROW" iconName="utility:add" iconPosition="left"  variant="" onclick="{!c.addRow}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <lightning:card>
        <table>
            <thead>
                <tr>
                    <div>
                        <th style="width:30px;padding-left: 25px;">S#</th>
                        <th style="width:150px;">CPS Project<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px;">Product/PS<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px">Solution Type<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px">Status<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px">CPS Project Manager<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px">Agreed Delivery<p style="display: inline;color:red;">*</p></th>
                        <th style="width:165px">Description<p style="display: inline;color:red;">*</p></th>
                    </div>
                </tr>
            </thead>
        </table>
        
        
        
        
        <table>
            <thead>     
                <aura:iteration items="{!v.WorkpacketList}" var="Workpacket" indexVar="index">
                    <lightning:recordEditForm aura:id="Workpacketform" objectApiName="Workpacket__c" >                    
                        <tr>
                            <td style="width:30px;padding-left: 25px;"> 
                                {!index + 1}
                            </td>
                            <td style="width:150px">
                                <lightning:inputField fieldName="CPS_Project_Number__c" value="{!Workpacket.CPS_Project_Number__c}" variant="label-hidden" required="true" disabled="true"></lightning:inputField>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField fieldName="Product_PS__c" value="{!Workpacket.Product_PS__c}" variant="label-hidden" required="true"></lightning:inputField>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField fieldName="Solution_Type__c" value="{!Workpacket.Solution_Type__c}" variant="label-hidden" required="true"></lightning:inputField>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField  fieldName="Status__c" value="{!Workpacket.Status__c}" variant="label-hidden" required="true"></lightning:inputField>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField  fieldName="CPS_Project_Manager_New__c" value="{!Workpacket.CPS_Project_Manager_New__c}" variant="label-hidden" required="true"></lightning:inputField>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField fieldName="Agreed_Delivery__c" value="{!Workpacket.Agreed_Delivery__c}" variant="label-hidden" required="true"/>
                            </td>
                            <td style="width:165px">
                                <lightning:inputField fieldName="Description__c" value="{!Workpacket.Description__c}" variant="label-hidden" required="true"/>
                            </td>
                            
                            <td style="padding-top: 27px;padding-left: 48px;">
                                <a onclick="{!c.removeRow}" data-record="{!index}">
                                    <lightning:icon iconName="utility:delete" size="small" alternativeText="Delete"/>
                                    <span class="slds-assistive-text">Delete</span>
                                </a>&nbsp;
                                <a onclick="{!c.clonerow}" data-record="{!index}">
                                    <lightning:icon iconName="utility:copy" size="small" alternativeText="Clone"/>
                                    <span class="slds-assistive-text">Clone</span>
                                </a>
                            </td>
                        </tr>
                    </lightning:recordEditForm>
                </aura:iteration>
                
                
            </thead>
        </table>
    </lightning:card>
    
    
</aura:component>