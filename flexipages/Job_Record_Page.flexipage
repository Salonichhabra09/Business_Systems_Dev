                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Job__c.Create_WRF</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND (4 OR ( 5 AND 6)) AND 7</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.JobStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.JobStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Cancelled</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordTypeName__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Managed_Service_Commenced</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Candidate_Max_Sequence_No_New__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>0</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Candidate_Max_Sequence_No_New__c}</leftValue>
                                    <operator>GT</operator>
                                    <rightValue>0</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.WRFs_Submitted__c}</leftValue>
                                    <operator>GT</operator>
                                    <rightValue>0</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Create_WRF_Visibility__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Job__c.Master_View</value>
