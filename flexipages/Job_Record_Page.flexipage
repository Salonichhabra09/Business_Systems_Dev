                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Clone</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.MS_Line_of_Business__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Talent Management</rightValue>
                                </criteria>
                                <criteria>
