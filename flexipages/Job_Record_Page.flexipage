                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Job__c.Client_Dashboard_Banner</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Job__c.Send_Job_to_FTP</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4 AND (5 OR 6 OR 7)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.RecordType.Name}</leftValue>
