                                    <rightValue>0</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.JobStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Pre Launch</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.JobStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
