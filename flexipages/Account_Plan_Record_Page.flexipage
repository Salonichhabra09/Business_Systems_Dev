            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentName>createAccountPlanPDF</componentName>
                <identifier>c_createAccountPlanPDF</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.checkPDF__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>true</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Approved</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
