        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(234, 0, 34);&quot;&gt;&quot;This Account Plan has been retired and switched to Regional Account Plan.&quot;&lt;/strong&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText2</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.is_Account_Plan_Retired__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>true</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>fieldSet</name>
                    <value>HighLightPanel</value>
                </componentInstanceProperties>
                <componentName>generateAccountPlan</componentName>
                <identifier>c_generateAccountPlan</identifier>
            </componentInstance>
        </itemInstances>
        <mode>Replace</mode>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>switchToRegionalAccontPlan</componentName>
                <identifier>c_switchToRegionalAccontPlan</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2 AND 3</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.is_Account_Plan_Retired__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>false</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.Account_Plan_Type__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Current</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                        <operator>NE</operator>
                        <rightValue>In Review</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(255, 7, 7);&quot;&gt;Please add Strategy and Goals to Submit/Resubmit this Account Plan for Approval.&lt;/strong&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.Unapproved_Strategy_Rolloup__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>0</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.Days_After_AP_Next_Review__c}</leftValue>
                        <operator>LT</operator>
                        <rightValue>0</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentName>acr_createManageContactRelationships</componentName>
