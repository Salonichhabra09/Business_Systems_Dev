                                    <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Strategy_and_Goal__c.Link_De_Link_Opportunities</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Strategy_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Completed - Failed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Strategy_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Completed - Partial Success</rightValue>
                                </criteria>
                                <criteria>
