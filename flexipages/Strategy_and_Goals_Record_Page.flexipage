                                    <operator>NE</operator>
                                    <rightValue>Completed - Success</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Strategy_and_Goal__c.Archive</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.InActive__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                    </valueList>
