    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Account_Plan_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Strategy_and_Goal__c.Bulk_Tasks</value>
                            <visibilityRule>
